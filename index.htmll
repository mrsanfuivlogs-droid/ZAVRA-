const saveCart=()=>{try{localStorage.setItem('zavra_cart2',JSON.stringify(cart))}catch(e){}};
let curCat='all',curGroup='all',searchQ='',selSize='',srt='',pmin=0,pmax=0;
let USER=null,SELLER=null,ADMIN=false,FB=null,unsubO=null,firstSnap=true;
const ck={pay:null,state:'',after:null,conf:null,lph:'',coupon:null};
let tview={k:'',id:''};

/* category helpers */
const catOf=id=>DB.categories.find(c=>c.id===id);
const catEn=id=>(catOf(id)||{}).en||id;
const liveProducts=()=>DB.products.filter(p=>!p.status||p.status==='approved');
const catIcon=id=>(catOf(id)||{}).emoji||'✦';
const catGroup=id=>(catOf(id)||{}).group||'women';
const sortedCats=()=>DB.categories.slice().sort((a,b)=>(a.ord||0)-(b.ord||0));

function toast(m){const t=$('#toast');t.textContent=m;t.style.display='block';clearTimeout(t._t);t._t=setTimeout(()=>t.style.display='none',Math.max(3200,m.length*110))}
function closeAll(){tview.k='';const mn=$('#menu');if(mn)mn.classList.remove('on');document.querySelectorAll('.ov').forEach(o=>o.classList.remove('on'));$('#drawer').classList.remove('on')}
const go=()=>setTimeout(()=>$('#shop').scrollIntoView({behavior:'smooth'}),50);
function resizeImg(file,max,q,cb){const r=new FileReader();r.onload=e=>{const im=new Image();im.onload=()=>{const s=Math.min(1,max/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',q))};im.src=e.target.result};r.readAsDataURL(file)}
function reveal(){
  const els=document.querySelectorAll('.rv:not(.in)');
  if(!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('in'));return}
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.08});
  els.forEach(e=>io.observe(e));
  setTimeout(()=>document.querySelectorAll('.rv:not(.in)').forEach(e=>e.classList.add('in')),2500);
}

/* ---------- Firebase layer ---------- */
async function initFB(){
  const B='https://www.gstatic.com/firebasejs/10.12.2/';
  const [a,au,fs]=await Promise.all([import(B+'firebase-app.js'),import(B+'firebase-auth.js'),import(B+'firebase-firestore.js')]);
  const app=a.initializeApp(FIREBASE_CONFIG);
  FB={au,fs,auth:au.getAuth(app),db:fs.getFirestore(app)};
  try{FB.auth.languageCode='en'}catch(e){}
}
async function loadStoreFB(){
  const {doc,getDoc,getDocs,collection}=FB.fs;
  const m=await getDoc(doc(FB.db,'store','main'));
  if(!m.exists()){DB.seeded=false;return}
  const d=m.data();
  DB.seeded=true;
  DB.settings={...DB.settings,...(d.settings||{})};
  if(DB.settings.email==='support@zavra.in')DB.settings.email=DEF.settings.email;
  if(d.pay)DB.pay=d.pay;
  if(d.brands)DB.brands=d.brands;
  if(d.delivery)DB.delivery=d.delivery;
  DB.policies={...POL_DEF,...(d.policies||{})};
  const ps=await getDocs(collection(FB.db,'products'));
  DB.products=ps.docs.map(x=>x.data()).sort((a,b)=>(a.ord||0)-(b.ord||0));
  const ss=await getDocs(collection(FB.db,'slides'));
  DB.slides=ss.docs.map(x=>x.data()).sort((a,b)=>(a.ord||0)-(b.ord||0));
  const st=await getDocs(collection(FB.db,'store'));
  const cs=st.docs.filter(x=>x.id.startsWith('cat_')).map(x=>x.data());
  if(cs.length)DB.categories=cs.sort((a,b)=>(a.ord||0)-(b.ord||0));
}
async function fbSet(col,id,data){
  try{await FB.fs.setDoc(FB.fs.doc(FB.db,col,String(id)),clone(data))}
  catch(e){console.error(e);toast('Could not save ('+(e.code||'error')+')')}
}
function save(){
  if(!FB_ON){try{localStorage.setItem('zavra_db4',JSON.stringify(DB))}catch(e){toast('Could not save (storage full — use smaller images)')}return}
  if(!ADMIN)return;
  const s={...DB.settings};delete s.pw;
  fbSet('store','main',{settings:s,pay:DB.pay,brands:DB.brands||[],delivery:DB.delivery,policies:DB.policies});
}
function persistProduct(p){FB_ON?fbSet('products',p.id,p):save()}
function removeProduct(id){if(FB_ON)FB.fs.deleteDoc(FB.fs.doc(FB.db,'products',String(id))).catch(e=>toast('Could not delete'));else save()}
function persistSlide(s){FB_ON?fbSet('slides',s.id,s):save()}
function removeSlide(id){if(FB_ON)FB.fs.deleteDoc(FB.fs.doc(FB.db,'slides',String(id))).catch(e=>toast('Could not delete'));else save()}
function persistCat(c){FB_ON?fbSet('store','cat_'+c.id,c):save()}
function removeCat(id){if(FB_ON)FB.fs.deleteDoc(FB.fs.doc(FB.db,'store','cat_'+id)).catch(e=>toast('Could not delete'));else save()}
function persistOrder(o){FB_ON?fbSet('orders',o.id,o):save()}
async function seedFB(){
  if(!confirm('Reset the store to the demo categories, products, slides and settings? This overwrites your current catalogue (orders and seller listings are kept).'))return;
  const keep=DB.orders,mine=DB.products.filter(p=>p.sellerId),o=clone(DEF);
  DB.settings=o.settings;DB.categories=o.categories;DB.slides=o.slides;DB.products=o.products.concat(mine);DB.pay=o.pay;DB.brands=o.brands;DB.delivery=o.delivery;DB.policies=o.policies;DB.orders=keep;
  save();
  for(const c of DB.categories)await fbSet('store','cat_'+c.id,c);
  for(const p of o.products)await fbSet('products',p.id,p);
  for(const s of DB.slides)await fbSet('slides',s.id,s);
  DB.seeded=true;toast('Store loaded with demo data ✓');renderAdmin();
}
function listenMyOrders(){
  if(unsubO){unsubO();unsubO=null}
  if(!FB_ON||!FB||!USER||ADMIN)return;
  try{
    let first=true;
    unsubO=FB.fs.onSnapshot(FB.fs.query(FB.fs.collection(FB.db,'orders'),FB.fs.where('uid','==',USER.uid)),snap=>{
      DB.orders=snap.docs.map(d=>d.data());
      if(!first)snap.docChanges().forEach(c=>{if(c.type==='modified'){const d=c.doc.data();toast('📦 Order '+d.id+': '+(STL[d.status]||d.status))}});
      first=false;
      if($('#tov').classList.contains('on')){if(tview.k==='acct')openAccount(true);else if(tview.k==='track')trackShow(tview.id)}
    },e=>console.warn('orders live',e));
  }catch(e){console.warn(e)}
}
function listenOrders(){
  if(unsubO)unsubO();firstSnap=true;
  unsubO=FB.fs.onSnapshot(FB.fs.collection(FB.db,'orders'),snap=>{
    DB.orders=snap.docs.map(d=>d.data()).sort((a,b)=>String(b.date).localeCompare(String(a.date)));
    if(!firstSnap&&snap.docChanges().some(c=>c.type==='added'))toast('🔔 New order received!');
    firstSnap=false;
    if(ADMIN&&location.hash==='#admin'&&(atab==='orders'||atab==='dash'))renderAdmin();
  },e=>toast('Could not load orders ('+(e.code||'error')+')'));
}
async function loadSellers(){
  try{const sn=await FB.fs.getDocs(FB.fs.collection(FB.db,'sellers'));DB.sellers=sn.docs.map(d=>d.data())}catch(e){console.error(e)}
}
async function refreshSeller(){
  SELLER=null;
  if(FB_ON&&FB&&FB.auth.currentUser&&FB.auth.currentUser.email){
    try{const s=await FB.fs.getDoc(FB.fs.doc(FB.db,'sellers',FB.auth.currentUser.uid));if(s.exists())SELLER=s.data()}catch(e){console.error(e)}
  }
}
function wireAuth(){
  FB.au.onAuthStateChanged(FB.auth,async u=>{
    if(u&&u.email&&u.email===ADMIN_EMAIL){ADMIN=true;USER=null;SELLER=null;listenOrders();loadSellers()}
    else if(u){
      ADMIN=false;if(unsubO){unsubO();unsubO=null}
      let ph=(u.phoneNumber||'').replace('+91','');
      if(!ph){try{ph=(await u.getIdTokenResult()).claims.phone||''}catch(e){}}
      USER={uid:u.uid,phone:ph,email:u.email||u.displayName||''};
      await loadProfile();
      await refreshSeller();
      listenMyOrders();
    }else{
      ADMIN=false;USER=null;SELLER=null;if(unsubO){unsubO();unsubO=null}DB.orders=[];
    }
    uiUser();
    if(['#admin','#seller'].includes(location.hash))route();
  });
}

/* ---------- Slider ---------- */
let si=0,stimer=null;
function bgOf(s){const b=BGS[s.bg]||BGS.wine;return `linear-gradient(120deg,${b[0]},${b[1]})`}
function renderSlider(){
  const S=DB.slides;if(si>=S.length)si=0;
  $('#slides').innerHTML=S.map((s,i)=>{
    const heroImg=s.img||photoUrl(PHOTO[s.cat]?s.cat:(catOf(s.cat)?.group||'women'),1500);
    const bgst=`background-image:linear-gradient(90deg,rgba(5,12,30,.82),rgba(5,12,30,.2)),url('${esc(heroImg)}')`;
    const art=s.img?'<div></div>':`<div><div class="arch"><span class="sp" style="top:30px;left:-26px">✦</span><span class="sp" style="top:120px;right:-30px;animation-delay:.8s">✦</span><span class="sp" style="bottom:70px;left:-34px;animation-delay:1.5s;font-size:15px">✦</span><div class="arch-in">${esc(s.emoji||'✨')}</div><div class="arch-t">ZAVRA</div></div></div>`;
    return `<div class="sl ${i===si?'on':''}" style="${bgst}"><div class="sl-in"><div><p class="k">${esc(s.kick)}</p><h1>${esc(s.title)}</h1><p class="s">${esc(s.sub)}</p><a href="#shop" class="btn" onclick="setCat('${esc(s.cat)}')">${esc(s.btn||'Shop Now')}</a></div>${art}</div></div>`}).join('');
  $('#dots').innerHTML=S.length>1?S.map((_,i)=>`<b class="${i===si?'on':''}" onclick="showSlide(${i})"></b>`).join(''):'';
  document.querySelectorAll('.sa').forEach(b=>b.style.display=S.length>1?'':'none');
  clearInterval(stimer);if(S.length>1)stimer=setInterval(()=>moveSlide(1,true),5500);
}
function showSlide(i){si=i;document.querySelectorAll('.sl').forEach((e,k)=>e.classList.toggle('on',k===si));document.querySelectorAll('#dots b').forEach((e,k)=>e.classList.toggle('on',k===si))}
function moveSlide(d,auto){const n=DB.slides.length;if(!n)return;showSlide((si+d+n)%n);if(!auto){clearInterval(stimer);stimer=setInterval(()=>moveSlide(1,true),5500)}}

/* ---------- Policies ---------- */
function fill(t){const s=DB.settings;return String(t).replace(/\{\{STORE\}\}/g,s.name).replace(/\{\{EMAIL\}\}/g,s.email||'').replace(/\{\{WHATSAPP\}\}/g,'+'+(s.wa||'')).replace(/\{\{PHONE\}\}/g,s.phone||'').replace(/\{\{FREE\}\}/g,tk(DB.delivery.free))}
function brandChips(g){
  const L=(DB.brands||(DB.brands=clone(DEF.brands))).filter(b=>b.group===g);
  return '<div class="bchips">'+L.map(b=>{const inner=b.logo?`<img src="${esc(b.logo)}" alt="${esc(b.name)}"><small>${esc(b.name)}</small>`:`<span>${esc(b.name)}</span>`;
    return /^https?:\/\//.test(b.url||'')?`<a class="bchip" href="${esc(b.url)}" target="_blank" rel="noopener">${inner}</a>`:`<div class="bchip">${inner}</div>`}).join('')+'</div>';
}
function mdLite(t){
  let out='',ul=false;
  for(const l of esc(fill(t)).split('\n')){
    if(l.startsWith('- ')){if(!ul){out+='<ul>';ul=true}out+='<li>'+l.slice(2)+'</li>'}
    else{if(ul){out+='</ul>';ul=false}if(l.startsWith('## '))out+='<h3>'+l.slice(3)+'</h3>';else if(l.trim())out+='<p>'+l+'</p>'}
  }
  return out+(ul?'</ul>':'');
}
function openPolicy(k){
  const s=DB.settings;
  const sell=[s.legal||s.name,s.address,s.gstin?'GSTIN: '+s.gstin:'','Email: '+(s.email||''),'WhatsApp: +'+(s.wa||''),'Phone: '+(s.phone||''),s.grievance?'Grievance Officer: '+s.grievance+' — '+(s.email||''):''].filter(Boolean);
  $('#polbody').innerHTML=`<h2>${esc(POL_TITLES[k])}</h2><div class="tabs">${Object.entries(POL_TITLES).map(([a,b])=>`<button class="chip sm ${a===k?'on':''}" onclick="openPolicy('${a}')">${esc(b)}</button>`).join('')}</div>${mdLite(DB.policies[k]||POL_DEF[k]).replace(/<p>\{\{BRANDS:(\w+)\}\}<\/p>/g,(m,g)=>brandChips(g))}<div class="seller"><b>Seller Details</b><br>${sell.map(esc).join('<br>')}</div><p style="font-size:12px;color:var(--mute);margin-top:12px">Last updated: ${new Date().toLocaleDateString('en-IN')}</p>`;
  $('#polov').classList.add('on');
}
function closePolicy(){$('#polov').classList.remove('on')}

/* ---------- Header: badges, wishlist, search, side menu, category strip ---------- */
function setBadge(id,n){const e=$('#'+id);if(!e)return;e.textContent=bn(n);e.style.display=n>0?'grid':'none'}
let WISH=[];try{WISH=JSON.parse(localStorage.getItem('zavra_wish')||'[]')}catch(e){}
function toggleWish(id,e){
  if(e){e.stopPropagation();e.preventDefault()}
  const i=WISH.indexOf(id);if(i>=0)WISH.splice(i,1);else WISH.push(id);
  try{localStorage.setItem('zavra_wish',JSON.stringify(WISH))}catch(x){}
  const on=WISH.includes(id);
  document.querySelectorAll('[data-h="'+id+'"]').forEach(b=>{b.classList.toggle('on',on);b.textContent=on?'♥':'♡'});
  document.querySelectorAll('[data-hl="'+id+'"]').forEach(b=>{b.textContent=on?'♥ Saved to wishlist':'♡ Save to wishlist'});
  setBadge('wc',WISH.length);toast(on?'Saved to your wishlist':'Removed from wishlist');
  if($('#wlist'))drawWish();
}
function openWish(){closeAll();$('#tbody').innerHTML='<h2>My Wishlist</h2><div id="wlist"></div>';drawWish();$('#tov').classList.add('on')}
function drawWish(){
  const L=WISH.map(id=>DB.products.find(p=>p.id===id)).filter(p=>p&&(!p.status||p.status==='approved'));
  $('#wlist').innerHTML=L.length?L.map(p=>{const im=pImgs(p)[0];return `<div class="wrow" onclick="closeAll();openProduct(${p.id})">${im?`<img src="${esc(im)}" alt="">`:`<div class="wi">${esc(catIcon(p.cat))}</div>`}<div><b>${esc(p.name)}</b>${tk(p.price)}${p.old>p.price?` <s style="color:var(--mute)">${tk(p.old)}</s>`:''}</div><button class="mini" onclick="toggleWish(${p.id},event)">Remove</button></div>`}).join(''):'<p class="note">Your wishlist is empty. Tap the ♡ on any product to save it here.</p>';
}
function openSearch(){
  closeAll();$('#tbody').innerHTML='<h2>Search</h2><input id="gsq" placeholder="Search kurtis, sarees, shirts, bags…" oninput="searchRes()" autocomplete="off"><div class="sres" id="gres"></div>';
  $('#tov').classList.add('on');setTimeout(()=>{const i=$('#gsq');i&&i.focus()},120);searchRes();
}
function searchRes(){
  const q=($('#gsq').value||'').trim().toLowerCase();
  const L=liveProducts().filter(p=>!q||(p.name+' '+catEn(p.cat)+' '+(p.fabric||'')+' '+(GROUPS[catGroup(p.cat)]||{}).en).toLowerCase().includes(q)).slice(0,20);
  $('#gres').innerHTML=L.length?L.map(p=>{const im=pImgs(p)[0];return `<div class="wrow" onclick="closeAll();openProduct(${p.id})">${im?`<img src="${esc(im)}" alt="">`:`<div class="wi">${esc(catIcon(p.cat))}</div>`}<div><b>${esc(p.name)}</b><small style="color:var(--mute)">${esc(catEn(p.cat))}</small><br>${tk(p.price)}</div></div>`}).join(''):'<p class="note">No products found.</p>';
}
function openSide(){closeAll();renderSide();$('#sov').classList.add('on')}
function renderSide(){
  const cs=sortedCats(),thumb=c=>c.img?`<img src="${esc(c.img)}" alt="">`:`<em>${esc(c.emoji||'✦')}</em>`;
  const grp=GORD.map(g=>{const L=cs.filter(c=>c.group===g);if(!L.length)return'';
    return `<div class="sg"><button class="sgh" onclick="this.parentNode.classList.toggle('open')"><span class="gic">${GICON[g]}</span><b>${GROUPS[g].en}</b><i>+</i></button><div class="sgb"><button onclick="sideGo('g:${g}')"><span class="th"><em>✦</em></span>View all ${GROUPS[g].en}</button>${L.map(c=>`<button onclick="sideGo('c:${esc(c.id)}')"><span class="th">${thumb(c)}</span>${esc(c.en)}</button>`).join('')}</div></div>`}).join('');
  const more=MENU.map(([h,L])=>`<h6>${h}</h6>`+L.map(([i,l,a])=>`<button class="sbl" onclick="menuGo('${a}')"><span>${i}</span>${l}</button>`).join('')).join('');
  const acc=USER?`<div class="sacc"><small style="color:var(--mute)">Signed in as</small><br><b>${USER.phone?'+91 '+esc(USER.phone):esc(USER.email)}</b></div>`:`<div class="sacc"><button class="btn dark sm" onclick="closeAll();openLogin()">Login / Sign Up</button></div>`;
  $('#sidebar').innerHTML=`<div class="sbh"><span class="logo2" style="font-size:20px;letter-spacing:.28em">${esc(DB.settings.name)}</span><button class="x" onclick="closeAll()">×</button></div>${acc}<h6>Shop by category</h6>${grp}${more}`;
}
function sideGo(a){closeAll();if(a.startsWith('g:')){setGroup(a.slice(2));go()}else pickCat(a.slice(2))}
function renderCstrip(){
  const cs=sortedCats().slice().sort((a,b)=>GORD.indexOf(a.group)-GORD.indexOf(b.group));
  $('#cstrip').innerHTML=cs.map(c=>`<div class="csi" onclick="pickCat('${esc(c.id)}')"><div class="csc"><div>${c.img?`<img src="${esc(c.img)}" alt="">`:esc(c.emoji||'✦')}</div></div>${esc(c.en)}</div>`).join('');
}
function waOrder(id){
  const p=DB.products.find(x=>x.id===id);if(!p)return;
  if(p.sizes&&!selSize)return toast('Please select a size first');
  const txt='Hello '+DB.settings.name+', I want to order:\n'+p.name+(selSize?'\nSize: '+selSize:'')+'\nPrice: '+tk(p.price)+'\nLink: '+prodUrl(id);
  window.open('https://wa.me/'+String(DB.settings.wa).replace(/\D/g,'')+'?text='+encodeURIComponent(txt),'_blank');
}

/* ---------- Menu data, Track order, Contact ---------- */
const MENU=[
 ['Orders & Help',[['📦','Track Order','track'],['🧾','My Orders','orders'],['💬','WhatsApp Support','wa'],['☎','Contact Us','contact']]],
 ['Policies',[['📜','Terms & Conditions','p:terms'],['👗','Product Policy','p:product'],['🚚','Shipping & Delivery','p:delivery'],['↺','Returns, Refunds & Exchange','p:returns'],['💳','Payment Policy','p:payment'],['🔒','Privacy Policy','p:privacy']]],
 ['More',[['✦','About Us','p:about'],['❓','FAQs','p:faq'],['🌍','International Shopping & Payments','p:intl'],['🏪','Sell on ZAVRA','seller'],['📦','Bulk / Wholesale Orders','bulk']]]
];
function toggleMenu(e){
  e&&e.stopPropagation();const m=$('#menu');
  if(m.classList.contains('on')){m.classList.remove('on');return}
  m.innerHTML=MENU.map(([h,L])=>`<h6>${h}</h6>`+L.map(([i,l,a])=>`<button onclick="menuGo('${a}')"><span>${i}</span>${l}</button>`).join('')).join('');
  m.classList.add('on');
}
document.addEventListener('click',e=>{const m=$('#menu');if(m&&m.classList.contains('on')&&!e.target.closest('.icons'))m.classList.remove('on')});
function menuGo(a){
  closeAll();
  if(a.startsWith('p:'))return openPolicy(a.slice(2));
  if(a==='track')return openTrack();
  if(a==='orders')return openAccount();
  if(a==='contact')return openContact();
  if(a==='wa')return window.open('https://wa.me/'+String(DB.settings.wa).replace(/\D/g,'')+'?text='+encodeURIComponent('Hello '+DB.settings.name+', I need help.'),'_blank');
  if(a==='seller')location.hash='#seller';
  if(a==='bulk')return openBulk();
}
function openContact(){
  const s=DB.settings,wa=String(s.wa||'').replace(/\D/g,'');
  closeAll();
  $('#tbody').innerHTML=`<h2>Contact Us</h2><p style="color:var(--mute);font-size:14px;margin-bottom:14px">We are here to help with orders, delivery, returns and anything else.</p><div class="box" style="padding:0">${String(s.phone||'').split(',').map(p=>p.trim()).filter(Boolean).map(p=>`<a href="tel:${esc(p.replace(/[^\d+]/g,''))}" style="display:block;padding:14px 18px;border-bottom:1px solid var(--line)">📞 Call us<br><b>${esc(p)}</b></a>`).join('')}${wa?`<a href="https://wa.me/${wa}" target="_blank" rel="noopener" style="display:block;padding:14px 18px;border-bottom:1px solid var(--line)">💬 WhatsApp<br><b>+${esc(wa)}</b></a>`:''}${s.email?`<a href="mailto:${esc(s.email)}" style="display:block;padding:14px 18px">✉ Email<br><b>${esc(s.email)}</b></a>`:''}</div>${s.address?`<p style="font-size:14px;margin-top:14px"><b>Address</b><br>${esc(s.address)}</p>`:''}<p style="font-size:13px;color:var(--mute);margin-top:14px">For order help, please keep your order ID ready. See also our <span class="lnk" onclick="openPolicy('returns')">Returns Policy</span> and <span class="lnk" onclick="openPolicy('faq')">FAQs</span>.</p>`;
  $('#tov').classList.add('on');
}
const BULK_CATS_DEF="Kids dresses & frocks, Kids shirts & tops, Kids pants & shorts, Kids nightwear, Kids sets & party wear, Kids toys & accessories, Kurtis, Sarees, Lehengas, Gowns & dresses, Men's shirts, Men's T-shirts, Men's kurtas, Footwear, Bags, Other (tell us below)";
function bulkCats(){return String(DB.settings.bulkCats||BULK_CATS_DEF).split(',').map(x=>x.trim()).filter(Boolean)}
function openBulk(){
  const s=DB.settings;closeAll();
  $('#tbody').innerHTML=`<h2>Bulk / Wholesale Orders</h2><p style="color:var(--mute);font-size:14px;margin-bottom:12px">${esc(s.bulkInfo||'Buying for your shop or business? Tell us what you need and our team will send you a wholesale quote.')}</p>${s.bulkMin?`<div class="note" style="margin-bottom:12px"><b>Minimum order:</b> ${esc(s.bulkMin)}</div>`:''}
  <label>Your name *</label><input id="bk_n"><label>Mobile / WhatsApp number *</label><input id="bk_p" inputmode="tel" placeholder="With country code if outside India"><label>Email</label><input id="bk_e" type="email"><label>Shop / business name</label><input id="bk_b">
  <label>What do you want to buy? (select all that apply)</label><div id="bk_c" style="display:grid;gap:4px">${bulkCats().map((c,i)=>`<label class="sw" style="margin:0"><input type="checkbox" value="${esc(c)}"> ${esc(c)}</label>`).join('')}</div>
  <label>Approximate total quantity (pieces)</label><input id="bk_q" inputmode="numeric" placeholder="e.g. 200"><label>City / State / Country</label><input id="bk_l"><label>Message (sizes, colours, budget, delivery date)</label><textarea id="bk_m" rows="3"></textarea>
  <button class="btn" style="width:100%;margin-top:14px;background:#1f9d55;color:#fff" onclick="sendBulk('wa')">Send enquiry on WhatsApp</button><button class="btn" style="width:100%;margin-top:10px" onclick="sendBulk('mail')">Send enquiry by email</button>`;
  $('#tov').classList.add('on');
}
function sendBulk(how){
  const v=id=>($('#'+id).value||'').trim(),cats=[...document.querySelectorAll('#bk_c input:checked')].map(x=>x.value);
  if(!v('bk_n')||v('bk_p').replace(/\D/g,'').length<7)return toast('Please enter your name and mobile number');
  if(!cats.length)return toast('Please select at least one product type');
  const txt=`Bulk / Wholesale enquiry — ${DB.settings.name}\nName: ${v('bk_n')}\nPhone: ${v('bk_p')}\nEmail: ${v('bk_e')||'-'}\nBusiness: ${v('bk_b')||'-'}\nProducts: ${cats.join(', ')}\nQuantity: ${v('bk_q')||'-'}\nLocation: ${v('bk_l')||'-'}\nMessage: ${v('bk_m')||'-'}`;
  if(how==='wa')window.open('https://wa.me/'+String(DB.settings.wa).replace(/\D/g,'')+'?text='+encodeURIComponent(txt),'_blank');
  else location.href='mailto:'+encodeURIComponent(DB.settings.email||'')+'?subject='+encodeURIComponent('Bulk / Wholesale enquiry')+'&body='+encodeURIComponent(txt);
}
async function openTrack(id){
  if(!USER)return openLogin(()=>openTrack(id));
  closeAll();$('#tbody').innerHTML='<p>Loading…</p>';$('#tov').classList.add('on');
  if(FB_ON){try{const q=FB.fs.query(FB.fs.collection(FB.db,'orders'),FB.fs.where('uid','==',USER.uid));const sn=await FB.fs.getDocs(q);DB.orders=sn.docs.map(d=>d.data())}catch(e){toast('Could not load orders')}}
  const my=DB.orders.filter(o=>o.uid===USER.uid).sort((a,b)=>String(b.date).localeCompare(String(a.date)));
  trackShow(id||(my[0]&&my[0].id)||'');
}
function trackShow(id){
  const my=DB.orders.filter(o=>o.uid===USER.uid);
  const o=my.find(x=>String(x.id).toLowerCase().replace(/^zv-/,'')===String(id||'').trim().toLowerCase().replace(/^zv-/,''));
  tview={k:'track',id:id};
  const steps=['Pending','Confirmed','Packing','Shipped','OutForDelivery','Delivered'],labels={Pending:'Order placed',Confirmed:'Order confirmed',Packing:'Packing your order',Shipped:'Handed to the delivery partner',OutForDelivery:'Out for delivery',Delivered:'Delivered'};
  const cur=o?steps.indexOf(o.status):-1;
  $('#tbody').innerHTML=`<h2>Track Order</h2><label>Order ID</label><div style="display:flex;gap:8px"><input id="tid" value="${esc(id||'')}" placeholder="e.g. 1001" onkeydown="if(event.key==='Enter')trackShow($('#tid').value)"><button class="btn sm dark" onclick="trackShow($('#tid').value)">Track</button></div>${o?(o.status==='Cancelled'?`<p class="note" style="margin-top:16px">This order was cancelled.</p>`:`<div class="tl">${steps.map((s,i)=>`<div class="${i<=cur?'done':''}"><i>${i<=cur?'✓':i+1}</i>${labels[s]}</div>`).join('')}</div><div class="box" style="margin-top:16px;font-size:14px"><b>${esc(o.id)}</b> · ${new Date(o.date).toLocaleDateString('en-IN')}<br>${o.items.map(i=>esc(i.name)+(i.size?` (${esc(i.size)})`:'')+' ×'+bn(i.qty)).join('<br>')}<br><br>Total: <b>${tk(o.total)}</b> · ${esc(o.pay)}<br><small>${PSL[o.payStatus]||''}</small>${o.status!=='Delivered'&&o.status!=='Cancelled'?`<br><br>🕒 Expected delivery: <b>${esc(o.eta||DB.settings.eta||'5–7 business days')}</b>`:''}${o.upd?`<br><small style="color:var(--mute)">Last updated: ${new Date(o.upd).toLocaleString('en-IN')}</small>`:''}${o.courier?`<br><br>Courier: <b>${esc(o.courier)}</b><br>Tracking ID: <b>${esc(o.tracking)}</b>${(()=>{const c=DB.delivery.couriers.find(z=>z.name===o.courier);return c&&/^https?:\/\//.test(c.track||'')?`<br><a class="btn sm" style="display:inline-block;margin-top:10px" href="${esc(c.track.replace('{id}',encodeURIComponent(o.tracking)))}" target="_blank" rel="noopener">Track on ${esc(o.courier)} →</a>`:''})()}`:'<br><br><small>A courier and tracking ID will appear here once your order is shipped.</small>'}</div>`):(id?'<p class="note" style="margin-top:16px">No order found with this ID for your account. Check the ID and try again.</p>':'<p class="note" style="margin-top:16px">Enter your order ID to see its status. You can find it in "My Orders" or in your order confirmation.</p>')}<p style="font-size:13px;margin-top:14px;color:var(--mute)">Need help? <span class="lnk" onclick="openContact()">Contact us</span></p>`;
}

/* ---------- Login (mobile OTP or email) ---------- */
function uiUser(){const b=$('#accBtn');if(b){b.title=USER?(SELLER?'My Account':'My Orders'):'Login';b.classList.toggle('on',!!USER)}}
function openLogin(cb,mode){closeAll();ck.after=cb||null;ck.conf=null;ck.su=false;if(mode==='email')loginEmail('signin');else if(waOn())loginWa();else loginStep1();$('#lov').classList.add('on')}
const TERMS_LINE=`<p style="font-size:12px;color:var(--mute);margin-top:12px">By continuing you agree to our <span class="lnk" onclick="openPolicy('terms')">Terms &amp; Conditions</span> and <span class="lnk" onclick="openPolicy('privacy')">Privacy Policy</span>.</p>`;
const waOn=()=>/^https?:\/\//.test(DB.settings.waApi||'');
function socialIco(k){const u=DB.settings[k==='google'?'gLogo':'fbLogo'];const bg=k==='google'?'#fff':'#fff';return `<span style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:${bg};flex:0 0 30px;overflow:hidden;box-shadow:0 0 0 1px rgba(0,0,0,.08)">${u?`<img src="${u}" alt="" style="width:20px;height:20px;object-fit:contain">`:`<b style="font-size:17px;color:${k==='google'?'#4285F4':'#1877F2'}">${k==='google'?'G':'f'}</b>`}</span>`}
function socialRow(){const g=DB.settings.gLogin!==false,f=DB.settings.fbLogin===true;if(!FB_ON||(!g&&!f))return '';const bs='width:100%;display:flex;align-items:center;justify-content:center;gap:12px;min-height:48px;border-radius:999px;font-size:15px;font-weight:600;cursor:pointer;';return `<div style="display:flex;flex-direction:column;gap:10px;margin:14px 0 4px">${g?`<button style="${bs}background:#fff;color:#222;border:1px solid #cfcfcf" onclick="socialAuth('google')">${socialIco('google')}<span>${ck.su?'Sign up':'Continue'} with Google</span></button>`:''}${f?`<button style="${bs}background:#1877F2;color:#fff;border:0" onclick="socialAuth('facebook')">${socialIco('facebook')}<span>${ck.su?'Sign up':'Continue'} with Facebook</span></button>`:''}<p style="text-align:center;font-size:12px;color:var(--mute);margin:4px 0 0">— or —</p></div>`}
function setSU(v){ck.su=v;if(v)signupForm();else if(ck.cur==='email')loginEmail('signin');else loginStep1()}
function suToggle(){return `<div style="display:flex;background:#f3f0ea;border-radius:999px;padding:4px;margin:12px 0 4px"><button style="flex:1;border:0;border-radius:999px;padding:9px;font-size:14px;cursor:pointer;${!ck.su?'background:#111;color:#fff':'background:transparent;color:#555'}" onclick="setSU(false)">Login</button><button style="flex:1;border:0;border-radius:999px;padding:9px;font-size:14px;cursor:pointer;${ck.su?'background:#111;color:#fff':'background:transparent;color:#555'}" onclick="setSU(true)">Sign Up</button></div>`}
function loginTabs(on){ck.cur=on;return suToggle()+`<div class="tabs2">${waOn()?`<button class="${on==='wa'?'on':''}" onclick="loginWa()">WhatsApp</button>`:''}${ck.su?`<button class="${on==='signup'?'on':''}" onclick="signupForm()">Your details</button><button class="${on==='phone'?'on':''}" onclick="loginStep1()">Mobile OTP</button>`:`<button class="${on==='phone'?'on':''}" onclick="loginStep1()">SMS OTP</button><button class="${on==='email'?'on':''}" onclick="loginEmail('signin')">Email</button>`}</div>${socialRow()}`}
function loginWa(){
  $('#loginBody').innerHTML=`<h2>${ck.su?'Create Account':'Login'}</h2>${loginTabs('wa')}<p style="color:var(--mute);font-size:14px;margin-top:12px">Enter your WhatsApp number and we will send a 6-digit OTP on WhatsApp. New here? Your account is created automatically.</p><label>WhatsApp number</label><div style="display:flex;gap:8px"><input value="+91" disabled style="width:72px"><input id="lph" inputmode="tel" maxlength="10" placeholder="10-digit number" onkeydown="if(event.key==='Enter')sendWaOtp()"></div><button class="btn dark" id="sotp" style="width:100%;margin-top:16px" onclick="sendWaOtp()">Send OTP on WhatsApp</button>${TERMS_LINE}`;
}
function loginWa2(){
  $('#loginBody').innerHTML=`<h2>Enter OTP</h2><p style="color:var(--mute);font-size:14px">Enter the 6-digit OTP we sent on WhatsApp to +91 ${esc(ck.lph)}.</p><input id="lotp" inputmode="numeric" maxlength="6" placeholder="------" style="letter-spacing:10px;font-size:22px;text-align:center;margin-top:12px" onkeydown="if(event.key==='Enter')verifyWaOtp()"><button class="btn dark" style="width:100%;margin-top:16px" onclick="verifyWaOtp()">Verify</button><p style="margin-top:14px;font-size:13px"><span class="lnk" onclick="loginWa()">Change number</span> · <span class="lnk" onclick="sendWaOtp(true)">Resend OTP</span></p>`;
}
async function waCall(body){
  const r=await fetch(DB.settings.waApi,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  let j={};try{j=await r.json()}catch(e){}
  if(!r.ok)throw new Error(j.error||('Server error ('+r.status+')'));
  return j;
}
async function sendWaOtp(again){
  const ph=again?ck.lph:($('#lph').value||'').replace(/\D/g,'').replace(/^91(?=\d{10}$)/,'');
  if(!/^[6-9]\d{9}$/.test(ph))return toast('Enter a valid 10-digit WhatsApp number');
  ck.lph=ph;const b=$('#sotp');if(b){b.disabled=true;b.textContent='Sending…'}
  try{await waCall({action:'send',phone:ph});loginWa2();toast('OTP sent on WhatsApp')}
  catch(e){toast(e.message||'Could not send the OTP');if(b){b.disabled=false;b.textContent='Send OTP on WhatsApp'}}
}
async function verifyWaOtp(){
  const c=($('#lotp').value||'').trim();
  if(c.length<6)return toast('Enter the 6-digit OTP');
  if(!await ensureFB())return;
  try{
    const j=await waCall({action:'verify',phone:ck.lph,code:c});
    const r=await FB.au.signInWithCustomToken(FB.auth,j.token);
    USER={uid:r.user.uid,phone:ck.lph,email:''};
  }catch(e){return toast(e.message||'Incorrect OTP, please try again')}
  uiUser();
  if(await needProfile())return completeProfile();
  closeAll();toast('Login successful ✓');
  const f=ck.after;ck.after=null;if(f)f();
}
const profKey=u=>'zavra_prof_'+u;
async function loadProfile(){
  if(!FB_ON||!FB||!USER)return;
  try{const sn=await FB.fs.getDoc(FB.fs.doc(FB.db,'users',USER.uid));
    if(sn.exists()){const pr=sn.data().prof||{};localStorage.setItem(profKey(USER.uid),JSON.stringify(pr));if(pr.name)USER.name=pr.name}}catch(e){console.warn('profile load',e)}
}
async function saveProfile(pr){
  try{localStorage.setItem(profKey(USER.uid),JSON.stringify(pr))}catch(e){}
  if(FB_ON&&FB){try{await FB.fs.setDoc(FB.fs.doc(FB.db,'users',USER.uid),{prof:pr,updated:Date.now()})}catch(e){console.warn('profile save',e)}}
}
function signupForm(){
  ck.su=true;
  $('#loginBody').innerHTML=`<h2>Create Account</h2>${loginTabs('signup')}<p style="color:var(--mute);font-size:14px;margin-top:12px">Create your account with your details. Your address is saved so checkout is quicker next time.</p><label>Full name *</label><input id="sn" autocomplete="name"><div class="row2 keep"><div><label>Mobile number *</label><input id="sph" inputmode="tel" maxlength="16" placeholder="10-digit number" autocomplete="tel"></div><div><label>Email *</label><input id="sem" type="email" autocomplete="email"></div></div><label>Password *</label><input id="spw" type="password" autocomplete="new-password" placeholder="At least 6 characters"><label>Full address (house/flat, street, area)</label><textarea id="sad" rows="2"></textarea><div class="row2"><div><label>City / District</label><input id="sct"></div><div><label>PIN code</label><input id="spin" maxlength="6" inputmode="numeric"></div></div><label>Country</label><select id="scn">${COUNTRIES.map(c=>`<option>${c}</option>`).join('')}</select><button class="btn dark" style="width:100%;margin-top:16px" onclick="signupSubmit()">Create Account</button><p style="margin-top:14px;font-size:13px">Already have an account? <span class="lnk" onclick="setSU(false)">Login</span></p>${TERMS_LINE}`;
}
async function signupSubmit(){
  const g=id=>(($('#'+id)||{}).value||'').trim();
  const nm=g('sn'),em=g('sem'),pw=($('#spw')||{}).value||'',ad=g('sad'),ct=g('sct'),pin=g('spin'),cn=($('#scn')||{}).value||'India';
  let ph=g('sph').replace(/[^\d+]/g,'').replace(/^\+?91(?=\d{10}$)/,'');
  if(nm.length<2)return toast('Enter your full name');
  if(cn==='India'?!/^[6-9]\d{9}$/.test(ph):!/^\+?\d{7,15}$/.test(ph))return toast('Enter a valid mobile number');
  if(!/^\S+@\S+\.\S+$/.test(em))return toast('Enter a valid email address');
  if(pw.length<6)return toast('Password must be at least 6 characters');
  if(pin&&cn==='India'&&!/^\d{6}$/.test(pin))return toast('Enter a valid 6-digit PIN code');
  const prof={name:nm,phone:ph,email:em,address:ad,city:ct,pin,country:cn};
  if(!FB_ON){
    USER={uid:'local-'+ph,phone:ph,email:em,name:nm};localStorage.setItem('zavra_user',JSON.stringify(USER));await saveProfile(prof);
  }else{
    if(!await ensureFB())return;
    let cred;
    try{cred=await FB.au.createUserWithEmailAndPassword(FB.auth,em,pw);try{await FB.au.updateProfile(cred.user,{displayName:nm})}catch(x){}}
    catch(e){console.error(e);return toast(authErr(e))}
    if(em===ADMIN_EMAIL){closeAll();location.hash='#admin';return}
    USER={uid:cred.user.uid,phone:'',email:em,name:nm};await saveProfile(prof);
  }
  await refreshSeller();uiUser();closeAll();toast('Account created ✓');
  const f=ck.after;ck.after=null;if(f)f();
}
async function needProfile(){
  if(!ck.su)return false;
  await loadProfile();
  let pr={};try{pr=JSON.parse(localStorage.getItem(profKey(USER.uid))||'{}')}catch(e){}
  return !(pr.address&&pr.city&&pr.pin);
}
function completeProfile(){
  let pr={};try{pr=JSON.parse(localStorage.getItem(profKey(USER.uid))||'{}')}catch(e){}
  const em=pr.email||(/@/.test(USER.email||'')?USER.email:'');
  $('#loginBody').innerHTML=`<h2>Complete your details</h2><p style="color:var(--mute);font-size:14px;margin-top:8px">Almost done! Please add your delivery details. They are saved so checkout is quick next time.</p><label>Full name *</label><input id="cpn" value="${esc(pr.name||USER.name||'')}" autocomplete="name"><div class="row2 keep"><div><label>Mobile number *</label><input id="cpp" inputmode="tel" maxlength="16" value="${esc(USER.phone||pr.phone||'')}" ${USER.phone?'disabled':''} placeholder="10-digit number"></div><div><label>Alternate mobile</label><input id="cpa" inputmode="tel" maxlength="16" value="${esc(pr.alt||'')}" placeholder="Optional"></div></div><label>Full address (house/flat, street, area) *</label><textarea id="cpd" rows="2">${esc(pr.address||'')}</textarea><div class="row2"><div><label>City / District *</label><input id="cpc" value="${esc(pr.city||'')}"></div><div><label>PIN code *</label><input id="cpz" maxlength="6" inputmode="numeric" value="${esc(pr.pin||'')}"></div></div><label>Country</label><select id="cpk">${COUNTRIES.map(c=>`<option ${c===(pr.country||'India')?'selected':''}>${c}</option>`).join('')}</select><label>Email (optional)</label><input id="cpe" type="email" value="${esc(em)}"><button class="btn dark" style="width:100%;margin-top:16px" onclick="saveCompleteProfile()">Save &amp; Continue</button>`;
}
async function saveCompleteProfile(){
  const g=id=>(($('#'+id)||{}).value||'').trim();
  const nm=g('cpn'),ad=g('cpd'),ct=g('cpc'),pin=g('cpz'),cn=($('#cpk')||{}).value||'India',em=g('cpe');
  const clean=v=>v.replace(/[^\d+]/g,'').replace(/^\+?91(?=\d{10}$)/,'');
  const ph=clean(USER.phone||g('cpp')),alt=clean(g('cpa'));
  if(nm.length<2)return toast('Enter your full name');
  if(cn==='India'?!/^[6-9]\d{9}$/.test(ph):!/^\+?\d{7,15}$/.test(ph))return toast('Enter a valid mobile number');
  if(alt&&!/^\+?\d{7,15}$/.test(alt))return toast('Enter a valid alternate mobile number');
  if(!ad)return toast('Enter your full address');
  if(!ct)return toast('Enter your city / district');
  if(cn==='India'?!/^\d{6}$/.test(pin):pin.length<3)return toast('Enter a valid PIN code');
  if(em&&!/^\S+@\S+\.\S+$/.test(em))return toast('Enter a valid email address');
  USER.name=nm;
  await saveProfile({name:nm,phone:ph,alt,email:em,address:ad,city:ct,pin,country:cn});
  uiUser();closeAll();toast('Details saved ✓');
  const f=ck.after;ck.after=null;if(f)f();
}
function loginStep1(){
  $('#loginBody').innerHTML=`<h2>${ck.su?'Create Account':'Login'}</h2>${loginTabs('phone')}<p style="color:var(--mute);font-size:14px;margin-top:12px">${ck.su?'Enter your mobile number to create your account. We will send you an OTP to verify it.':'Enter your mobile number and we will send you an OTP to log in.'}</p>${FB_ON?'':'<p class="note">Demo mode: enter any 10-digit number, the OTP is <b>123456</b>.</p>'}<label>Mobile number</label><div style="display:flex;gap:8px"><input value="+91" disabled style="width:72px"><input id="lph" inputmode="tel" maxlength="10" placeholder="10-digit number" onkeydown="if(event.key==='Enter')sendOtp()"></div><button class="btn dark" id="sotp" style="width:100%;margin-top:16px" onclick="sendOtp()">Send OTP</button>${TERMS_LINE}`;
}
function loginStep2(){
  $('#loginBody').innerHTML=`<h2>Enter OTP</h2><p style="color:var(--mute);font-size:14px">Enter the 6-digit OTP sent to +91 ${esc(ck.lph)}.</p><input id="lotp" inputmode="numeric" maxlength="6" placeholder="------" style="letter-spacing:10px;font-size:22px;text-align:center;margin-top:12px" onkeydown="if(event.key==='Enter')verifyOtp()"><button class="btn dark" style="width:100%;margin-top:16px" onclick="verifyOtp()">Verify</button><p style="margin-top:14px;font-size:13px"><span class="lnk" onclick="loginStep1()">Change number</span> · <span class="lnk" onclick="sendOtp(true)">Resend OTP</span></p>`;
}
function loginEmail(mode){
  const su=mode==='signup';ck.su=su;
  $('#loginBody').innerHTML=`<h2>${su?'Create Account':'Welcome Back'}</h2>${loginTabs('email')}${su?'<label>Full name</label><input id="lnm" autocomplete="name">':''}<label>Email</label><input id="lem" type="email" autocomplete="email"><label>Password</label><input id="lpw" type="password" autocomplete="${su?'new-password':'current-password'}" placeholder="${su?'At least 6 characters':''}" onkeydown="if(event.key==='Enter')emailAuth('${mode}')"><button class="btn dark" style="width:100%;margin-top:16px" onclick="emailAuth('${mode}')">${su?'Create Account':'Sign In'}</button><p style="margin-top:14px;font-size:13px">${su?'Already have an account? <span class="lnk" onclick="loginEmail(\'signin\')">Sign in</span>':'New here? <span class="lnk" onclick="setSU(true)">Create an account</span> · <span class="lnk" onclick="forgotPw()">Forgot password?</span>'}</p>${TERMS_LINE}`;
}
const AUTH_ERR={'auth/email-already-in-use':'This email is already registered — please sign in','auth/invalid-credential':'Incorrect email or password','auth/wrong-password':'Incorrect email or password','auth/user-not-found':'Incorrect email or password','auth/invalid-email':'Enter a valid email address','auth/weak-password':'Password must be at least 6 characters','auth/too-many-requests':'Too many attempts, please try again later','auth/network-request-failed':'Check your internet connection','auth/operation-not-allowed':'Email/Password sign-in is not enabled in Firebase','auth/unauthorized-domain':'This website address is not authorised in Firebase'};
const authErr=e=>(AUTH_ERR[(e&&e.code)||'']||'Something went wrong')+' ['+((e&&e.code)||(e&&e.message)||'error')+']';
async function ensureFB(){if(!FB_ON){toast('Email login needs Firebase to be connected');return false}if(!FB){try{await initFB()}catch(x){console.error(x);toast('Could not load Firebase');return false}}return true}
async function emailAuth(mode,sellerInfo){
  const em=($('#lem').value||'').trim(),pw=$('#lpw').value||'';
  if(!/^\S+@\S+\.\S+$/.test(em))return toast('Enter a valid email address');
  if(pw.length<6)return toast('Password must be at least 6 characters');
  if(!await ensureFB())return;
  let cred;
  try{
    if(mode==='signup'){
      cred=await FB.au.createUserWithEmailAndPassword(FB.auth,em,pw);
      const nm=(($('#lnm')||{}).value||'').trim();if(nm){try{await FB.au.updateProfile(cred.user,{displayName:nm})}catch(x){}}
    }else cred=await FB.au.signInWithEmailAndPassword(FB.auth,em,pw);
  }catch(e){console.error(e);return toast(authErr(e))}
  if(em===ADMIN_EMAIL){closeAll();location.hash='#admin';return}
  USER={uid:cred.user.uid,phone:'',email:em};
  await refreshSeller();uiUser();closeAll();toast(mode==='signup'?'Account created ✓':'Login successful ✓');
  const f=ck.after;ck.after=null;if(f)f();
}
async function socialAuth(kind){
  if(!await ensureFB())return;
  const pr=kind==='facebook'?new FB.au.FacebookAuthProvider():new FB.au.GoogleAuthProvider();
  if(kind==='google')pr.setCustomParameters({prompt:'select_account'});
  try{
    const cred=await FB.au.signInWithPopup(FB.auth,pr);
    const u=cred.user;
    if(u.email&&u.email===ADMIN_EMAIL){closeAll();location.hash='#admin';return}
    USER={uid:u.uid,phone:'',email:u.email||u.displayName||''};
    await refreshSeller();uiUser();
    if(await needProfile())return completeProfile();
    closeAll();toast('Login successful ✓');
    const f=ck.after;ck.after=null;if(f)f();
  }catch(e){
    console.error(e);
    const c=(e&&e.code)||'';
    if(c==='auth/popup-closed-by-user'||c==='auth/cancelled-popup-request')return;
    const M={'auth/operation-not-allowed':'This login method is not enabled yet','auth/unauthorized-domain':'This website address is not authorised in Firebase','auth/popup-blocked':'Please allow pop-ups for this site and try again','auth/account-exists-with-different-credential':'An account already exists with this email — sign in with your original method'};
    toast((M[c]||'Login failed')+' ['+(c||'error')+']');
  }
}
async function forgotPw(){
  const em=($('#lem').value||'').trim();
  if(!/^\S+@\S+\.\S+$/.test(em))return toast('Enter your email above first');
  if(!await ensureFB())return;
  try{await FB.au.sendPasswordResetEmail(FB.auth,em);toast('Password reset email sent — check your inbox')}catch(e){toast(authErr(e))}
}
function resetRecaptcha(){try{window._rv&&window._rv.clear()}catch(x){}window._rv=null;const h=$('#rc');if(h)h.innerHTML=''}
function mkRcEl(){const d=document.createElement('div');$('#rc').appendChild(d);return d}
const OTP_ERR={'auth/unauthorized-domain':'This website address is not authorised in Firebase','auth/captcha-check-failed':'reCAPTCHA check failed (is the domain authorised?)','auth/too-many-requests':'Too many attempts, please try again later','auth/quota-exceeded':'Daily SMS limit reached','auth/operation-not-allowed':'Phone sign-in is not enabled in Firebase','auth/invalid-phone-number':'Invalid mobile number','auth/billing-not-enabled':'Firebase billing must be enabled to send SMS','auth/invalid-app-credential':'App verification failed, refresh and try again','auth/network-request-failed':'Check your internet connection','auth/internal-error':'Firebase internal error — check config and domain'};
function otpErr(e){const c=(e&&e.code)||'';return 'Could not send OTP — '+(OTP_ERR[c]||'')+' ['+(c||(e&&e.message)||String(e))+']'}
async function sendOtp(again){
  const ph=again?ck.lph:($('#lph').value||'').replace(/\D/g,'').replace(/^91(?=\d{10}$)/,'');
  if(!/^[6-9]\d{9}$/.test(ph))return toast('Enter a valid 10-digit mobile number');
  ck.lph=ph;
  if(!FB_ON)return loginStep2();
  if(!FB){try{await initFB()}catch(x){console.error(x);const eb0=document.createElement('p');eb0.className='note';eb0.style.color='#b33';eb0.textContent='Firebase failed to load: '+(x.code||'')+' '+(x.message||x);$('#loginBody').appendChild(eb0);return}}
  const b=$('#sotp');if(b){b.disabled=true;b.textContent='Sending…'}
  try{
    resetRecaptcha();
    window._rv=new FB.au.RecaptchaVerifier(FB.auth,mkRcEl(),{size:'invisible'});
    ck.conf=await FB.au.signInWithPhoneNumber(FB.auth,'+91'+ph,window._rv);
    loginStep2();toast('OTP sent');
  }catch(e){
    console.error(e);toast(otpErr(e));
    const eb=document.createElement('p');eb.className='note';eb.style.color='#b33';eb.textContent='Error: '+(e.code||'')+' '+(e.message||e);$('#loginBody').appendChild(eb);
    resetRecaptcha();
    if(b){b.disabled=false;b.textContent='Send OTP'}
  }
}
async function verifyOtp(){
  const c=($('#lotp').value||'').trim();
  if(c.length<6)return toast('Enter the 6-digit OTP');
  try{
    if(!FB_ON){
      if(c!=='123456')return toast('Incorrect OTP');
      USER={uid:'local-'+ck.lph,phone:ck.lph,email:''};localStorage.setItem('zavra_user',JSON.stringify(USER));
    }else{
      const r=await ck.conf.confirm(c);USER={uid:r.user.uid,phone:ck.lph,email:''};
    }
  }catch(e){return toast('Incorrect OTP, please try again')}
  uiUser();
  if(await needProfile())return completeProfile();
  closeAll();toast('Login successful ✓');
  const f=ck.after;ck.after=null;if(f)f();
}
function userLogout(){
  if(FB_ON&&FB)FB.au.signOut(FB.auth);else localStorage.removeItem('zavra_user');
  USER=null;SELLER=null;uiUser();closeAll();toast('Logged out');
  if(location.hash==='#seller')route();
}
const PSL={Pending:'Payment pending verification',Paid:'Payment received',COD:'Cash on Delivery'};
async function openAccount(live){
  if(!USER)return openLogin(openAccount);
  if(live!==true){closeAll();$('#tbody').innerHTML='<p>Loading…</p>';$('#tov').classList.add('on');
  if(FB_ON){try{const q=FB.fs.query(FB.fs.collection(FB.db,'orders'),FB.fs.where('uid','==',USER.uid));const sn=await FB.fs.getDocs(q);DB.orders=sn.docs.map(d=>d.data())}catch(e){toast('Could not load orders')}}}
  tview={k:'acct',id:''};
  const my=DB.orders.filter(o=>o.uid===USER.uid).sort((a,b)=>String(b.date).localeCompare(String(a.date)));
  $('#tbody').innerHTML=`<h2>My Orders</h2><p style="font-size:14px;color:var(--mute)">${USER.phone?'+91 '+esc(USER.phone):esc(USER.email)} · <span class="lnk" onclick="userLogout()">Logout</span>${SELLER?' · <a class="lnk" href="#seller" onclick="closeAll()">Seller Panel</a>':''}</p>${my.length?my.map(o=>`<div class="ord"><div style="display:flex;justify-content:space-between"><b>${esc(o.id)}</b><span class="badge b-${o.status}">${STL[o.status]}</span></div><small style="color:var(--mute)">${new Date(o.date).toLocaleString('en-IN')}</small><div style="margin:6px 0">${o.items.map(i=>esc(i.name)+(i.size?` (${esc(i.size)})`:'')+' ×'+bn(i.qty)).join('<br>')}</div><div>${tk(o.total)} · ${esc(o.pay)}<br><small>${PSL[o.payStatus]||''}</small></div>${o.status!=='Cancelled'&&o.status!=='Delivered'?`<div style="margin-top:6px;font-size:13px">🕒 Expected delivery: <b>${esc(o.eta||DB.settings.eta||'5–7 business days')}</b></div>`:''}${o.courier?`<div style="margin-top:6px">Courier: <b>${esc(o.courier)}</b> · Tracking ID: <b>${esc(o.tracking)}</b></div>`:''}<button class="btn sm" style="margin-top:8px" onclick="openTrack('${o.id}')">Track order</button></div>`).join(''):'<p class="note">You have no orders yet.</p>'}`;
}

/* ---------- Store ---------- */
let gal=[],gi=0;
const pImgs=p=>(p.imgs&&p.imgs.length)?p.imgs:(p.img?[p.img]:[productPhoto(p)]);
function gThumbs(p){gal=pImgs(p);gi=0;return gal.length>1?`<div class="thumbs">${gal.map((d,i)=>`<img src="${esc(d)}" class="${i?'':'on'}" onclick="gset(${i})" alt="">`).join('')}</div>`:''}
function gset(i){gi=i;const m=$('#gmain');if(m&&gal[i])m.innerHTML=`<img src="${esc(gal[i])}" alt="">`;document.querySelectorAll('.thumbs img').forEach((e,k)=>e.classList.toggle('on',k===i))}
function gnext(){if(gal.length>1)gset((gi+1)%gal.length)}
function pimg(p){return `<img loading="lazy" src="${esc(productPhoto(p))}" alt="${esc(p.name)}" onerror="this.style.display='none';this.parentNode.insertAdjacentHTML('beforeend','<span>✦</span>')">`}
function bg(p){return 'background:#eef2ff'}
function renderShowcase(){
  const cs=sortedCats();
  $('#gq').innerHTML=GORD.map(g=>`<div class="gqi" style="background:linear-gradient(135deg,${GCOL[g][0]},${GCOL[g][1]})" onclick="const e=document.getElementById('gs-${g}');e?e.scrollIntoView({behavior:'smooth',block:'start'}):(setGroup('${g}'),go())"><i>${GICON[g]}</i><b>${esc(GROUPS[g].en)}</b><span style="background:${GCOL[g][2]}">›</span></div>`).join('');
  $('#catshow').innerHTML=GORD.map(g=>{
    const list=cs.filter(c=>c.group===g);if(!list.length)return'';
    return `<div class="gs" id="gs-${g}" style="background:linear-gradient(135deg,${GCOL[g][0]},${GCOL[g][1]} 70%);border-color:${GCOL[g][0]}"><div class="gs-h"><span class="gs-i">${GICON[g]}</span><div><h3 style="color:${GCOL[g][2]}">${esc(GROUPS[g].en)}</h3><small>${GROUPS[g].tag}</small></div><button class="vall" style="background:${GCOL[g][2]}" onclick="setGroup('${g}');go()">View All →</button></div><div class="gs-row">${list.map(c=>{
      const n=liveProducts().filter(p=>p.cat===c.id).length;
      return `<div class="gt" onclick="pickCat('${esc(c.id)}')"><div class="gt-i"><img loading="lazy" src="${esc(catPhoto(c))}" alt="${esc(c.en)}" onerror="this.style.display='none';this.parentNode.insertAdjacentHTML('beforeend','<em>${esc(c.emoji||'✦')}</em>')"></div><b>${esc(c.en)}</b><small>${bn(n)} ${n===1?'item':'items'}</small></div>`}).join('')}</div></div>`}).join('');
}
function renderGrid(){
  const q=searchQ.trim().toLowerCase();
  $('#grpbar').innerHTML=[['all','All'],...GORD.map(g=>[g,GROUPS[g].en])].map(([g,l])=>`<button class="chip ${curGroup===g&&curCat==='all'?'on':''}" onclick="setGroup('${g}')">${l}</button>`).join('');
  $('#filters').innerHTML=sortedCats().filter(c=>curGroup==='all'||c.group===curGroup).map(c=>`<button class="chip sm ${curCat===c.id?'on':''}" onclick="setCat('${esc(c.id)}')">${esc(c.en)}</button>`).join('');
  $('#shopTitle').textContent=curCat!=='all'?catEn(curCat):curGroup==='all'?'Our Collection':GROUPS[curGroup].en+' Collection';
  const list=liveProducts().filter(p=>(curCat==='all'||p.cat===curCat)&&(curGroup==='all'||catGroup(p.cat)===curGroup)&&(!q||(p.name+' '+catEn(p.cat)).toLowerCase().includes(q))&&(!pmin||p.price>=pmin)&&(!pmax||p.price<=pmax));
  if(srt==='pl')list.sort((a,b)=>a.price-b.price);else if(srt==='ph')list.sort((a,b)=>b.price-a.price);else if(srt==='new')list.sort((a,b)=>(b.ord||b.id)-(a.ord||a.id));else if(srt==='disc')list.sort((a,b)=>(b.old>b.price?1-b.price/b.old:0)-(a.old>a.price?1-a.price/a.old:0));
  $('#grid').innerHTML=list.length?list.map(p=>`<div class="pc" onclick="openProduct(${p.id})"><div class="pimg" style="${bg(p)}">${pimg(p)}${p.stock<=0?'<div class="tag" style="background:#a33">Sold Out</div>':p.tag?`<div class="tag">${esc(p.tag)}</div>`:''}<button class="hrt ${WISH.includes(p.id)?'on':''}" data-h="${p.id}" onclick="toggleWish(${p.id},event)" aria-label="Save to wishlist">${WISH.includes(p.id)?'♥':'♡'}</button><div class="qv">Quick View</div></div><div class="pi"><small>${esc(catEn(p.cat))}</small><h3>${esc(p.name)}</h3>${p.rating>0?`<div class="rating-line">★ ${Number(p.rating).toFixed(1)} <small>(${bn(p.reviewCount||0)} reviews)</small></div>`:'<div class="rating-line">✦ <small>New arrival</small></div>'}<div class="price"><b>${tk(p.price)}</b>${p.old>p.price?`<s>${tk(p.old)}</s><span class="off">${Math.round((1-p.price/p.old)*100)}% off</span>`:''}</div>${p.offer?`<div class="ofl">🎁 ${esc(p.offer)}</div>`:''}<div class="dl">${p.price>=DB.delivery.free?'Free delivery':'Delivery available'}</div></div></div>`).join(''):'<p style="grid-column:1/-1;text-align:center;color:var(--mute)">No products found</p>';
}
const LOGO_SZ={S:{'--bw':'92px','--bh':'64px','--bih':'28px','--pw':'70px','--ph':'34px'},M:{'--bw':'112px','--bh':'78px','--bih':'36px','--pw':'84px','--ph':'40px'},L:{'--bw':'140px','--bh':'96px','--bih':'48px','--pw':'104px','--ph':'50px'}};
function applyLogoSize(){const z=LOGO_SZ[DB.settings.logoSize]||LOGO_SZ.M;Object.entries(z).forEach(([k,v])=>document.documentElement.style.setProperty(k,v))}
function ensureBrands(){const B=DB.brands||(DB.brands=clone(DEF.brands));clone(DEF.brands).forEach(d=>{if(!B.find(b=>b.group===d.group&&b.name===d.name))B.push(d)})}
let tbi=0,tbt=null;
function setTopbar(){const s=DB.settings,L=(Array.isArray(s.topbars)&&s.topbars.length?s.topbars:[s.topbar,'✦ CASH ON DELIVERY AVAILABLE ACROSS INDIA ✦','✦ INTERNATIONAL SHIPPING TO USA, UK, UAE & MORE ✦','✦ EASY 7-DAY RETURNS ✦']).filter(Boolean).map(x=>String(x).replace(/&amp;/g,'&'));const el=$('#topbar');clearInterval(tbt);
  const show=()=>{el.innerHTML='<span></span>';el.firstChild.textContent=L[tbi%L.length]||'';tbi++};tbi=0;show();if(L.length>1)tbt=setInterval(show,4000)}
let fst=null;
function cardHtml(p){return `<div class="pc" onclick="openProduct(${p.id})"><div class="pimg" style="${bg(p)}">${pimg(p)}${p.stock<=0?'<div class="tag" style="background:#a33">Sold Out</div>':p.tag?`<div class="tag">${esc(p.tag)}</div>`:''}</div><div class="pi"><small>${esc(catEn(p.cat))}</small><h3>${esc(p.name)}</h3>${p.rating>0?`<div class="rating-line">★ ${Number(p.rating).toFixed(1)} <small>(${bn(p.reviewCount||0)} reviews)</small></div>`:'<div class="rating-line">✦ <small>New arrival</small></div>'}<div class="price"><b>${tk(p.price)}</b>${p.old>p.price?`<s>${tk(p.old)}</s><span class="off">${Math.round((1-p.price/p.old)*100)}% off</span>`:''}</div>${p.offer?`<div class="ofl">🎁 ${esc(p.offer)}</div>`:''}</div></div>`}
function renderColls(){
  const el=$('#colls');if(!el)return;const ok=DB.products.filter(p=>p.status!=='pending'&&p.status!=='rejected');
  const deals=ok.filter(p=>p.old>p.price).sort((a,b)=>(1-b.price/b.old)-(1-a.price/a.old)).slice(0,12);
  const fresh=ok.slice().sort((a,b)=>(b.ord||b.id)-(a.ord||a.id)).slice(0,12);
  const row=(t,c,L)=>L.length>=2?`<div class="wrap colrow"><div class="colh"><h2 style="color:${c}">${t}</h2></div><div class="fs-track" style="overflow-x:auto">${L.map(cardHtml).join('')}</div></div>`:'';
  const fl=DB.settings.flash||{},fe=fl.end?new Date(fl.end).getTime():0,fp=ok.filter(p=>p.flash);
  const flash=(fl.on&&fe>Date.now()&&fp.length)?`<div class="wrap colrow"><div class="flashbar"><h2>⚡ ${esc(fl.title||'Flash Sale')}</h2><span class="cd">Ends in <b id="fcd">--</b></span></div><div class="fs-track" style="overflow-x:auto">${fp.map(cardHtml).join('')}</div></div>`:'';
  clearInterval(window._fcd);if(flash){const tick=()=>{const e=$('#fcd');if(!e)return;let d=Math.max(0,fe-Date.now());const h=Math.floor(d/36e5),m=Math.floor(d%36e5/6e4),sec=Math.floor(d%6e4/1e3);e.textContent=(h>=48?Math.floor(h/24)+'d ':'')+String(h%(h>=48?24:1e9)).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');if(d<=0){clearInterval(window._fcd);renderColls()}};window._fcd=setInterval(tick,1000);setTimeout(tick,0)}
  el.innerHTML=flash+row("🔥 Today's Deals",'#FF3030',deals)+row('🆕 New Arrivals','#6200EA',fresh);
}
function renderFeat(){renderColls();
  const sec=$('#fslide');if(!sec)return;const ok=DB.products.filter(p=>p.status!=='pending'&&p.status!=='rejected');
  let L=ok.filter(p=>p.feat);if(!L.length)L=ok.slice().reverse().slice(0,12);
  if(L.length<2){sec.style.display='none';return}sec.style.display='block';
  $('#fsTitle').textContent=DB.settings.fsTitle||'Trending Now';
  $('#fsTrack').innerHTML=L.map(cardHtml).join('');
  clearInterval(fst);const t=$('#fsTrack');let hold=false;['touchstart','mouseenter'].forEach(e=>t.addEventListener(e,()=>hold=true));['touchend','mouseleave'].forEach(e=>t.addEventListener(e,()=>setTimeout(()=>hold=false,2500)));
  fst=setInterval(()=>{if(hold)return;const w=t.firstChild?t.firstChild.getBoundingClientRect().width+14:230;if(t.scrollLeft+t.clientWidth>=t.scrollWidth-4)t.scrollTo({left:0});else t.scrollBy({left:w})},3200)}
function fsMove(d){const t=$('#fsTrack'),w=t.firstChild?t.firstChild.getBoundingClientRect().width+14:230;t.scrollBy({left:d*w})}
function renderStore(){
  const s=DB.settings;ensureBrands();applyLogoSize();
  setTopbar();
  $('#logoTxt').innerHTML=`<svg class="lgb" viewBox="0 0 32 32"><path d="M6 10h20l-1.5 17a2 2 0 01-2 1.8H9.5a2 2 0 01-2-1.8z" fill="#FFD500"/><path d="M11 10V8a5 5 0 0110 0v2" fill="none" stroke="#FFD500" stroke-width="2.2"/><path d="M12 15h8l-8 9h8" fill="none" stroke="#6200EA" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>${esc(s.name)}<small>Shop Smart, Live Better</small>`;
  document.title=s.name+' | Premium Fashion for Men, Women & Kids';
  $('#fPhones').innerHTML=String(s.phone||'').split(',').map(p=>p.trim()).filter(Boolean).map(p=>`<a href="tel:${esc(p.replace(/[^\d+]/g,''))}">📞 ${esc(p)}</a>`).join('');
  $('#fWa').textContent='💬 WhatsApp: +'+String(s.wa).replace(/\D/g,'');$('#fWa').href='https://wa.me/'+String(s.wa).replace(/\D/g,'');
  $('#fMail').textContent=s.email?'✉ '+s.email:'';$('#fMail').href=s.email?'mailto:'+s.email:'';
  $('#fDom').textContent=s.domain?'🌐 www.'+s.domain:'';
  $('#fSocial').innerHTML='<div class="soc">'+[
    [s.fb,'Facebook','<svg viewBox="0 0 24 24"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>'],
    [s.ig,'Instagram','<svg class="s" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6"/></svg>'],
    ['https://wa.me/'+String(s.wa||'').replace(/\D/g,''),'WhatsApp','<svg viewBox="0 0 32 32"><path d="M16.04 3C9.4 3 4 8.36 4 14.97c0 2.1.55 4.15 1.6 5.96L4 29l8.3-1.56a12.1 12.1 0 003.74.6C22.68 28.04 28 22.68 28 16.07 28 9.4 22.68 3 16.04 3zm0 22.04c-1.2 0-2.36-.3-3.4-.86l-.5-.27-4.9.92.97-4.7-.3-.5a9.9 9.9 0 01-1.5-5.23c0-5.5 4.5-9.97 10.04-9.97 5.48 0 9.96 4.47 9.96 9.97 0 5.5-4.48 9.94-10 9.94zm5.5-7.4c-.3-.15-1.78-.88-2.06-.98-.27-.1-.47-.15-.67.15-.2.3-.77.98-.95 1.18-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.4-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3 0-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.92-2.22-.24-.58-.5-.5-.67-.5h-.58c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.5 2.98 1.28 2.98.85 3.52.8.54-.05 1.76-.72 2-1.42.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.35z"/></svg>'],
    [s.tw,'X','<svg viewBox="0 0 24 24"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.3 4.7H5.5l11.2 14.5z"/></svg>']
  ].filter(x=>/^https?:\/\//.test(x[0]||'')).map(x=>`<a href="${esc(x[0])}" target="_blank" rel="noopener" aria-label="${x[1]}" title="${x[1]}">${x[2]}<span>${x[1]==='X'?'X (Twitter)':x[1]}</span></a>`).join('')+'</div>';
  {const B=(DB.brands||[]).filter(b=>!b.hide),row=(gs,seen={})=>B.filter(b=>gs.includes(b.group)).filter(b=>{const k=b.name.toLowerCase().replace(/\s*\(.*\)/,'');if(seen[k])return false;seen[k]=1;return true}).map(b=>`<span class="pchip" title="${esc(b.name)}">${b.logo?`<img src="${esc(b.logo)}" alt="${esc(b.name)}">`:esc(b.name.replace(/\s*\(.*\)/,''))}</span>`).join('');
   const ri=row(['in']),rw=row(['gw','intl']);
   $('#fPays').innerHTML=(ri?`<div class="prow"><b>Accepted in India</b><div class="pchips">${ri}</div></div>`:'')+(rw?`<div class="prow"><b>Accepted worldwide</b><div class="pchips">${rw}</div></div>`:'');
   $('#fPaysTxt').style.display=(ri||rw)?'none':'block'}
  renderShowcase();renderFeat();renderGrid();renderCstrip();
  $('#waFab').href='https://wa.me/'+String(s.wa).replace(/\D/g,'')+'?text='+encodeURIComponent('Hello '+s.name+', I would like to place an order / need help.');
  setBadge('wc',WISH.length);
  setBadge('cc',cart.reduce((a,c)=>a+c.qty,0));
  uiUser();
}
function setCat(c){curCat=c;curGroup=c==='all'?'all':catGroup(c);renderGrid()}
function setGroup(g){curGroup=g;curCat='all';renderGrid()}
function pickCat(id){setCat(id);go()}
function openProduct(id){
  const p=DB.products.find(x=>x.id===id);if(!p)return;
  const sz=p.sizes?p.sizes.split(',').map(x=>x.trim()).filter(Boolean):[];
  selSize=sz[0]||'';
  $('#pmd').innerHTML=`<button class="x" onclick="closeAll()">×</button><div class="pd"><div class="gal"><div class="pimg" id="gmain" style="${bg(p)}" onclick="gnext()">${pimg(p)}</div>${gThumbs(p)}</div><div class="in"><small style="color:var(--gold);letter-spacing:3px;text-transform:uppercase">${esc(catEn(p.cat))} </small><h2>${esc(p.name)}</h2><div class="price" style="margin:6px 0"><b style="font-size:24px">${tk(p.price)}</b>${p.old>p.price?`<s>${tk(p.old)}</s><span class="offtag">${Math.round((1-p.price/p.old)*100)}% OFF</span>`:''}</div>${p.offer?`<div class="cpn">🎁 ${esc(p.offer)}</div>`:''}<p style="font-size:12px;color:var(--mute)">Inclusive of all taxes</p><p style="color:var(--mute);margin-top:8px">${esc(p.desc)}</p>${p.fabric?`<p style="font-size:13px;margin-top:6px"><b>Fabric / quality:</b> ${esc(p.fabric)}</p>`:''}${sz.length?`<p style="margin-top:14px;font-size:13px;color:var(--mute)">Size</p><div class="sizes">${sz.map((s,i)=>`<button class="sz ${i?'':'on'}" onclick="pickSize(this,this.textContent)">${esc(s)}</button>`).join('')}</div>`:''}<p style="font-size:13px;margin:10px 0">${p.stock>0?`In stock (${bn(p.stock)} left)`:'<span style="color:#a33">Sold Out</span>'}</p><button class="btn" style="width:100%;${p.stock>0?'':'opacity:.4'}" ${p.stock>0?'':'disabled'} onclick="addCart(${p.id})">Add to Cart</button><button class="btn" style="width:100%;margin-top:10px;background:linear-gradient(90deg,#FF8A00,#FF3030)" ${p.stock>0?'':'disabled'} onclick="buyNow(${p.id})">Buy Now</button><button class="btn dark" style="width:100%;margin-top:10px;background:#1f9d55" onclick="waOrder(${p.id})">Order on WhatsApp</button><p style="font-size:12px;margin-top:12px;color:var(--mute)">7-day returns · <span class="lnk" onclick="openPolicy('returns')">Return Policy</span> · <span class="lnk" onclick="openPolicy('delivery')">Shipping Policy</span> · <span class="lnk" onclick="openPolicy('product')">Product Policy</span></p><p style="font-size:13px;margin-top:10px"><span class="lnk" data-hl="${p.id}" onclick="toggleWish(${p.id},event)">${WISH.includes(p.id)?'♥ Saved to wishlist':'♡ Save to wishlist'}</span> · Share: <span class="lnk" onclick="shareProd(${p.id},'wa')">WhatsApp</span> · <span class="lnk" onclick="shareProd(${p.id},'fb')">Facebook</span> · <span class="lnk" onclick="shareProd(${p.id},'copy')">Copy link</span></p></div></div>`;
  $('#pov').classList.add('on');
  {const x=[p.brand&&'Brand: '+p.brand,p.sku&&'SKU: '+p.sku,p.colors&&'Colours: '+p.colors,p.fabric&&'Fabric: '+p.fabric].filter(Boolean);const inn=document.querySelector('#pmd .pd .in');if(x.length&&inn)inn.insertAdjacentHTML('beforeend','<p style="font-size:12.5px;color:var(--mute);margin-top:12px;line-height:1.7">'+x.map(esc).join('<br>')+'</p>');
  let ld=document.getElementById('ldp');if(!ld){ld=document.createElement('script');ld.type='application/ld+json';ld.id='ldp';document.head.appendChild(ld)}
  ld.textContent=JSON.stringify({'@context':'https://schema.org','@type':'Product',name:p.name,description:p.desc||p.name,sku:p.sku||undefined,brand:p.brand?{'@type':'Brand',name:p.brand}:undefined,image:(p.img&&!/^data:/.test(p.img))?[p.img]:undefined,offers:{'@type':'Offer',priceCurrency:'INR',price:p.price,availability:p.stock>0?'https://schema.org/InStock':'https://schema.org/OutOfStock'}})}
  const COL=['black','white','red','blue','green','pink','yellow','orange','purple','maroon','grey','gray','brown','gold','silver','navy','cream','beige','wine','cherry','peach','mint','teal'];
  const nm=p.name.toLowerCase(),col=COL.find(c=>nm.includes(c));
  const ok=DB.products.filter(x=>x.id!==p.id&&x.status!=='pending'&&x.status!=='rejected');
  const sc=x=>(x.cat===p.cat?2:0)+(col&&x.name.toLowerCase().includes(col)?1:0);
  const sim=ok.map(x=>[sc(x),x]).sort((a,b)=>b[0]-a[0]).slice(0,10).map(a=>a[1]);
  if(sim.length)$('#pmd').insertAdjacentHTML('beforeend',`<div style="padding:8px 18px 26px"><h3 style="font-family:'Cormorant Garamond',serif;font-size:26px;margin:14px 0 10px">You may also like</h3><div class="fs-track">${sim.map(cardHtml).join('')}</div></div>`);
  $('#pmd').scrollTop=0;$('#pov').scrollTop=0;
}
const prodUrl=id=>location.origin+location.pathname+'#p'+id;
function shareProd(id,w){
  const p=DB.products.find(x=>x.id===id);if(!p)return;const u=prodUrl(id),tx=p.name+' — '+tk(p.price)+' | '+DB.settings.name;
  if(w==='wa')window.open('https://wa.me/?text='+encodeURIComponent(tx+'\n'+u),'_blank');
  else if(w==='fb')window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(u),'_blank');
  else{(navigator.clipboard?navigator.clipboard.writeText(u):Promise.reject()).then(()=>toast('Link copied')).catch(()=>prompt('Copy this link',u))}
}
function pickSize(b,s){selSize=s;b.parentNode.querySelectorAll('.sz').forEach(x=>x.classList.remove('on'));b.classList.add('on')}
function addCart(id){
  const p=DB.products.find(x=>x.id===id);const ex=cart.find(c=>c.id===id&&c.size===selSize);
  if(ex){if(ex.qty<p.stock)ex.qty++}else cart.push({id,size:selSize,qty:1});
  saveCart();renderStore();closeAll();openCart();
}
function buyNow(id){const p=DB.products.find(x=>x.id===id);if(!p)return;if(!cart.find(c=>c.id===id&&c.size===selSize))cart.push({id,size:selSize,qty:1});saveCart();renderStore();closeAll();openCheckout()}
function openCart(){renderCart();$('#drawer').classList.add('on')}
function cartSub(){return cart.reduce((a,c)=>{const p=DB.products.find(x=>x.id===c.id);return a+(p?p.price*c.qty:0)},0)}
function renderCart(){
  cart=cart.filter(c=>DB.products.find(x=>x.id===c.id));
  $('#cartBody').innerHTML=cart.length?cart.map((c,i)=>{const p=DB.products.find(x=>x.id===c.id);return `<div class="ci"><div class="th" style="${bg(p)}">${pimg(p)}</div><div class="t"><b>${esc(p.name)}</b>${c.size?` <small>(${esc(c.size)})</small>`:''}<div>${tk(p.price)}</div><div class="qty"><button onclick="chQty(${i},-1)">−</button>${bn(c.qty)}<button onclick="chQty(${i},1)">+</button> <button class="rm" onclick="rmCart(${i})">Remove</button></div></div></div>`}).join(''):'<p style="text-align:center;color:var(--mute);margin-top:50px">Your cart is empty</p>';
  $('#cartFoot').innerHTML=cart.length?`<div style="display:flex;justify-content:space-between;margin-bottom:12px"><span>Subtotal</span><b>${tk(cartSub())}</b></div><button class="btn" style="width:100%" onclick="openCheckout()">Checkout</button>`:'';
  setBadge('cc',cart.reduce((a,c)=>a+c.qty,0));
}
function chQty(i,d){const p=DB.products.find(x=>x.id===cart[i].id);cart[i].qty=Math.max(1,Math.min(p.stock,cart[i].qty+d));saveCart();renderCart()}
function rmCart(i){cart.splice(i,1);saveCart();renderCart()}

function intlRate(c){const t=String(DB.delivery.intlTxt||'');for(const ln of t.split('\n')){const m=ln.split('=');if(m.length===2&&m[0].trim().toLowerCase()===String(c).toLowerCase()&&m[1].trim()!==''&&!isNaN(+m[1]))return +m[1]}return null}
function shipCost(){const d=DB.delivery;
  if((ck.country||'India')!=='India'){const f=+d.intlFree||0;if(f&&cartSub()>=f)return 0;const r=intlRate(ck.country);if(r!=null)return r;return d.intl==null?2499:+d.intl}
  if(cartSub()>=d.free)return 0;return ck.state&&ck.state!==d.home?d.outside:d.inside}
function stateBox(){
  const inIN=(ck.country||'India')==='India';
  $('#stBox').innerHTML=inIN?`<label>State *</label><select id="cst" onchange="ck.state=this.value;sumUpdate();renderPay()">${STATES.map(s=>`<option ${s===ck.state?'selected':''}>${s}</option>`).join('')}</select>`:`<label>State / Province / Region *</label><input id="cst2" value="${esc(ck.state&&!STATES.includes(ck.state)?ck.state:'')}" onchange="ck.state=this.value.trim()">`;
  $('#pinLb').textContent=inIN?'PIN code *':'ZIP / Postal code *';
  const pc=$('#cpin');pc.maxLength=inIN?6:10;pc.placeholder=inIN?'6 digits':'Postal code';
}
function onCountry(v){
  ck.country=v;if(v==='India'){if(!STATES.includes(ck.state))ck.state=DB.delivery.home}else if(STATES.includes(ck.state))ck.state='';
  stateBox();const ok=DB.pay.filter(p=>p.on&&payOk(p));if(!ok.find(p=>p.id===ck.pay))ck.pay=ok[0]?ok[0].id:null;
  sumUpdate();renderPay();
}
function openCheckout(){
  if(!USER)return openLogin(openCheckout);
  closeAll();
  let prof={};try{prof=JSON.parse(localStorage.getItem('zavra_prof_'+USER.uid)||'{}')}catch(e){}
  ck.country=prof.country||'India';const pays=DB.pay.filter(p=>p.on&&payOk(p));ck.pay=pays[0]?pays[0].id:null;ck.state=prof.state||DB.delivery.home;
  $('#checkout').innerHTML=`<h2>Checkout</h2>
  <label>Your name *</label><input id="cn" value="${esc(prof.name||USER.name||'')}">
  <div class="row2 keep"><div><label>Mobile number *</label><input id="cph" inputmode="tel" maxlength="16" placeholder="Mobile (abroad: with country code)" value="${esc(USER.phone||prof.phone||'')}" ${USER.phone?'disabled':''}></div><div><label>Email (optional)</label><input id="ce" value="${esc(USER.email||prof.email||'')}"></div></div>
  <label>Alternate mobile (optional)</label><input id="calt" inputmode="tel" maxlength="16" value="${esc(prof.alt||'')}">
  <label>Full address (house/flat, street, area) *</label><textarea id="ca" rows="2">${esc(prof.address||'')}</textarea>
  <div class="row2"><div><label>City / District *</label><input id="cc2" value="${esc(prof.city||'')}"></div><div><label id="pinLb">PIN code *</label><input id="cpin" maxlength="6" placeholder="6 digits" value="${esc(prof.pin||'')}"></div></div>
  <label>Country *</label><select id="ccn" onchange="onCountry(this.value)">${COUNTRIES.map(c=>`<option ${c===ck.country?'selected':''}>${c}</option>`).join('')}</select>
  <div id="stBox"></div>
  <label>Payment method</label><div id="payList"></div>
  <div id="payExtra"></div>
  <div class="cpn" id="cpnBox"><div style="display:flex;gap:8px"><input id="ccp" placeholder="Have a coupon code?" style="text-transform:uppercase"><button type="button" class="btn sm dark" onclick="applyCoupon()">Apply</button></div><div id="cpnMsg" style="font-size:12px;margin-top:6px"></div></div>
  <div class="sum" id="sum"></div>
  <label class="sw" style="margin-top:16px;color:var(--ink);align-items:flex-start"><input type="checkbox" id="cagree" style="margin-top:5px"><span>I have read and agree to the <span class="lnk" onclick="openPolicy('terms')">Terms &amp; Conditions</span>, <span class="lnk" onclick="openPolicy('delivery')">Shipping Policy</span> and <span class="lnk" onclick="openPolicy('returns')">Return Policy</span>.</span></label>
  <button class="btn dark" style="width:100%;margin-top:16px" onclick="placeOrder()">Place Order</button>`;
  stateBox();renderPay();sumUpdate();$('#cov').classList.add('on');
}
function renderPay(){
  const pays=DB.pay.filter(p=>p.on&&payOk(p));
  $('#payList').innerHTML=pays.length?pays.map(p=>`<div class="pay ${ck.pay===p.id?'on':''}" onclick="ck.pay='${p.id}';renderPay()"><input type="radio" ${ck.pay===p.id?'checked':''}><div><b>${esc(p.name)}</b></div>${p.logo?`<img class="plogo" src="${esc(p.logo)}" alt="">`:''}</div>`).join(''):'<p class="note">No payment methods are enabled.</p>';
  const p=DB.pay.find(x=>x.id===ck.pay);let ex='';
  if(p){
    ex=`<div class="note">${esc(p.info)}${p.num&&p.type==='upi'?`<br><b>${esc(p.num)}</b>`:''}${p.type==='razorpay'&&!DB.settings.rzp?'<br>We will send you a payment link after you place the order.':''}</div>`;
    const am=(cartSub()+shipCost()).toFixed(2);
    if(p.type==='link')ex+=/^https?:\/\//i.test(p.num||'')?`<a class="btn sm" style="display:inline-block;margin:8px 0" href="${esc(p.num)}" target="_blank" rel="noopener">Pay ₹${bn(am)} securely — ${esc(p.name)}</a><div class="note">After paying, come back here and enter the transaction / reference ID below.</div>`:'<div class="note">This payment method is not set up yet. Please choose another one.</div>';
    if(p.type==='upi'&&/@/.test(p.num||'')){ex+=`<a class="btn sm" style="display:inline-block;margin:8px 0" href="upi://pay?pa=${encodeURIComponent(p.num.trim())}&pn=${encodeURIComponent(DB.settings.name)}&am=${am}&cu=INR&tn=${encodeURIComponent('ZAVRA order')}">Pay ₹${bn(am)} with UPI app</a><div class="note">Tap the button to pay in PhonePe, Google Pay, Paytm or any UPI app. Then enter the UTR / transaction ID below.</div>`}
    if((ck.country||'India')!=='India')ex+='<div class="note">Prices are shown in Indian Rupees (₹). Your bank or card issuer will convert the amount to your local currency.</div>';
    if(p.type==='upi'||p.type==='link')ex+='<label>UTR / Transaction ID *</label><input id="ctx">';
  }
  $('#payExtra').innerHTML=ex;
}
function couponDisc(sub){const c=ck.coupon;if(!c)return 0;if(sub<(+c.min||0))return 0;let d=c.type==='flat'?+c.val:Math.round(sub*(+c.val)/100);if(c.max&&c.type!=='flat')d=Math.min(d,+c.max);return Math.max(0,Math.min(d,sub))}
function applyCoupon(){const code=($('#ccp').value||'').trim().toUpperCase(),m=$('#cpnMsg');if(!code){ck.coupon=null;m.textContent='';return sumUpdate()}
  const c=(DB.settings.coupons||[]).find(x=>x.on!==false&&String(x.code).toUpperCase()===code);
  if(!c){ck.coupon=null;m.style.color='#a33';m.textContent='This coupon code is not valid.';return sumUpdate()}
  if(cartSub()<(+c.min||0)){ck.coupon=null;m.style.color='#a33';m.textContent='Add items worth '+tk(c.min)+' or more to use this coupon.';return sumUpdate()}
  ck.coupon=c;m.style.color='#1e7a3c';m.textContent='Coupon applied ✓';sumUpdate()}
function sumUpdate(){const sub=cartSub(),sh=shipCost(),d=couponDisc(sub);$('#sum').innerHTML=`<div><span>Subtotal</span><span>${tk(sub)}</span></div>${d?`<div><span>Coupon (${esc(ck.coupon.code)})</span><span>− ${tk(d)}</span></div>`:''}<div><span>Delivery charge</span><span>${sh?tk(sh):'Free'}</span></div><div class="tt"><span>Total</span><span>${tk(sub-d+sh)}</span></div>`}
function placeOrder(){
  if(!USER)return openLogin(openCheckout);
  const inIN=(ck.country||'India')==='India';
  const name=$('#cn').value.trim(),ad=$('#ca').value.trim(),city0=$('#cc2').value.trim(),pin=$('#cpin').value.trim(),phone=($('#cph').value||'').replace(/\D/g,'').replace(inIN?/^91(?=\d{10}$)/:/^$/,'');
  const city=inIN?city0:city0+', '+ck.country;
  if(!name||!ad||!city0)return toast('Please enter your name, address and city');
  if(!inIN&&!ck.state)return toast('Please enter your state / province');
  if(inIN?!/^\d{6}$/.test(pin):!/^[A-Za-z0-9 -]{3,10}$/.test(pin))return toast(inIN?'Enter a valid 6-digit PIN code':'Enter a valid ZIP / postal code');
  if(inIN?!/^[6-9]\d{9}$/.test(phone):!/^\d{7,15}$/.test(phone))return toast(inIN?'Enter a valid 10-digit mobile number':'Enter a valid mobile number with country code');
  const p=DB.pay.find(x=>x.id===ck.pay);if(!p)return toast('Select a payment method');
  let trx='';if(p.type==='upi'||p.type==='link'){trx=($('#ctx').value||'').trim();if(!trx)return toast('Enter the UTR / transaction ID')}
  if(!$('#cagree').checked)return toast('Please accept the terms to continue');
  for(const c of cart){const pr=DB.products.find(x=>x.id===c.id);if(pr.stock<c.qty)return toast(pr.name+' — not enough stock')}
  const items=cart.map(c=>{const pr=DB.products.find(x=>x.id===c.id);return{id:pr.id,name:pr.name,size:c.size,qty:c.qty,price:pr.price}});
  const sub=cartSub(),sh=shipCost();
  const disc=couponDisc(cartSub());
  const o={id:'',uid:USER.uid,date:new Date().toISOString(),name,phone,country:ck.country||'India',alt:($('#calt').value||'').replace(/[^\d+]/g,''),email:$('#ce').value.trim(),address:ad,city,state:ck.state,pin,items,sub,disc,coupon:disc&&ck.coupon?ck.coupon.code:'',ship:sh,total:sub-disc+sh,pay:p.name,payType:p.type,trx,payStatus:p.type==='cod'?'COD':'Pending',status:'Pending',courier:'',tracking:'',stockCut:false,agreed:true};
  if(p.type==='razorpay'&&DB.settings.rzp){
    loadRzp(()=>{
      new Razorpay({key:DB.settings.rzp,amount:Math.round(o.total*100),currency:'INR',name:DB.settings.name,description:'Order',prefill:{name,contact:phone,email:o.email},theme:{color:'#2563eb'},
        handler:r=>{o.trx=r.razorpay_payment_id;commitOrder(o)},
        modal:{ondismiss:()=>toast('Payment was not completed. Please try again.')}}).open();
    });
  }else commitOrder(o);
}
function loadRzp(cb){
  if(window.Razorpay)return cb();
  const s=document.createElement('script');s.src='https://checkout.razorpay.com/v1/checkout.js';s.onload=cb;s.onerror=()=>toast('Could not load Razorpay. Check your internet connection.');document.head.appendChild(s);
}
async function nextOrderId(){
  try{
    if(FB_ON){const {doc,runTransaction}=FB.fs;const ref=doc(FB.db,'counters','orders');
      const n=await runTransaction(FB.db,async tx=>{const s=await tx.get(ref);const v=(s.exists()?+s.data().n:1000)+1;tx.set(ref,{n:v});return v});
      return String(n)}
    DB.orderSeq=Math.max(+DB.orderSeq||1000,...DB.orders.map(x=>+String(x.id).replace(/\D/g,'')||0).filter(v=>v<100000))+1;save();return String(DB.orderSeq);
  }catch(e){console.warn('order counter unavailable',e);const d=new Date();return String(d.getFullYear()).slice(2)+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0')+String(Math.floor(1000+Math.random()*9000))}
}
async function commitOrder(o){
  o.id=await nextOrderId();
  try{
    if(FB_ON)await FB.fs.setDoc(FB.fs.doc(FB.db,'orders',o.id),clone(o));
    else{DB.orders.unshift(o);save()}
  }catch(e){console.error(e);return toast('Could not place order ('+(e.code||'error')+')')}
  try{await saveProfile({name:o.name,phone:o.phone,alt:o.alt,email:o.email,address:o.address,city:o.city,state:o.state,pin:o.pin,country:ck.country})}catch(e){}
  cart=[];saveCart();renderStore();
  $('#checkout').innerHTML=`<div style="text-align:center;padding:20px 0"><div style="font-size:54px;color:var(--gold)">✦</div><h2>Thank you, ${esc(o.name)}!</h2><p>Your order has been received.</p><p style="margin:14px 0"><b style="font-size:22px">${o.id}</b><br><small>You can check its status anytime under "My Orders".</small></p><p>Total: <b>${tk(o.total)}</b> (${esc(o.pay)})</p>${o.payType!=='cod'?'<p style="font-size:13px;color:var(--mute);margin-top:8px">We will confirm your order once the payment is verified.</p>':''}<button class="btn" style="margin-top:18px" onclick="closeAll()">Continue Shopping</button></div>`;
}
const STL={Pending:'Pending',Confirmed:'Confirmed',Packing:'Packing',Shipped:'Shipped',OutForDelivery:'Out for delivery',Delivered:'Delivered',Cancelled:'Cancelled'};

/* ---------- Admin ---------- */
let atab='dash';
function isAuthed(){if(FB_ON)return ADMIN;try{return sessionStorage.getItem('zv_auth')==='1'}catch(e){return false}}
function route(){
  const h=location.hash,isA=h==='#admin',isS=h==='#seller';
  $('#store').style.display=(isA||isS)?'none':'block';$('#admin').style.display=isA?'block':'none';$('#seller').style.display=isS?'block':'none';
  if(isA){
    clearInterval(stimer);
    $('#aemWrap').style.display=FB_ON?'block':'none';
    if(!$('#aem').value)$('#aem').value=FB_ON?ADMIN_EMAIL:'';
    $('#lnote').innerHTML=FB_ON?'Sign in with the admin email and password created in Firebase.':'Demo mode — starting password: <b>admin123</b>.';
    const a=isAuthed();$('#loginBox').style.display=a?'none':'block';$('#adBody').style.display=a?'grid':'none';if(a)renderAdmin();
  }else if(isS){
    clearInterval(stimer);
    (async()=>{if(USER&&!SELLER)await refreshSeller();uiUser();renderSeller()})();
  }else{renderStore();renderSlider();reveal();const pm=/^#p(\d+)$/.exec(h);if(pm)setTimeout(()=>openProduct(+pm[1]),200);const pl=/^#(privacy|terms|delete-data)$/.exec(h);if(pl)setTimeout(()=>openPolicy(pl[1]==='terms'?'terms':'privacy'),250)}
  const fb=$('#waFab');if(fb)fb.style.display=(isA||isS)?'none':'flex';
  window.scrollTo(0,0);
}
async function login(){
  if(!FB_ON){if($('#apw').value===DB.settings.pw){try{sessionStorage.setItem('zv_auth','1')}catch(e){}route()}else toast('Incorrect password');return}
  try{await FB.au.signInWithEmailAndPassword(FB.auth,$('#aem').value.trim(),$('#apw').value);$('#apw').value=''}
  catch(e){toast('Login failed — check email and password')}
}
function logout(){if(FB_ON)FB.au.signOut(FB.auth);else{try{sessionStorage.removeItem('zv_auth')}catch(e){}$('#apw').value='';route()}}
const TABS=[['dash','📊 Dashboard'],['orders','📦 Orders'],['products','👗 Products'],['sellers','🏪 Sellers'],['cats','🗂 Categories'],['slides','🖼 Slider'],['cust','📣 Customers & Messages'],['offers','🎁 Offers & Coupons'],['accounts','🧾 GST & Settlements'],['pay','💳 Payments'],['delivery','🚚 Delivery'],['policy','📜 Policies'],['settings','⚙ Settings']];
function renderAdmin(){
  $('#side').innerHTML=TABS.map(([k,v])=>`<button class="${atab===k?'on':''}" onclick="atab='${k}';renderAdmin()">${v}</button>`).join('');
  ({dash:aDash,orders:aOrders,products:aProducts,sellers:aSellers,cats:aCats,slides:aSlides,cust:aCust,offers:aOffers,accounts:aAccounts,pay:aPay,delivery:aDelivery,policy:aPolicy,settings:aSettings})[atab]();
  if(['pay','delivery','policy','settings','offers','accounts'].includes(atab))$('#amain').insertAdjacentHTML('beforeend','<div class="savebar"><button class="btn" onclick="saveAll()">💾 Save changes</button></div>');
}
function saveAll(){try{document.activeElement&&document.activeElement.blur()}catch(e){}setTimeout(()=>{save();toast('Saved ✓')},120)}
let ofl={st:'all',pay:'all',id:''};
function goOrders(st,pay,id){ofl={st:st||'all',pay:pay||'all',id:id||''};atab='orders';renderAdmin();window.scrollTo(0,0)}
function addToCat(c){PRECAT=c;atab='products';renderAdmin();editProd(0);PRECAT=''}
function goTab(t){atab=t;renderAdmin();window.scrollTo(0,0)}
let cu={q:'',sel:'',oid:'',tpl:'order',cpn:'',txt:''};
function custList(){const m={};DB.orders.forEach(o=>{const k=String(o.phone||o.email||o.id);const c=m[k]=m[k]||{key:k,name:o.name,phone:o.phone,email:o.email,orders:[],spent:0,last:''};c.orders.push(o);if(o.status!=='Cancelled')c.spent+=+o.total||0;if(!c.email&&o.email)c.email=o.email;if(String(o.date)>c.last){c.last=String(o.date);c.name=o.name}});
  return Object.values(m).sort((a,b)=>b.last.localeCompare(a.last))}
function cuMsg(c){const n=DB.settings.name||'ZAVRA',first=String(c.name||'').split(' ')[0]||'there';
  if(cu.tpl==='order'){const o=c.orders.find(x=>x.id===cu.oid)||c.orders[0];return o?orderMsg(o):''}
  if(cu.tpl==='offer'){const cp=(DB.settings.coupons||[]).find(x=>x.code===cu.cpn);return `Hello ${first},\n\n✨ A special offer from ${n} just for you!`+(cp?`\nUse code *${cp.code}* at checkout to get ${cp.type==='flat'?'₹'+cp.val:cp.val+'%'} off`+(cp.min?` on orders above ${tk(cp.min)}`:'')+'.':'')+`\n\nShop now: ${location.origin+location.pathname}\n\n— Team ${n}`}
  return cu.txt||''}
function cuPick(k){cu.f=0;cu.sel=k;const c=custList().find(x=>x.key===k);cu.oid=c&&c.orders[0]?c.orders.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date)))[0].id:'';cu.txt='';aCust();setTimeout(()=>{const e=$('#cmp');e&&e.scrollIntoView({behavior:'smooth'})},50)}
function cuSend(how){const c=custList().find(x=>x.key===cu.sel);if(!c)return;const m=($('#cmpTxt')||{}).value||'';if(!m.trim())return toast('Message is empty');
  const ph=String(c.phone||'').replace(/\D/g,''),full=(ph.length===10?'91':'')+ph;
  if(how==='wa'){if(!ph)return toast('No phone number');window.open('https://wa.me/'+full+'?text='+encodeURIComponent(m),'_blank')}
  else if(how==='sms'){if(!ph)return toast('No phone number');window.location.href='sms:+'+full+'?&body='+encodeURIComponent(m)}
  else{if(!c.email)return toast('This customer has no email');window.location.href='mailto:'+encodeURIComponent(c.email)+'?subject='+encodeURIComponent((DB.settings.name||'ZAVRA')+(cu.tpl==='order'?' — Order update':' — Special offer'))+'&body='+encodeURIComponent(m)}}
function aCust(){
  const L=custList().filter(c=>!cu.q||(c.name+' '+c.phone+' '+c.email).toLowerCase().includes(cu.q.toLowerCase())),sel=custList().find(x=>x.key===cu.sel);
  let cmp='';
  if(sel){const os=sel.orders.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date)));
    if(cu.tpl==='order'&&!os.find(x=>x.id===cu.oid))cu.oid=os[0].id;
    const msg=cu.tpl==='custom'?(cu.txt):cuMsg(sel);
    cmp=`<div class="box" id="cmp"><h3>Message ${esc(sel.name)}</h3><p class="note" style="margin:0 0 10px">📞 ${esc(sel.phone||'—')} · ✉ ${esc(sel.email||'no email')} · ${bn(sel.orders.length)} order(s) · ${tk(sel.spent)} spent</p>
    <div class="row2"><div><label>Message type</label><select onchange="cu.tpl=this.value;cu.txt='';aCust()"><option value="order" ${cu.tpl==='order'?'selected':''}>Order update (auto-filled)</option><option value="offer" ${cu.tpl==='offer'?'selected':''}>Offer / coupon</option><option value="custom" ${cu.tpl==='custom'?'selected':''}>Write my own</option></select></div>
    <div>${cu.tpl==='order'?`<label>Which order</label><select onchange="cu.oid=this.value;aCust()">${os.map(o=>`<option value="${esc(o.id)}" ${o.id===cu.oid?'selected':''}>#${esc(o.id)} · ${tk(o.total)} · ${STL[o.status]||o.status}</option>`).join('')}</select>`:cu.tpl==='offer'?`<label>Coupon to include</label><select onchange="cu.cpn=this.value;aCust()"><option value="">— none —</option>${(DB.settings.coupons||[]).map(c=>`<option ${c.code===cu.cpn?'selected':''}>${esc(c.code)}</option>`).join('')}</select>`:''}</div></div>
    <label>Message (you can edit it)</label><textarea id="cmpTxt" rows="9" oninput="cu.txt=this.value;if(cu.tpl!=='custom'){cu.tpl='custom'}">${esc(msg)}</textarea>
    <div class="sv" style="flex-wrap:wrap"><button class="btn sm gold" onclick="cuSend('wa')">💬 WhatsApp</button><button class="btn sm gold" onclick="cuSend('mail')">✉ Email</button><button class="btn sm gold" onclick="cuSend('sms')">📱 SMS</button></div></div>`}
  $('#amain').innerHTML=`<h2>Customers &amp; Messages</h2><p class="note">Every customer who has placed an order appears here with their phone, email and orders. Choose a customer, check the message (order ID, products and amount are filled in automatically) and press Send.</p>${cmp}
  <input id="cuq" placeholder="Search by name, phone or email" value="${esc(cu.q)}" oninput="cu.q=this.value;cu.f=1;clearTimeout(cu.t);cu.t=setTimeout(aCust,300)" style="margin:6px 0 14px">
  ${L.length?L.map(c=>`<div class="rl"><span class="nm"><b>${esc(c.name)}</b><br><small style="color:var(--mute)">📞 ${esc(c.phone||'—')} · ✉ ${esc(c.email||'—')}</small></span><span class="am">${bn(c.orders.length)} order(s)<br><small>${tk(c.spent)}</small></span><button class="btn sm dark" onclick="cuPick('${esc(c.key)}')">Message</button></div>`).join(''):'<div class="box">No customers yet — they appear after their first order.</div>'}`;
  if(cu.f){const q=$('#cuq');if(q){q.focus();q.setSelectionRange(q.value.length,q.value.length)}}
}
function aOffers(){
  const L=DB.settings.coupons=DB.settings.coupons||[];
  $('#amain').innerHTML=`<h2>Offers &amp; Coupons</h2>
  <div class="box"><h3>Per-product discount</h3><p class="note">Open any product in <b>Products</b> and set <b>MRP</b> + <b>Discount %</b> (or an <b>Offer note</b> such as "Extra 5% cashback on UPI"). The store then shows the % OFF tag on cards and the product page.</p></div>
  <div class="box"><h3>⚡ Flash Sale (countdown on the home page)</h3><p class="note">Tick "Flash Sale" inside each product, then set the end time here. The row disappears automatically when the time is over.</p>
  <label class="sw"><input type="checkbox" ${(DB.settings.flash||{}).on?'checked':''} onchange="(DB.settings.flash=DB.settings.flash||{}).on=this.checked"> Flash Sale is ON</label>
  <div class="row2"><div><label>Title</label><input value="${esc((DB.settings.flash||{}).title||'Flash Sale')}" onchange="(DB.settings.flash=DB.settings.flash||{}).title=this.value"></div><div><label>Ends at</label><input type="datetime-local" value="${esc((DB.settings.flash||{}).end||'')}" onchange="(DB.settings.flash=DB.settings.flash||{}).end=this.value"></div></div>
  <div class="sv"><button class="btn sm gold" onclick="saveBox(this)">Save</button></div></div>
  <div class="box"><h3>Coupon codes (apply at checkout)</h3>
  ${L.length?`<table class="tb"><tr><th>Code</th><th>Discount</th><th>Min order</th><th>On</th><th></th></tr>${L.map((c,i)=>`<tr><td><b>${esc(c.code)}</b></td><td>${c.type==='flat'?'₹'+c.val:c.val+'%'+(c.max?' (max ₹'+c.max+')':'')}</td><td>₹${c.min||0}</td><td><input type="checkbox" ${c.on!==false?'checked':''} onchange="DB.settings.coupons[${i}].on=this.checked;save()"></td><td><button class="mini" onclick="delCoupon(${i})">Delete</button></td></tr>`).join('')}</table>`:'<p class="note">No coupons yet.</p>'}
  <h3 style="margin-top:18px">New coupon</h3>
  <div class="row2"><div><label>Code (e.g. WELCOME10)</label><input id="cpc"></div><div><label>Type</label><select id="cpt"><option value="pct">Percent %</option><option value="flat">Flat ₹</option></select></div></div>
  <div class="row2"><div><label>Value</label><input id="cpv" type="number"></div><div><label>Minimum order ₹ (optional)</label><input id="cpm" type="number"></div></div>
  <label>Max discount ₹ (optional, for % coupons)</label><input id="cpx" type="number">
  <div class="sv"><button class="btn sm gold" onclick="addCoupon()">Add coupon</button></div></div>`;
}
function addCoupon(){const code=($('#cpc').value||'').trim().toUpperCase().replace(/\s+/g,''),v=+$('#cpv').value;if(!code||!(v>0))return toast('Enter a code and a value');
  if($('#cpt').value==='pct'&&v>95)return toast('Percent must be 95 or less');
  const L=DB.settings.coupons=DB.settings.coupons||[];if(L.find(c=>c.code===code))return toast('This code already exists');
  L.push({code,type:$('#cpt').value,val:v,min:+$('#cpm').value||0,max:+$('#cpx').value||0,on:true});save();toast('Coupon added ✓');aOffers()}
function delCoupon(i){if(!confirm('Delete this coupon?'))return;DB.settings.coupons.splice(i,1);save();aOffers()}
let acc={from:'',to:''};
function accRows(){const f=acc.from?new Date(acc.from+'T00:00:00'):null,t=acc.to?new Date(acc.to+'T23:59:59'):null;
  return DB.orders.filter(o=>o.status!=='Cancelled'&&(!f||new Date(o.date)>=f)&&(!t||new Date(o.date)<=t))}
function aAccounts(){
  const s=DB.settings,r=+s.gstPct||0,L=accRows(),sum=f=>L.reduce((a,x)=>a+f(x),0);
  const gross=sum(x=>+x.total||0),gst=r?gross*r/(100+r):0,ship=sum(x=>+x.ship||0),disc=sum(x=>+x.disc||0);
  const online=sum(x=>x.payType!=='cod'&&x.payStatus==='Paid'?+x.total:0),pendOn=sum(x=>x.payType!=='cod'&&x.payStatus!=='Paid'?+x.total:0);
  const cod=sum(x=>x.payType==='cod'?+x.total:0),codDone=sum(x=>x.payType==='cod'&&x.status==='Delivered'?+x.total:0);
  const intl=sum(x=>(x.country||'India')!=='India'?+x.total:0);
  $('#amain').innerHTML=`<h2>GST &amp; Settlements</h2>
  <div class="box"><h3>Tax settings</h3><div class="row2"><div><label>GST rate % included in your prices</label><input type="number" value="${s.gstPct||''}" placeholder="e.g. 5" onchange="DB.settings.gstPct=+this.value||0;save()"></div><div><label>HSN code (optional)</label><input value="${esc(s.hsn||'')}" onchange="DB.settings.hsn=this.value.trim();save()"></div></div><p class="note">Prices on the store are GST-inclusive, so GST shown below is calculated backwards from the total. Please confirm the correct rate for each product with your accountant.</p></div>
  <div class="box"><h3>Report period</h3><div class="row2"><div><label>From</label><input type="date" value="${acc.from}" onchange="acc.from=this.value;aAccounts()"></div><div><label>To</label><input type="date" value="${acc.to}" onchange="acc.to=this.value;aAccounts()"></div></div></div>
  <div class="stats"><div class="stat"><div><small>Orders</small><b>${L.length}</b></div></div><div class="stat"><div><small>Gross sales</small><b>${tk(gross)}</b></div></div><div class="stat"><div><small>GST included${r?' ('+r+'%)':''}</small><b>${tk(Math.round(gst))}</b></div></div><div class="stat"><div><small>Net of GST</small><b>${tk(Math.round(gross-gst))}</b></div></div></div>
  <div class="box"><h3>By payment method</h3><table class="tb"><tr><th>Method</th><th>Orders</th><th>Total</th><th>Received</th></tr>${Object.entries(L.reduce((m,x)=>{const k=x.pay||'—';const r=m[k]=m[k]||{n:0,t:0,p:0};r.n++;r.t+=+x.total||0;if(x.payStatus==='Paid'||(x.payType==='cod'&&x.status==='Delivered'))r.p+=+x.total||0;return m},{})).map(([k,r])=>`<tr><td>${esc(k)}</td><td>${bn(r.n)}</td><td>${tk(r.t)}</td><td>${tk(r.p)}</td></tr>`).join('')||'<tr><td colspan="4">No orders in this period</td></tr>'}</table></div>
  <div class="box"><h3>Settlement summary</h3><table class="tb"><tr><td>Online payments received</td><td><b>${tk(online)}</b></td></tr><tr><td>Online payments awaiting confirmation</td><td>${tk(pendOn)}</td></tr><tr><td>Cash on Delivery orders (total)</td><td>${tk(cod)}</td></tr><tr><td>&nbsp;&nbsp;of which delivered (courier to remit)</td><td>${tk(codDone)}</td></tr><tr><td>Delivery charges collected</td><td>${tk(ship)}</td></tr><tr><td>Coupon discounts given</td><td>${tk(disc)}</td></tr><tr><td>International sales</td><td>${tk(intl)}</td></tr></table>
  <div class="sv"><button class="btn sm gold" onclick="exportAcc()">⬇ Download report (CSV)</button></div></div>`;
}
function exportAcc(){const r=+DB.settings.gstPct||0,q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const rows=[['order_id','date','customer','country','state','payment','pay_status','status','subtotal','discount','delivery','total','gst_included'].join(',')];
  accRows().forEach(x=>rows.push([x.id,String(x.date).slice(0,10),x.name,x.country||'India',x.state,x.pay,x.payStatus,x.status,x.sub,x.disc||0,x.ship,x.total,r?(x.total*r/(100+r)).toFixed(2):0].map(q).join(',')));
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([rows.join('\n')],{type:'text/csv'}));a.download='zavra-accounts.csv';a.click()}
function aDash(){
  const o=DB.orders,rev=o.filter(x=>x.status!=='Cancelled').reduce((a,x)=>a+x.total,0);
  const pend=DB.products.filter(p=>p.status==='pending').length,pendS=(DB.sellers||[]).filter(s=>!s.approved).length;
  $('#amain').innerHTML=`<h2>Dashboard</h2><div class="admin-hero"><h3>Welcome to ZAVRA Control Centre</h3><p>Manage products, categories, orders, sellers, promotions, payments and store content from one place.</p></div><div class="admin-tools"><div class="admin-tool"><b>🖼 Product imagery</b><small>Upload up to 6 optimized photos per product or use the sample catalogue imagery.</small></div><div class="admin-tool"><b>⭐ Ratings display</b><small>Set a verified rating and review count on each product from Products → Edit.</small></div><div class="admin-tool"><b>⚡ Flash Sale</b><small>Mark products for Flash Sale and set the end time in Offers &amp; Coupons.</small></div><div class="admin-tool"><b>📱 Mobile storefront</b><small>Responsive category browsing, product cards, cart and bottom navigation.</small></div></div>${FB_ON&&!DB.seeded?'<div class="note"><b>First time:</b> your database is empty. <button class="btn sm dark" onclick="seedFB()">Load demo data</button></div>':''}${pend?`<div class="note"><b>${bn(pend)}</b> seller product(s) waiting for approval — see the Products tab.</div>`:''}${pendS?`<div class="note"><b>${bn(pendS)}</b> seller account(s) waiting for approval — see the Sellers tab.</div>`:''}<div class="stats"><div class="stat" onclick="goOrders()"><span class="ic2">📦</span><div><small>Total orders</small><b>${bn(o.length)}</b></div></div><div class="stat" onclick="goOrders('Pending')"><span class="ic2">⏳</span><div><small>Pending</small><b>${bn(o.filter(x=>x.status==='Pending').length)}</b></div></div><div class="stat" onclick="goTab('accounts')"><span class="ic2">💰</span><div><small>Total sales</small><b>${tk(rev)}</b></div></div><div class="stat" onclick="goTab('products')"><span class="ic2">👗</span><div><small>Products</small><b>${bn(DB.products.length)}</b></div></div></div>
  <div class="box"><h3>Recent Orders</h3>${o.length?o.slice(0,6).map(x=>`<div class="rl" style="cursor:pointer" onclick="goOrders('all','all','${esc(x.id)}')"><span class="id">#${esc(x.id)}</span><span class="nm">${esc(x.name)}<br><small style="color:var(--mute)">${new Date(x.date).toLocaleDateString('en-IN')}</small></span><span class="am">${tk(x.total)}</span><span class="badge b-${x.status}">${STL[x.status]}</span></div>`).join(''):'<p style="color:var(--mute)">No orders yet.</p>'}</div>
  <p class="note">Low stock: ${DB.products.filter(p=>p.stock<=5).map(p=>esc(p.name)+' ('+bn(p.stock)+')').join(', ')||'none'}</p>${FB_ON&&DB.seeded?'<p style="margin-top:14px"><button class="mini" onclick="seedFB()">Reset store to demo data</button></p>':''}`;
}
function orderWarn(o){
  let bad=false;const s=o.items.reduce((a,i)=>a+i.price*i.qty,0);
  if(s!==o.sub||o.total!==o.sub+o.ship)bad=true;
  o.items.forEach(i=>{const p=DB.products.find(x=>x.id===i.id);if(p&&p.price!==i.price)bad=true});
  return bad?'<br><span class="warn">⚠ Price mismatch — please verify</span>':'';
}
function invoice(id){
  const x=DB.orders.find(o=>o.id===id);if(!x)return;const s=DB.settings;
  const w=window.open('','_blank');if(!w)return toast('Please allow pop-ups to see the invoice');
  const rows=x.items.map((i,n)=>`<tr><td>${n+1}</td><td>${esc(i.name)}${i.size?' ('+esc(i.size)+')':''}</td><td style="text-align:right">${i.qty}</td><td style="text-align:right">${tk(i.price)}</td><td style="text-align:right">${tk(i.price*i.qty)}</td></tr>`).join('');
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Invoice ${esc(x.id)}</title><style>body{font-family:Arial,sans-serif;max-width:760px;margin:20px auto;padding:0 16px;color:#111;font-size:14px}h1{letter-spacing:6px;margin:0}table{width:100%;border-collapse:collapse;margin:16px 0}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left}th{background:#f5f1e8}.r{text-align:right}.top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}button{padding:10px 18px;background:#111;color:#fff;border:0;margin-bottom:14px}@media print{button{display:none}}</style></head><body><button onclick="window.print()">Print / Save as PDF</button><div class="top"><div><h1>${esc(s.name)}</h1><div>${esc(s.legal||'')}<br>${esc(s.address||'')}${s.gstin?'<br>GSTIN: '+esc(s.gstin):''}<br>${esc(s.email||'')} · +${esc(s.wa||'')}</div></div><div style="text-align:right"><b>INVOICE</b><br>${esc(x.id)}<br>${new Date(x.date).toLocaleDateString('en-IN')}</div></div><p><b>Bill / Ship to</b><br>${esc(x.name)}<br>${esc(x.address)}<br>${esc(x.city)}, ${esc(x.state)} – ${esc(x.pin)}<br>Phone: ${String(x.phone).length===10?'+91 ':'+'}${esc(x.phone)}${x.email?'<br>'+esc(x.email):''}</p><table><tr><th>#</th><th>Item</th><th class="r">Qty</th><th class="r">Price</th><th class="r">Amount</th></tr>${rows}<tr><td colspan="4" class="r">Subtotal</td><td class="r">${tk(x.sub)}</td></tr>${x.disc?`<tr><td colspan="4" class="r">Coupon ${esc(x.coupon||'')}</td><td class="r">− ${tk(x.disc)}</td></tr>`:''}<tr><td colspan="4" class="r">Delivery</td><td class="r">${x.ship?tk(x.ship):'Free'}</td></tr><tr><td colspan="4" class="r"><b>Total</b></td><td class="r"><b>${tk(x.total)}</b></td></tr></table><p>Payment: ${esc(x.pay)} (${esc(x.payStatus)})${x.trx?' · Ref: '+esc(x.trx):''}${x.courier?'<br>Courier: '+esc(x.courier)+' · Tracking: '+esc(x.tracking):''}</p><p style="color:#777;font-size:12px">Thank you for shopping with ${esc(s.name)}. This is a computer-generated invoice.</p></body></html>`);
  w.document.close();
}
const hashS=s=>{let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return 'h'+(h>>>0).toString(36)+s.length};
const cldOn=()=>!!(DB.settings.cldName&&DB.settings.cldPreset);
async function cldUpload(dataUrl){
  const fd=new FormData();fd.append('file',dataUrl);fd.append('upload_preset',DB.settings.cldPreset);
  const r=await fetch('https://api.cloudinary.com/v1_1/'+encodeURIComponent(DB.settings.cldName)+'/image/upload',{method:'POST',body:fd});
  let j={};try{j=await r.json()}catch(e){}
  if(!r.ok||!j.secure_url)throw new Error((j.error&&j.error.message)||'Upload failed');
  return j.secure_url;
}
const prodImgs=p=>(p.imgs&&p.imgs.length?p.imgs:(p.img?[p.img]:[]));
async function cldSyncProd(p){
  if(!cldOn())return 0;let n=0;p.cmap=p.cmap||{};
  for(const im of prodImgs(p)){if(/^https?:\/\//.test(im))continue;const h=hashS(im);if(!p.cmap[h]){p.cmap[h]=await cldUpload(im);n++}}
  p.urls=prodUrls(p);
  return n;
}
const prodUrls=p=>prodImgs(p).map(im=>/^https?:\/\//.test(im)?im:(p.cmap&&p.cmap[hashS(im)])).filter(Boolean);
async function syncAllImages(){
  if(!cldOn())return toast('First add your Cloudinary name and preset in Settings');
  let n=0,f=0;toast('Uploading photos… please wait');
  for(const p of DB.products){try{const c=await cldSyncProd(p);if(c){n+=c;persistProduct(p)}}catch(e){console.error(e);f++}}
  toast(f?`${n} photo(s) uploaded, ${f} product(s) failed`:`${n} photo(s) uploaded ✓`);renderAdmin();
}
function exportCatalogCsv(){
  const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const base=location.origin+location.pathname;
  const H=['id','title','description','availability','condition','price','sale_price','link','image_link','additional_image_link','brand','product_type'];
  let miss=0;
  const rows=DB.products.filter(p=>p.status!=='pending').map(p=>{
    const u=prodUrls(p);if(!u.length)miss++;
    const sale=p.old&&p.old>p.price;
    return [p.id,p.name,(p.desc||p.name).replace(/\s+/g,' '),(+p.stock>0?'in stock':'out of stock'),'new',(sale?p.old:p.price).toFixed(2)+' INR',sale?p.price.toFixed(2)+' INR':'',base+'#p'+p.id,u[0]||'',u.slice(1,10).join(','),DB.settings.name||'ZAVRA',p.cat||''];
  });
  const csv='\ufeff'+[H].concat(rows).map(r=>r.map(q).join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='zavra-catalog.csv';document.body.appendChild(a);a.click();a.remove();
  toast(miss?`Downloaded. ${miss} product(s) have no photo link yet — tap "Upload photos to Cloudinary" first`:'Catalog downloaded ✓');
}
function exportOrdersCsv(){
  const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const H=['Order ID','Date','Customer name','Phone','Email','Address','City','State','PIN / ZIP','Product','Size','Quantity','Unit price','Order total','Payment method','Payment status','Courier','Tracking'];
  const rows=[];DB.orders.forEach(x=>x.items.forEach(i=>rows.push([x.id,new Date(x.date).toLocaleDateString('en-IN'),x.name,x.phone,x.email,x.address,x.city,x.state,x.pin,i.name,i.size||'',i.qty,i.price,x.total,x.pay,x.payStatus,x.courier||'',x.tracking||''])));
  const csv='\ufeff'+[H].concat(rows).map(r=>r.map(q).join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='zavra-orders.csv';document.body.appendChild(a);a.click();a.remove();
}
function aOrders(){
  const all=DB.orders.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date)));
  const pk=x=>x.payType==='cod'||x.payStatus==='COD'?'COD':(x.payStatus==='Paid'?'Paid':'Unpaid');
  const o=all.filter(x=>(ofl.st==='all'||x.status===ofl.st)&&(ofl.pay==='all'||pk(x)===ofl.pay)&&(!ofl.id||String(x.id)===ofl.id)),
  cnt=(f)=>all.filter(f).length,stp=['Pending','Confirmed','Packing','Shipped','OutForDelivery','Delivered'];
  const card=x=>{const ph=(String(x.phone).length===10?'+91 ':'+')+x.phone,k=Math.max(0,stp.indexOf(x.status)),pc=x.status==='Cancelled'?0:Math.round((k+1)/stp.length*100);
  return `<div class="oc"><div class="oc-h"><div><b>#${esc(x.id)}</b><br><small>${new Date(x.date).toLocaleString('en-IN')}</small></div><span class="badge b-${x.status}">${STL[x.status]||x.status}</span><span class="tot">${tk(x.total)}</span></div><div class="oc-p"><i style="width:${pc}%"></i></div>
  <div class="oc-g">
  <div class="oc-s"><h4>Customer &amp; address</h4><b>${esc(x.name)}</b><br>${esc(x.address)}<br>${esc(x.city)}, ${esc(x.state)} – ${esc(x.pin)}${x.country&&x.country!=='India'?'<br>'+esc(x.country):''}<div class="lx"><a class="cb" href="tel:${esc(String(x.phone))}">📞 ${esc(ph)}</a><a class="cb" target="_blank" rel="noopener" href="https://wa.me/${String(x.phone).length===10?'91':''}${esc(String(x.phone))}">💬 WhatsApp</a></div>${x.alt?`<small>Alt: ${esc(x.alt)}</small><br>`:''}${x.email?`<small>${esc(x.email)}</small>`:''}</div>
  <div class="oc-s"><h4>Items</h4>${x.items.map(i=>`<div class="it"><span>${esc(i.name)}${i.size?` (${esc(i.size)})`:''} ×${bn(i.qty)}</span><span>${tk(i.price*i.qty)}</span></div>`).join('')}<div class="it"><span>Delivery</span><span>${x.ship?tk(x.ship):'Free'}</span></div>${x.disc?`<div class="it"><span>Coupon ${esc(x.coupon||'')}</span><span>− ${tk(x.disc)}</span></div>`:''}<div class="it"><b>Total</b><b>${tk(x.total)}</b></div>${orderWarn(x)}</div>
  <div class="oc-s"><h4>Payment</h4>${esc(x.pay)}${x.trx?'<br><small>Ref: '+esc(x.trx)+'</small>':''}<select class="mini" onchange="setPay('${x.id}',this.value)">${[['Pending','Payment pending'],['Paid','Paid'],['COD','COD']].map(([v,l])=>`<option value="${v}" ${x.payStatus===v?'selected':''}>${l}</option>`).join('')}</select></div>
  <div class="oc-s"><h4>Delivery &amp; status</h4>${x.courier?`<b>${esc(x.courier)}</b><br><small>Tracking: ${esc(x.tracking)}</small> <button class="mini" onclick="editTrack('${x.id}')">✎</button>`:`<select class="mini" onchange="manualShip('${x.id}',this.value)"><option value="">— Choose courier —</option>${DB.delivery.couriers.filter(c=>c.on).map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}</select>`}${x.sr?`<br><small style="color:${x.sr.error?'#b3261e':'#1e7a3c'}">🚚 Shiprocket: ${x.sr.orderId?'#'+esc(x.sr.orderId):esc(x.sr.error||'sending…')}</small>`:''}
  <select class="mini" onchange="setStatus('${x.id}',this.value)">${Object.keys(STL).map(s=>`<option value="${s}" ${x.status===s?'selected':''}>${STL[s]}</option>`).join('')}</select><input class="mini" placeholder="Delivery estimate e.g. 28 Nov" value="${esc(x.eta||'')}" onchange="setEta('${x.id}',this.value)"><div class="lx"><button class="mini" onclick="invoice('${x.id}')">🧾 Invoice</button><button class="mini" onclick="notifyOrder('${x.id}','wa')">💬 WhatsApp update</button><button class="mini" onclick="notifyOrder('${x.id}','mail')">✉ Email update</button></div></div>
  </div></div>`};
  const chip=(g,v,l,n)=>`<button class="${ofl[g]===v?'on':''}" onclick="ofl.${g}='${v}';ofl.id='';aOrders()">${l}<b>${n}</b></button>`;
  $('#amain').innerHTML=`<h2>Orders</h2><div class="chips">${chip('st','all','All',all.length)}${['Pending','Confirmed','Packing','Shipped','OutForDelivery','Delivered','Cancelled'].map(k=>chip('st',k,STL[k],cnt(x=>x.status===k))).join('')}</div><div class="chips">${chip('pay','all','Any payment',all.length)}${chip('pay','Paid','Paid',cnt(x=>pk(x)==='Paid'))}${chip('pay','Unpaid','Payment pending',cnt(x=>pk(x)==='Unpaid'))}${chip('pay','COD','COD',cnt(x=>pk(x)==='COD'))}</div>${ofl.id?`<p class="note">Showing order #${esc(ofl.id)} <button class="mini" onclick="ofl.id='';aOrders()">Show all</button></p>`:''}${o.length?`<p style="margin-bottom:14px"><button class="btn sm dark" onclick="exportOrdersCsv()">⬇ Download orders (CSV) for courier upload</button></p>`:''}${o.length?o.map(card).join(''):'<div class="box">No orders in this filter.</div>'}<p class="note">Before marking an order "Paid", confirm the money has arrived (UPI/UTR or Razorpay dashboard).</p>`;
}
function orderMsg(x){const n=DB.settings.name||'ZAVRA',st={Pending:'received',Confirmed:'confirmed',Packing:'being packed',Shipped:'handed to our delivery partner',OutForDelivery:'out for delivery',Delivered:'delivered',Cancelled:'cancelled'}[x.status]||x.status;
  return `Hello ${x.name},\n\nThank you for shopping with ${n}! Your order #${x.id} is ${st}.\n\nItems:\n${x.items.map(i=>'• '+i.name+(i.size?' ('+i.size+')':'')+' ×'+i.qty).join('\n')}\n\nTotal: ${tk(x.total)} (${x.pay})\nDelivery to: ${x.address}, ${x.city}, ${x.state} - ${x.pin}`+(x.status!=='Delivered'&&x.status!=='Cancelled'?`\nExpected delivery: ${x.eta||DB.settings.eta||'5–7 business days'}`:'')+(x.courier?`\nCourier: ${x.courier} · Tracking ID: ${x.tracking}`:'')+`\n\nTrack your order anytime: ${location.origin+location.pathname}\n(Use "Track Order" with your order number ${x.id})\n\n— Team ${n}`}
function notifyOrder(id,how){const x=ordBy(id);if(!x)return;const m=orderMsg(x);
  if(how==='wa'){const ph=String(x.phone).replace(/\D/g,'');window.open('https://wa.me/'+(ph.length===10?'91':'')+ph+'?text='+encodeURIComponent(m),'_blank')}
  else{window.location.href='mailto:'+encodeURIComponent(x.email||'')+'?subject='+encodeURIComponent((DB.settings.name||'ZAVRA')+' — Order #'+x.id)+'&body='+encodeURIComponent(m)}}
const ordBy=id=>DB.orders.find(x=>x.id===id);
function editTrack(id){const o=ordBy(id);if(!o)return;const v=prompt('Enter the real tracking / AWB number from your courier',o.tracking||'');if(v===null)return;o.tracking=v.trim();persistOrder(o);renderAdmin();toast('Tracking ID saved ✓')}
function dispatch(o,cid){const c=DB.delivery.couriers.find(x=>x.id===cid);if(!c)return;o.courier=c.name;o.tracking=c.prefix+Math.random().toString(36).slice(2,10).toUpperCase()}
function cutStock(o){if(o.stockCut)return;o.items.forEach(it=>{const p=DB.products.find(x=>x.id===it.id);if(p){p.stock=Math.max(0,p.stock-it.qty);persistProduct(p)}});o.stockCut=true}
function restoreStock(o){if(!o.stockCut)return;o.items.forEach(it=>{const p=DB.products.find(x=>x.id===it.id);if(p){p.stock+=it.qty;persistProduct(p)}});o.stockCut=false}
function setStatus(id,s){
  const o=ordBy(id);if(!o)return;o.status=s;o.upd=new Date().toISOString();
  if(s==='Confirmed'&&DB.delivery.auto&&!o.courier){dispatch(o,DB.delivery.courier);o.status='Shipped';toast('Auto delivery: '+o.courier+' — '+o.tracking)}
  if(['Confirmed','Packing','Shipped','OutForDelivery','Delivered'].includes(o.status))cutStock(o);
  if(s==='Cancelled')restoreStock(o);
  persistOrder(o);renderAdmin();
}
function setPay(id,v){const o=ordBy(id);if(!o)return;o.payStatus=v;persistOrder(o)}
function setEta(id,v){const o=ordBy(id);if(!o)return;o.eta=String(v||'').trim();persistOrder(o);toast('Delivery estimate saved ✓')}
function manualShip(id,cid){const o=ordBy(id);if(!o||!cid)return;dispatch(o,cid);if(o.status==='Pending'||o.status==='Confirmed')o.status='Shipped';cutStock(o);persistOrder(o);renderAdmin()}

function catOptions(sel){return GORD.map(g=>`<optgroup label="${GROUPS[g].en}">${sortedCats().filter(c=>c.group===g).map(c=>`<option value="${esc(c.id)}" ${sel===c.id?'selected':''}>${esc(c.en)}</option>`).join('')}</optgroup>`).join('')}
function aProducts(){
  $('#amain').innerHTML=`<h2>Products</h2><div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px"><button class="btn sm dark" onclick="editProd(0)">+ New Product</button> <button class="btn sm" onclick="syncAllImages()">☁ Upload photos to Cloudinary</button> <button class="btn sm" onclick="exportCatalogCsv()">⬇ Export catalog (CSV)</button></div><div id="pf"></div>
  ${DB.products.map(p=>`<div class="pr" onclick="editProd(${p.id});setTimeout(()=>{const e=$('#pf');e&&e.scrollIntoView({behavior:'smooth'})},80)"><div class="th"><img loading="lazy" src="${esc(productPhoto(p))}" alt=""></div><div class="in"><b>${esc(p.name)}</b><small>${esc(catEn(p.cat))} · ${p.sellerName?esc(p.sellerName):'ZAVRA'}</small><div><b style="display:inline">${tk(p.price)}</b>${p.old>p.price?` <s><small>${tk(p.old)}</small></s> <span style="color:#1e7a3c;font-size:12px">${Math.round((1-p.price/p.old)*100)}% off</span>`:''}</div><small>Stock: <b style="display:inline;color:${p.stock<=5?'#a33':'inherit'}">${bn(p.stock)}</b>${p.status==='pending'?' · <span class="badge b-Pending">Awaiting approval</span>':''}</small></div><div class="bt" onclick="event.stopPropagation()">${p.status==='pending'?`<button class="mini" onclick="approveProd(${p.id})">Approve</button>`:''}<button class="mini" onclick="editProd(${p.id})">Edit</button><button class="mini" onclick="promoProd(${p.id})">Promote</button><button class="mini" onclick="delProd(${p.id})">Delete</button></div></div>`).join('')||'<div class="box">No products yet.</div>'}`;
}
const QS=['S','M','L','XL','XXL','3XL','Free Size','UK 3','UK 4','UK 5','UK 6','UK 7','UK 8','2-3Y','4-5Y','6-7Y','8-9Y'];
function qsz(s){const el=$('#fz');let a=el.value.split(',').map(x=>x.trim()).filter(Boolean);const i=a.indexOf(s);if(i>=0)a.splice(i,1);else a.push(s);el.value=a.join(',')}
const FORM_EXTRA=p=>`<p style="font-size:12px;color:var(--mute);margin-top:8px">Quick add sizes (tap to add / remove):</p><div class="ipv">${QS.map(s=>`<button type="button" class="mini" onclick="qsz('${s}')">${s}</button>`).join('')}</div><label>Fabric / quality (e.g. Pure cotton, Georgette)</label><input id="ffb" value="${esc(p.fabric||'')}"><div class="row2"><div><label>SKU</label><input id="fsku" value="${esc(p.sku||'')}"></div><div><label>Brand</label><input id="fbr" value="${esc(p.brand||'')}"></div></div><label>Available colours (comma separated)</label><input id="fcol" value="${esc(p.colors||'')}"><label class="sw" style="margin:8px 0"><input type="checkbox" id="ffl" ${p.flash?'checked':''}> Include in the Flash Sale row (set the timer in Offers &amp; Coupons)</label>`;
let pimgs=[],PRECAT='';
function ipvHtml(){return pimgs.map((d,i)=>`<div class="ith"><img src="${d}" alt=""><button type="button" onclick="rmImg(${i})">×</button>${i===0?'<em>Main photo</em>':`<u onclick="mainImg(${i})">Make main</u>`}</div>`).join('')+(pimgs.length?`<p style="font-size:12px;color:var(--mute);width:100%">${pimgs.length} / 6 photos</p>`:'')}
function ipvDraw(){const e=$('#ipv');if(e)e.innerHTML=ipvHtml()}
function rmImg(i){pimgs.splice(i,1);ipvDraw()}
function mainImg(i){const x=pimgs.splice(i,1)[0];pimgs.unshift(x);ipvDraw()}
function editProd(id){
  const first=sortedCats()[0];
  const p=id?DB.products.find(x=>x.id===id):{name:'',cat:PRECAT||(first?first.id:''),price:'',old:'',desc:'',sizes:'',stock:10,tag:'',img:''};
  pimgs=(p.imgs&&p.imgs.length)?p.imgs.slice():(p.img?[p.img]:[]);
  $('#pf').innerHTML=`<div class="box" style="margin-top:14px"><h3>${id?'Edit Product':'New Product'}</h3>
  <label>Name</label><input id="fn" value="${esc(p.name)}">
  <div class="row2"><div><label>Category</label><select id="fc">${catOptions(p.cat)}</select></div><div><label>Tag (e.g. New)</label><input id="ft" value="${esc(p.tag)}"></div></div>
  <div class="row2"><div><label>Price (₹)</label><input id="fp" type="number" value="${p.price}" oninput="syncDisc()"></div><div><label>Old price / MRP (₹, optional)</label><input id="fo" type="number" value="${p.old||''}" oninput="syncDisc()"></div></div>
  <div class="row2"><div><label>Discount % (fills price from MRP)</label><input id="fdc" type="number" min="0" max="95" value="${p.old>p.price?Math.round((1-p.price/p.old)*100):''}" oninput="applyDisc()"></div><div><label>Offer note (e.g. Extra 5% cashback on UPI)</label><input id="fof" value="${esc(p.offer||'')}"></div></div>
  <label class="sw" style="margin:6px 0"><input type="checkbox" id="fft" ${p.feat?'checked':''}> Show in the sliding "Trending Now" row on the home page</label>
  <div class="row2"><div><label>Stock</label><input id="fs" type="number" value="${p.stock}"></div><div><label>Sizes (comma separated: S,M,L or 2-3Y,4-5Y)</label><input id="fz" value="${esc(p.sizes)}"></div></div><div class="row2"><div><label>Star rating (optional, 0–5)</label><input id="frating" class="rating-input" type="number" min="0" max="5" step="0.1" value="${p.rating||''}"></div><div><label>Review count</label><input id="freviews" type="number" min="0" value="${p.reviewCount||0}"></div></div>
  ${FORM_EXTRA(p)}
  <label>Description</label><textarea id="fd" rows="2">${esc(p.desc)}</textarea>
  <label>Product photos (up to 6 — front, back, sides, details)</label><input type="file" accept="image/*" multiple onchange="upImg(this)"><div id="ipv" class="ipv">${ipvHtml()}</div>
  <div style="margin-top:14px"><button class="btn sm dark" onclick="saveProd(${id})">Save</button> <button class="mini" onclick="$('#pf').innerHTML=''">Cancel</button></div></div>`;
  $('#pf').scrollIntoView({behavior:'smooth'});
}
function upImg(inp){
  if(!inp.files.length)return;
  const fs=[...inp.files].slice(0,6-pimgs.length);
  if(!fs.length){toast('Maximum 6 photos per product');inp.value='';return}
  let n=0;fs.forEach(f=>resizeImg(f,800,.68,d=>{pimgs.push(d);if(++n===fs.length){ipvDraw();inp.value=''}}));
}
function applyDisc(){const o=+$('#fo').value,d=+$('#fdc').value;if(o>0&&d>0&&d<100)$('#fp').value=Math.round(o*(100-d)/100)}
function syncDisc(){const o=+$('#fo').value,p=+$('#fp').value,b=$('#fdc');if(b)b.value=(o>0&&p>0&&o>p)?Math.round((1-p/o)*100):''}
async function saveProd(id){
  const d={name:$('#fn').value.trim(),cat:$('#fc').value,tag:$('#ft').value.trim(),price:+$('#fp').value,old:+$('#fo').value||0,offer:($('#fof')?$('#fof').value.trim():''),stock:+$('#fs').value||0,sizes:$('#fz').value.trim(),desc:$('#fd').value.trim(),fabric:$('#ffb').value.trim(),sku:$('#fsku').value.trim(),brand:$('#fbr').value.trim(),colors:$('#fcol').value.trim(),flash:$('#ffl').checked,rating:Math.max(0,Math.min(5,+($('#frating')?.value||0))),reviewCount:Math.max(0,+($('#freviews')?.value||0)),img:pimgs[0]||'',imgs:pimgs.slice()};if($('#fft'))d.feat=$('#fft').checked;
  if(!d.name||!d.price)return toast('Enter a name and price');
  if(pimgs.join('').length>850000)return toast('Photos are too large in total — remove one or use smaller photos');
  let p;if(id){p=DB.products.find(x=>x.id===id);Object.assign(p,d)}else{p={id:Date.now()%1e9,ord:Date.now(),...d};DB.products.push(p)}
  try{await cldSyncProd(p)}catch(e){console.error(e);toast('Saved, but the photo upload to Cloudinary failed: '+(e.message||e))}
  persistProduct(p);toast('Saved');renderAdmin();
}
function delProd(id){if(confirm('Delete this product?')){DB.products=DB.products.filter(x=>x.id!==id);removeProduct(id);renderAdmin()}}

function cset(id,k,v){const c=catOf(id);if(!c)return;c[k]=v;persistCat(c)}
function aCats(){
  $('#amain').innerHTML=`<h2>Categories</h2><p class="note">Change each category's name, group (Women/Kids) and image here. An image appears on the homepage category tile (tall/portrait images look best).</p>
  ${sortedCats().map(c=>`<div class="box"><div style="display:flex;justify-content:space-between"><h3>${esc(c.en)}</h3><button class="mini" onclick="delCat('${esc(c.id)}')">Delete</button></div>
  <div class="catlink"><b>${DB.products.filter(p=>p.cat===c.id).length} product(s) in this list</b> <button class="btn sm dark" onclick="addToCat('${esc(c.id)}')">+ Add product to ${esc(c.en)}</button>${DB.products.filter(p=>p.cat===c.id).map(p=>`<span class="chip sm" onclick="atab='products';renderAdmin();editProd(${p.id})">${esc(p.name)} ✎</span>`).join('')}</div>
  <div class="row2"><div><label>Name</label><input value="${esc(c.en)}" onchange="cset('${esc(c.id)}','en',this.value)"></div><div><label>Group</label><select onchange="cset('${esc(c.id)}','group',this.value)"><option value="men" ${c.group==='men'?'selected':''}>Men</option><option value="women" ${c.group==='women'?'selected':''}>Women</option><option value="kids" ${c.group==='kids'?'selected':''}>Kids</option><option value="home" ${c.group==='home'?'selected':''}>Kitchen &amp; Home</option></select></div></div>
  <div class="row2"><div><label>Icon (emoji, used when no image)</label><input value="${esc(c.emoji)}" onchange="cset('${esc(c.id)}','emoji',this.value)"></div><div></div></div>
  <label>Upload image</label><input type="file" accept="image/*" onchange="upCat('${esc(c.id)}',this)">${c.img?`<div style="margin-top:8px"><img src="${esc(c.img)}" style="height:90px"> <button class="mini" onclick="cset('${esc(c.id)}','img','');renderAdmin()">Remove image</button></div>`:''}</div>`).join('')}
  <button class="btn sm dark" onclick="const n={id:'c'+Date.now().toString(36),en:'New Category',group:'women',emoji:'✦',img:'',ord:Date.now()};DB.categories.push(n);persistCat(n);renderAdmin()">+ New Category</button> <button class="btn sm" onclick="addDefaultCats()">Add all default categories</button> <button class="btn sm" onclick="DB.categories.forEach(persistCat);toast('Category catalogue saved');renderAdmin()">Save category catalogue</button>`;
}
function upPayLogo(i,inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{const im=new Image();im.onload=()=>{const s=Math.min(1,220/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);g.drawImage(im,0,0,c.width,c.height);DB.pay[i].logo=c.toDataURL('image/jpeg',.85);save();renderAdmin();toast('Logo saved ✓')};im.src=e.target.result};r.readAsDataURL(f)}
function upLoginLogo(k,inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{const im=new Image();im.onload=()=>{const sc=Math.min(1,96/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);c.getContext('2d').drawImage(im,0,0,c.width,c.height);DB.settings[k]=c.toDataURL('image/png');save();renderAdmin();toast('Logo saved ✓')};im.src=e.target.result};r.readAsDataURL(f)}
function upCat(id,inp){const f=inp.files[0];if(!f)return;resizeImg(f,700,.72,d=>{cset(id,'img',d);renderAdmin()})}
function delCat(id){
  const n=DB.products.filter(p=>p.cat===id).length;
  if(!confirm(n?`This category has ${bn(n)} product(s). Delete it anyway? (The products stay, but the category is removed.)`:'Delete this category?'))return;
  DB.categories=DB.categories.filter(c=>c.id!==id);removeCat(id);renderAdmin();
}

function sl(i,k,v){DB.slides[i][k]=v;persistSlide(DB.slides[i])}
function aSlides(){
  $('#amain').innerHTML=`<h2>Homepage Slider</h2><p class="note">Upload a beautiful model/product photo for each slide (wide images work best, e.g. 1600×700). Sample editorial photos are used automatically when no upload exists. A true in-panel AI image generator requires a secured server/API key; never paste a private AI API key into this public HTML file.</p>
  ${DB.slides.map((s,i)=>`<div class="box"><div style="display:flex;justify-content:space-between"><h3>Slide ${bn(i+1)}</h3><button class="mini" onclick="if(confirm('Delete this slide?')){removeSlide(DB.slides[${i}].id);DB.slides.splice(${i},1);renderAdmin()}">Delete</button></div>
  <div class="row2"><div><label>Small text (top)</label><input value="${esc(s.kick)}" onchange="sl(${i},'kick',this.value)"></div><div><label>Button text</label><input value="${esc(s.btn)}" onchange="sl(${i},'btn',this.value)"></div></div>
  <label>Headline</label><input value="${esc(s.title)}" onchange="sl(${i},'title',this.value)">
  <label>Description</label><input value="${esc(s.sub)}" onchange="sl(${i},'sub',this.value)">
  <div class="row2"><div><label>Button links to category</label><select onchange="sl(${i},'cat',this.value)"><option value="all" ${s.cat==='all'?'selected':''}>All</option>${catOptions(s.cat)}</select></div><div><label>Background colour (when no image)</label><select onchange="sl(${i},'bg',this.value)">${Object.entries(BGN).map(([k,v])=>`<option value="${k}" ${s.bg===k?'selected':''}>${v}</option>`).join('')}</select></div></div>
  <label>Upload image</label><input type="file" accept="image/*" onchange="upSlide(${i},this)">${s.img?`<div style="margin-top:8px"><img src="${esc(s.img)}" style="height:80px"> <button class="mini" onclick="sl(${i},'img','');renderAdmin()">Remove image</button></div>`:''}</div>`).join('')}
  <button class="btn sm dark" onclick="const n={id:'s'+Date.now(),ord:Date.now(),title:'New Slide',sub:'Write a description here',kick:'New',cat:'all',emoji:'✨',bg:'wine',btn:'Shop Now',img:''};DB.slides.push(n);persistSlide(n);renderAdmin()">+ New Slide</button>`;
}
function upSlide(i,inp){const f=inp.files[0];if(!f)return;resizeImg(f,1400,.7,d=>{sl(i,'img',d);renderAdmin()})}

function addDefaultCats(){let n=0;DEF.categories.forEach(d=>{if(!DB.categories.find(x=>x.id===d.id)){const c=clone(d);c.ord=Date.now()+n;DB.categories.push(c);persistCat(c);n++}});toast(n?n+' categories added':'All default categories already exist');renderAdmin()}
const PAYHELP={
razorpay:'<ol><li>Log in at razorpay.com → <b>Settings → API Keys</b> → Generate Key.</li><li>Copy only the <b>Key ID</b> (starts with rzp_live_ or rzp_test_). Never paste the Key Secret anywhere on this site.</li><li>Scroll to the bottom of this page, paste it into the <b>Razorpay</b> box and press Save. The Razorpay payment window will now open at checkout.</li><li>For customers outside India: in Razorpay → <b>Settings → International Payments</b> request activation (Razorpay must approve it).</li><li>After each order, confirm the payment in your Razorpay dashboard before marking it Paid.</li></ol>',
paypal:'<ol><li>Log in at paypal.com (Business account) and open <b>PayPal.Me</b> → create your link, e.g. https://paypal.me/yourname</li><li>Paste that link in the box above ("Payment link").</li><li>Switch <b>Enabled</b> on and press Save.</li></ol><p>Customers tap "Pay securely", pay on PayPal and then type the PayPal transaction ID here. Check it in your PayPal account.</p>',
stripe:'<ol><li>Log in at dashboard.stripe.com → <b>Payment Links → Create</b>.</li><li>Create a link (customer can enter the amount, or use a fixed product), copy it.</li><li>Paste it in the payment-link box above, enable and Save.</li></ol><p>Stripe supports cards, Apple Pay and Google Pay in many countries. Your Stripe account must be activated for your country first.</p>',
cashfree:'<ol><li>Log in to the Cashfree dashboard → Payment Links / Payment Forms → create one.</li><li>Paste the link above, enable and Save.</li></ol>',
paytmbiz:'<ol><li>Paytm for Business app/dashboard → Payment Links → create one.</li><li>Paste the link above, enable and Save.</li></ol>',
phonepe:'<ol><li>Enter your UPI ID (like name@ybl) in the box above. A phone number alone shows only the number.</li><li>Enable and Save.</li></ol>'};
function payHelp(p){
  if(PAYHELP[p.id])return PAYHELP[p.id];
  if(p.type==='upi')return '<ol><li>Enter your UPI ID (for example name@okaxis) in the box above. The customer then gets a "Pay with UPI app" button.</li><li>Enable and Save.</li></ol>';
  if(p.type==='cod')return '<p>No setup needed. Switch Enabled on to allow Cash on Delivery in India.</p>';
  return '<ol><li>Create a free business account with this provider and open their dashboard.</li><li>Find <b>Payment Links</b> (or Payment Page / Invoice) and create a link for your shop.</li><li>Copy that link and paste it in the "Payment link" box above.</li><li>Switch Enabled on, then press <b>Save changes</b>.</li></ol><p>Customers pay on the provider\'s secure page and then enter the transaction ID here. Verify every payment in the provider\'s dashboard before confirming the order. The provider must support your country and the customer\'s country.</p>';
}
function addDefaultPays(){let n=0,f=0;const bn=/[\u0980-\u09FF]/;DEF.pay.forEach(d=>{const x=DB.pay.find(y=>y.id===d.id);if(!x){DB.pay.push(clone(d));n++}else if(bn.test(x.name+x.info)){x.name=d.name;x.info=d.info;f++}});save();toast((n?n+' payment methods added. ':'')+(f?f+' names changed to English. ':'')+(n||f?'Switch on the ones you use and press Save.':'All payment methods are already added'));renderAdmin()}
function brandAdmin(){
  const B=DB.brands||(DB.brands=clone(DEF.brands));
  const grp=[['gw','Payment Gateways'],['intl','International Payment Methods'],['in','Indian Payment Methods']];
  return `<div class="box" style="margin-top:18px"><h3>Payment logos on the "International Shopping & Payments" page</h3><p class="note">Upload each brand's official logo (download it from the company's brand/press page). Optionally paste a link (for example your PayPal.me or gateway link) — customers can tap the logo to open it. Press <b>Save changes</b> at the bottom when done.</p>${grp.map(([g,gt])=>`<h4 style="margin:14px 0 6px">${gt}</h4>${B.map((b,i)=>b.group!==g?'':`<div style="border-top:1px solid var(--line);padding:10px 0"><label class="sw" style="margin:0 0 6px"><input type="checkbox" ${b.hide?'':'checked'} onchange="DB.brands[${i}].hide=!this.checked"> Show in website footer</label><div style="display:flex;gap:10px;align-items:center;margin-bottom:6px">${b.logo?`<img src="${esc(b.logo)}" style="height:30px;background:#fff;border:1px solid var(--line);padding:2px">`:'<span class="note" style="margin:0;padding:6px 10px">No logo</span>'}<input value="${esc(b.name)}" onchange="DB.brands[${i}].name=this.value" style="flex:1"><button class="mini" onclick="DB.brands.splice(${i},1);save();renderAdmin()">Delete</button></div><div class="row2"><div><label>Logo</label><input type="file" accept="image/*" onchange="upBrandLogo(${i},this)"></div><div><label>Link (optional)</label><input value="${esc(b.url||'')}" placeholder="https://…" onchange="DB.brands[${i}].url=this.value.trim()"></div></div></div>`).join('')}<button class="btn sm" onclick="DB.brands.push({id:'b'+Date.now(),name:'New method',group:'${g}',logo:'',url:''});save();renderAdmin()">+ Add to this list</button>`).join('')}</div>`;
}
function upBrandLogo(i,inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{const im=new Image();im.onload=()=>{const s=Math.min(1,200/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);g.drawImage(im,0,0,c.width,c.height);DB.brands[i].logo=c.toDataURL('image/jpeg',.82);save();renderAdmin();toast('Logo saved ✓')};im.src=e.target.result};r.readAsDataURL(f)}
function aPay(){
  $('#amain').innerHTML=`<h2>Payment Methods</h2><p class="note">Customers see only the methods you switch on. <b>Payment-link methods</b> (Paytm Business, PhonePe Business, Razorpay, Cashfree, PayU, Instamojo, Amazon Pay, Card): create a payment link or payment page in that company's business dashboard, paste the link here and switch the method on. Customers tap "Pay securely", pay on the company's page, then enter the transaction ID here for you to verify. For UPI methods, enter your UPI ID (for example name@okaxis) to show customers a "Pay with UPI app" button that opens PhonePe, Google Pay or Paytm with the amount filled in. A plain phone number only shows the number.</p>${DB.pay.map((p,i)=>`<div class="box"><div style="display:flex;justify-content:space-between;align-items:center"><h3>${esc(p.name)}</h3><label class="sw" style="margin:0"><input type="checkbox" ${p.on?'checked':''} onchange="DB.pay[${i}].on=this.checked;save()"> Enabled</label></div><div class="row2"><div><label>Name</label><input value="${esc(p.name)}" onchange="DB.pay[${i}].name=this.value;save()"></div><div><label>${p.type==='upi'?'UPI ID / number / account':p.type==='link'?'Payment link (https://…)':'—'}</label><input value="${esc(p.num)}" ${p.type==='upi'||p.type==='link'?'':'disabled'} onchange="DB.pay[${i}].num=this.value;save()"></div></div><label>Instructions for customer</label><input value="${esc(p.info)}" onchange="DB.pay[${i}].info=this.value;save()"><details class="howto"><summary>How to connect this method</summary>${payHelp(p)}</details><label>Logo (shown in footer and checkout)</label><div style="display:flex;gap:12px;align-items:center">${p.logo?`<img src="${esc(p.logo)}" style="height:34px;background:#fff;border:1px solid var(--line);padding:3px">`:'<span class="note" style="margin:0">No logo yet</span>'}<input type="file" accept="image/*" onchange="upPayLogo(${i},this)">${p.logo?`<button class="mini" onclick="DB.pay[${i}].logo='';save();renderAdmin()">Remove</button>`:''}</div><label>Available for</label><select onchange="DB.pay[${i}].scope=this.value;save()"><option value="in" ${payScope(p)==='in'?'selected':''}>India only</option><option value="intl" ${payScope(p)==='intl'?'selected':''}>International only</option><option value="all" ${payScope(p)==='all'?'selected':''}>Everywhere</option></select>${p.id.startsWith('x')||p.type==='link'?`<button class="mini" style="margin-top:10px" onclick="DB.pay.splice(${i},1);save();renderAdmin()">Remove method</button>`:''}</div>`).join('')}
  <button class="btn sm dark" onclick="DB.pay.push({id:'x'+Date.now(),name:'New UPI Method',on:false,type:'upi',info:'Send the amount to the UPI ID below, then enter the UTR / transaction ID.',num:''});save();renderAdmin()">+ New UPI method</button> <button class="btn sm dark" onclick="DB.pay.push({id:'l'+Date.now(),name:'New Payment Link',on:false,type:'link',info:'Pay securely online using the button below. After paying, enter the transaction / reference ID.',num:''});save();renderAdmin()">+ New payment-link method</button> <button class="btn sm" onclick="addDefaultPays()">Add all default methods (India + International: PayPal, Stripe, Cards, Gulf, Malaysia, Europe, UK, USA…)</button>
  ${brandAdmin()}<div class="box" style="margin-top:18px"><h3>Razorpay (Cards, Net Banking, UPI)</h3><label>Razorpay Key ID (rzp_live_... or rzp_test_...)</label><input value="${esc(DB.settings.rzp)}" placeholder="rzp_test_XXXXXXXX" onchange="DB.settings.rzp=this.value.trim();save()"><p class="note">Once a Key is entered, the Razorpay payment window opens at checkout. Test first with an rzp_test key. Before marking an order "Paid", confirm the payment in your Razorpay dashboard.</p></div>`;
}
const COURIER_SITES={shiprocket:'https://www.shiprocket.in',nimbuspost:'https://nimbuspost.com',indiapost:'https://www.indiapost.gov.in',speedpost:'https://www.indiapost.gov.in',delhivery:'https://www.delhivery.com',bluedart:'https://www.bluedart.com',dtdc:'https://www.dtdc.in',dtdcplus:'https://www.dtdc.in',ecom:'https://www.ecomexpress.in',xpressbees:'https://www.xpressbees.com',shadowfax:'https://www.shadowfax.in',ekart:'https://ekartlogistics.com',dhl:'https://www.dhl.com',fedex:'https://www.fedex.com',ups:'https://www.ups.com',aramex:'https://www.aramex.com',pickrr:'https://www.pickrr.com',ithink:'https://www.ithinklogistics.com'};
const COURIER_API={shiprocket:'Automatic sending is ready (server setup needed once).',nimbuspost:'Has an API. Automatic sending will be added once its API details are checked.',indiapost:'API only for approved bulk customers. Use manual booking or book through Shiprocket / NimbusPost.',speedpost:'API only for approved bulk customers. Use manual booking.'};
const MORE_COURIERS=[['nimbuspost','NimbusPost','NP'],['xpressbees','Xpressbees','XB'],['shadowfax','Shadowfax','SF'],['ekart','Ekart','EK'],['amazonship','Amazon Shipping','AZ'],['dtdcplus','DTDC Plus','DP'],['gati','Gati','GT'],['professional','Professional Couriers','PC'],['smartr','Smartr (Rapidshyp)','SM'],['pickrr','Pickrr','PK'],['shipway','Shipway','SW'],['ithink','iThink Logistics','IT'],['dhl','DHL Express (International)','DH'],['fedex','FedEx (International)','FX'],['ups','UPS (International)','UP'],['aramex','Aramex (International)','AR'],['speedpost','India Post Speed Post (International)','SP']];
function addDefaultCouriers(){let n=0;MORE_COURIERS.forEach(([id,name,prefix])=>{if(!DB.delivery.couriers.find(c=>c.id===id)){DB.delivery.couriers.push({id,name,prefix,on:false});n++}});save();toast(n?n+' delivery partners added — switch on the ones you use, then Save':'All partners are already added');renderAdmin()}
function aDelivery(){
  const d=DB.delivery;
  $('#amain').innerHTML=`<h2>Delivery</h2>
  <div class="box"><h3>International shipping rates by country</h3><p class="note">One line per country: <b>Country = charge in ₹</b> (e.g. United States = 3200). Countries not listed use the general international charge below.</p><textarea rows="6" placeholder="United States = 3200&#10;United Arab Emirates = 1800&#10;United Kingdom = 2900" onchange="DB.delivery.intlTxt=this.value;save()">${esc(d.intlTxt||'')}</textarea></div>
  <div class="box"><h3>Auto Delivery</h3><label class="sw"><input type="checkbox" ${d.auto?'checked':''} onchange="DB.delivery.auto=this.checked;save()"> Enabled — when you set an order to "Confirmed", a courier is assigned and a tracking ID is generated automatically</label>
  <label>Default courier</label><select onchange="DB.delivery.courier=this.value;save()">${d.couriers.map(c=>`<option value="${c.id}" ${d.courier===c.id?'selected':''}>${c.name}</option>`).join('')}</select></div>
  <div class="box"><h3>Automatic order sending</h3><p class="note">Choose where confirmed orders are sent automatically. This works only after the server is set up (see SHIPROCKET-SETUP guide). Passwords and API keys are never entered here.</p><label>Send confirmed orders to</label><select onchange="DB.delivery.autoPartner=this.value;save();toast('Saved ✓')">${[['','Nowhere — I will ship manually'],['shiprocket','Shiprocket (courier chosen by your Shiprocket rules)']].map(([v,l])=>`<option value="${v}" ${(d.autoPartner||'')===v?'selected':''}>${l}</option>`).join('')}</select><p class="note" style="margin-top:8px">NimbusPost and India Post cannot be switched on yet: NimbusPost needs its API details checked first, and India Post offers API access only to approved bulk customers.</p></div>
<div class="box"><h3>Courier List</h3>${d.couriers.map((c,i)=>`<div style="border-top:1px solid var(--line);padding:10px 0"><label class="sw" style="margin:0"><input type="checkbox" ${c.on?'checked':''} onchange="DB.delivery.couriers[${i}].on=this.checked;save()"> <b>${esc(c.name)}</b></label><details class="howto"><summary>Connect / links</summary>${COURIER_SITES[c.id]?`<a class="btn sm" style="display:inline-block;margin:6px 0" href="${COURIER_SITES[c.id]}" target="_blank" rel="noopener">🌐 Official website / sign up →</a>`:''}<p class="note" style="margin:6px 0">${COURIER_API[c.id]||'No automatic connection yet. Ship from this partner\'s own dashboard or app, then add the tracking number with ✎ Tracking ID in Orders.'} After you sign up, look in their dashboard under <b>Settings → API</b> for API details.</p><label>Partner dashboard / app link (your login page)</label><input value="${esc(c.url||'')}" placeholder="https://…" onchange="DB.delivery.couriers[${i}].url=this.value.trim();save()">${/^https?:\/\//.test(c.url||'')?`<a class="btn sm" style="display:inline-block;margin:8px 0" href="${esc(c.url)}" target="_blank" rel="noopener">Open ${esc(c.name)} →</a>`:''}<label>Customer tracking link (use {id} where the tracking number goes)</label><input value="${esc(c.track||'')}" placeholder="https://www.example.com/track?awb={id}" onchange="DB.delivery.couriers[${i}].track=this.value.trim();save()"><p class="note" style="margin:8px 0 0">Never paste API keys or passwords here — everything on this page is stored in a database that the public website can read.</p></details></div>`).join('')}<button class="btn sm" style="margin-top:10px" onclick="addDefaultCouriers()">+ Add more delivery partners (Xpressbees, Shadowfax, Ekart, DHL, FedEx…)</button></div>
  <div class="box"><h3>Delivery Charges</h3><label>Your home state</label><select onchange="DB.delivery.home=this.value;save()">${STATES.map(s=>`<option ${d.home===s?'selected':''}>${s}</option>`).join('')}</select><div class="row2"><div><label>Within home state (₹)</label><input type="number" value="${d.inside}" onchange="DB.delivery.inside=+this.value;save()"></div><div><label>Other states (₹)</label><input type="number" value="${d.outside}" onchange="DB.delivery.outside=+this.value;save()"></div></div><label>Free delivery on orders above (₹)</label><input type="number" value="${d.free}" onchange="DB.delivery.free=+this.value;save()"><div class="row2"><div><label>International delivery charge (₹)</label><input type="number" value="${d.intl==null?2499:d.intl}" onchange="DB.delivery.intl=+this.value;save()"></div><div><label>International free delivery above (₹, 0 = never)</label><input type="number" value="${d.intlFree||0}" onchange="DB.delivery.intlFree=+this.value;save()"></div></div></div>
  <p class="note"><b>How orders reach your delivery partner:</b> your site records each order with a number (1001, 1002…). Use <b>Orders → Download orders (CSV)</b> to upload orders in bulk to Shiprocket (one account connects 15+ couriers such as Delhivery, Blue Dart, DTDC, Xpressbees, Ecom Express, Shadowfax and India Post) or to your courier's dashboard, where you print the shipping label. Use <b>🧾 Invoice</b> on each order to print the customer's bill. Sending orders to a courier automatically, with no manual step, needs a small server connected to the courier's API (a separate step).</p>`;
}
function aPolicy(){
  $('#amain').innerHTML=`<h2>Policies</h2><p class="note">Edit the text here and the website's policy pages update instantly. Start headings with "## " and list items with "- ". Writing <b>{{STORE}} {{EMAIL}} {{WHATSAPP}} {{PHONE}} {{FREE}}</b> fills in the real values automatically. Have a lawyer review the policies before launch.</p>${Object.entries(POL_TITLES).map(([k,t])=>`<div class="box"><h3>${esc(t)}</h3><textarea rows="12" onchange="DB.policies['${k}']=this.value;save()">${esc(DB.policies[k]||POL_DEF[k])}</textarea><button class="mini" style="margin-top:8px" onclick="if(confirm('Restore the default text?')){DB.policies['${k}']=POL_DEF['${k}'];save();renderAdmin()}">Restore default</button> <button class="mini" onclick="openPolicy('${k}')">Preview</button></div>`).join('')}`;
}
function aSettings(){
  const s=DB.settings;
  $('#amain').innerHTML=`<h2>Settings</h2><div class="box"><h3>Photo hosting for Facebook / Instagram catalog</h3><p style="font-size:14px;color:var(--mute)">Facebook &amp; Instagram need a public web link for every product photo. Cloudinary is a free photo-hosting service that gives those links.</p><ol class="steps"><li>Sign up free at <b>cloudinary.com</b>.</li><li>On the dashboard, copy your <b>Cloud name</b> (top-left).</li><li>Go to <b>Settings → Upload → Upload presets → Add preset</b>. Set <b>Signing mode = Unsigned</b>, save, and copy the preset name.</li><li>Paste both below and press <b>Save</b>. Never paste your API Secret here.</li></ol><div class="row2"><div><label>Cloudinary cloud name</label><input value="${esc(s.cldName||'')}" onchange="DB.settings.cldName=this.value.trim();save()"></div><div><label>Upload preset (unsigned)</label><input value="${esc(s.cldPreset||'')}" onchange="DB.settings.cldPreset=this.value.trim();save()"></div></div></div><div class="box"><h3>Customer login options</h3><p style="font-size:14px;color:var(--mute)">Email and SMS OTP are always available. Turn on only the options you have enabled in Firebase → Authentication → Sign-in method.</p><div class="row2"><div><label>Google login</label><select onchange="DB.settings.gLogin=this.value==='1';save()"><option value="1" ${s.gLogin!==false?'selected':''}>On</option><option value="0" ${s.gLogin===false?'selected':''}>Off</option></select></div><div><label>Facebook login</label><select onchange="DB.settings.fbLogin=this.value==='1';save()"><option value="0" ${s.fbLogin!==true?'selected':''}>Off</option><option value="1" ${s.fbLogin===true?'selected':''}>On</option></select></div></div><div class="row2" style="margin-top:12px"><div><label>Google button logo</label>${s.gLogo?`<img src="${s.gLogo}" style="width:40px;height:40px;object-fit:contain;display:block;margin:4px 0">`:''}<input type="file" accept="image/*" onchange="upLoginLogo('gLogo',this)"><small style="color:var(--mute)">Upload the official Google "G" logo (PNG, square).</small></div><div><label>Facebook button logo</label>${s.fbLogo?`<img src="${s.fbLogo}" style="width:40px;height:40px;object-fit:contain;display:block;margin:4px 0">`:''}<input type="file" accept="image/*" onchange="upLoginLogo('fbLogo',this)"><small style="color:var(--mute)">Upload the official Facebook "f" logo (PNG, square).</small></div></div></div><div class="box"><h3>Sliding announcement bar &amp; home slider title</h3><p style="font-size:14px;color:var(--mute)">Write up to 5 messages, one per line. They slide automatically at the very top of the store (e.g. free delivery above ₹2,999, international shipping, festive offer).</p><label>Top bar messages (one per line)</label><textarea rows="5" onchange="DB.settings.topbars=this.value.split('\n').map(x=>x.trim()).filter(Boolean).slice(0,5);save();setTopbar()">${esc((s.topbars&&s.topbars.length?s.topbars:[s.topbar||'']).join('\n'))}</textarea><label>Title of the sliding product row</label><input value="${esc(s.fsTitle||'Trending Now')}" onchange="DB.settings.fsTitle=this.value.trim();save()"></div>
  <div class="box"><h3>Default delivery estimate</h3><p style="font-size:14px;color:var(--mute)">Shown to customers in order tracking when you have not set a date for that order.</p><label>Estimate text</label><input placeholder="5–7 business days" value="${esc(s.eta||'')}" onchange="DB.settings.eta=this.value.trim();save()"></div>
  <div class="box"><h3>Connect Google &amp; Facebook login</h3><p style="font-size:14px;color:var(--mute)">The On/Off switch above only shows or hides the buttons. The real connection is made once inside Firebase (no code or secret is typed on this page).</p><ol class="steps"><li><b>Google:</b> Firebase → Authentication → Sign-in method → Google → Enable → Save.</li><li><b>Facebook:</b> create the app on developers.facebook.com, copy its <b>App ID</b> and <b>App Secret</b> into Firebase → Sign-in method → Facebook, then copy Firebase's redirect URL back into the Facebook app. The Facebook app must be <b>Published</b> before customers can use it.</li><li>Return here, switch the option <b>On</b>, press <b>Save</b>.</li></ol><a class="btn sm gold" style="display:inline-block" target="_blank" rel="noopener" href="https://console.firebase.google.com/project/zavra-7ee42/authentication/providers">Open Firebase sign-in methods</a></div>
  <div class="box"><h3>Delivery partner connections</h3><p style="font-size:14px;color:var(--mute)">Shiprocket, NimbusPost and other courier APIs need a secret password. Anything typed on this page is stored in a public-readable settings record, so <b>secrets are never entered here</b>. They are stored safely on the server (Firebase Functions secrets) using the server package already prepared.</p><ol class="steps"><li>Upgrade Firebase to the Blaze plan.</li><li>Set the secrets <b>SR_EMAIL, SR_PASSWORD, SR_PICKUP</b> (Shiprocket) once, then deploy.</li><li>After that, setting an order to <b>Confirmed</b> sends it to the courier automatically and the tracking ID appears for the customer.</li></ol><p class="note" style="font-size:13px">Until then, use <b>Orders → manual courier / tracking ID</b>.</p></div>
  <div class="box"><div class="row2"><div><label>Store name</label><input value="${esc(s.name)}" onchange="DB.settings.name=this.value;save()"></div><div><label>Website domain (e.g. zavra.in)</label><input value="${esc(s.domain)}" onchange="DB.settings.domain=this.value.trim();save()"></div></div><label>Top announcement bar</label><input value="${esc(s.topbar)}" onchange="DB.settings.topbar=this.value;save()"><div class="row2"><div><label>Phone numbers (comma separated)</label><input value="${esc(s.phone)}" onchange="DB.settings.phone=this.value;save()"></div><div><label>WhatsApp number (with 91)</label><input value="${esc(s.wa)}" onchange="DB.settings.wa=this.value;save()"></div></div><label>Customer care email (shown to customers)</label><input value="${esc(s.email)}" onchange="DB.settings.email=this.value.trim();save()"><p class="note">This email is only displayed on the website. The admin login email is separate and does not change.</p><div class="row2"><div><label>Facebook page link</label><input value="${esc(s.fb||'')}" placeholder="https://facebook.com/yourpage" onchange="DB.settings.fb=this.value.trim();save()"></div><div><label>Instagram link</label><input value="${esc(s.ig||'')}" placeholder="https://instagram.com/yourpage" onchange="DB.settings.ig=this.value.trim();save()"></div></div><label>Bulk / wholesale — intro text (shown to customers)</label><input value="${esc(s.bulkInfo||'')}" placeholder="Buying for your shop? Tell us what you need and we will send a wholesale quote." onchange="DB.settings.bulkInfo=this.value.trim();save()"><label>Bulk / wholesale — minimum order (for example: 50 pieces per design)</label><input value="${esc(s.bulkMin||'')}" onchange="DB.settings.bulkMin=this.value.trim();save()"><label>Bulk / wholesale — product types (comma separated)</label><textarea rows="3" onchange="DB.settings.bulkCats=this.value.trim();save()">${esc(s.bulkCats||BULK_CATS_DEF)}</textarea><label>Payment logo size (all logos use the same size)</label><select onchange="DB.settings.logoSize=this.value;save();applyLogoSize()">${[['S','Small'],['M','Medium'],['L','Large']].map(([v,l])=>`<option value="${v}" ${(s.logoSize||'M')===v?'selected':''}>${l}</option>`).join('')}</select><label>X (Twitter) link</label><input value="${esc(s.tw||'')}" placeholder="https://x.com/yourpage" onchange="DB.settings.tw=this.value.trim();save()"><label>WhatsApp OTP login — server URL (leave empty until it is set up)</label><input value="${esc(s.waApi||'')}" placeholder="https://…cloudfunctions.net/waOtp" onchange="DB.settings.waApi=this.value.trim();save()"><p class="note">Paste the URL of your WhatsApp OTP function here to switch on "Login with WhatsApp" for customers. The setup steps are in WHATSAPP-OTP-SETUP.md.</p></div>
  <div class="box"><h3>Seller Details (shown on the policy pages)</h3><div class="row2"><div><label>Legal business name</label><input value="${esc(s.legal)}" onchange="DB.settings.legal=this.value;save()"></div><div><label>GSTIN (if any)</label><input value="${esc(s.gstin)}" onchange="DB.settings.gstin=this.value.trim();save()"></div></div><label>Business address</label><input value="${esc(s.address)}" onchange="DB.settings.address=this.value;save()"><label>Grievance Officer name</label><input value="${esc(s.grievance)}" onchange="DB.settings.grievance=this.value;save()"></div>
  ${FB_ON?`<div class="box"><h3>Admin Password</h3><p style="font-size:14px">Tap the button below and a reset link will be sent to ${esc(ADMIN_EMAIL)}.</p><button class="btn sm dark" style="margin-top:10px" onclick="FB.au.sendPasswordResetEmail(FB.auth,ADMIN_EMAIL).then(()=>toast('Reset email sent')).catch(()=>toast('Could not send'))">Send password reset email</button></div>`
  :`<div class="box"><h3>Admin Password (demo mode)</h3><label>New password</label><input type="password" id="npw"><button class="btn sm dark" style="margin-top:12px" onclick="if($('#npw').value.length<6)return toast('Use at least 6 characters');DB.settings.pw=$('#npw').value;save();toast('Password changed');$('#npw').value=''">Change password</button></div>`}
  <div class="box"><h3>Data</h3><button class="mini" onclick="exportDB()">Download backup</button>${FB_ON?'':' <button class="mini" onclick="if(confirm(\'All data will be reset. Are you sure?\')){localStorage.removeItem(\'zavra_db4\');location.reload()}">Reset</button>'}</div>`;
  addSaveBtns();
}
function saveBox(b){const bx=b.closest('.box');bx.querySelectorAll('input,select,textarea').forEach(e=>{if(e.type!=='file')e.dispatchEvent(new Event('change'))});save();toast('Saved ✓')}
function addSaveBtns(){document.querySelectorAll('#amain .box').forEach(bx=>{if(bx.querySelector('.sv')||!bx.querySelector('input:not([type=file]),select,textarea'))return;const d=document.createElement('div');d.className='sv';d.innerHTML='<button class="btn sm gold" onclick="saveBox(this)">Save changes</button><small style="color:var(--mute)">Saved changes appear on the store instantly.</small>';bx.appendChild(d)})}
function exportDB(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(DB,null,1)],{type:'application/json'}));a.download='zavra-backup.json';a.click()}

/* ---------- Admin: sellers & approvals ---------- */
function promoProd(id){
  const p=DB.products.find(x=>x.id===id);if(!p)return;const u=prodUrl(id);
  const cap='✨ '+p.name+'\n💰 '+tk(p.price)+(p.old>p.price?' (was '+tk(p.old)+')':'')+'\n'+(p.fabric?'🧵 '+p.fabric+'\n':'')+(p.sizes?'📏 Sizes: '+p.sizes+'\n':'')+'🚚 Delivery across India & worldwide · COD in India\n🛍 Order now: '+u+'\n\n#ZAVRA #Fashion #IndianFashion #'+catEn(p.cat).replace(/[^A-Za-z]/g,'');
  $('#pf').innerHTML=`<div class="box" style="margin-top:14px"><h3>Promote: ${esc(p.name)}</h3><p class="note">Download the photo, copy the caption, then post both on Instagram or Facebook. The link in the caption opens this product on your store.</p><textarea id="capt" rows="8">${esc(cap)}</textarea><div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap"><button class="btn sm dark" onclick="navigator.clipboard?navigator.clipboard.writeText($('#capt').value).then(()=>toast('Caption copied')):toast('Select the text and copy it')">Copy caption</button><button class="btn sm" onclick="shareProd(${p.id},'fb')">Share on Facebook</button><button class="btn sm" onclick="shareProd(${p.id},'wa')">Share on WhatsApp</button>${p.img?`<a class="btn sm" href="${esc(p.img)}" download="zavra-product.jpg">Download photo</a>`:''}<button class="mini" onclick="$('#pf').innerHTML=''">Close</button></div></div>`;
  $('#pf').scrollIntoView({behavior:'smooth'});
}
function approveProd(id){const p=DB.products.find(x=>x.id===id);if(!p)return;p.status='approved';persistProduct(p);toast('Product approved — now live');renderAdmin()}
async function aSellers(){
  $('#amain').innerHTML='<h2>Sellers</h2><p>Loading…</p>';
  if(FB_ON)await loadSellers();
  const L=(DB.sellers||[]).slice().sort((a,b)=>String(b.date).localeCompare(String(a.date)));
  $('#amain').innerHTML=`<h2>Sellers</h2><p class="note">New sellers must be approved before they can add products. Each seller product is then reviewed in the Products tab before it appears on the store.</p>${L.length?`<table class="tb"><tr><th>Shop</th><th>Contact</th><th>Registered</th><th>Status</th><th></th></tr>${L.map(s=>`<tr><td><b>${esc(s.shop)}</b><br><small>${esc(s.name)} · ${esc(s.city)}</small></td><td>${esc(s.email)}<br><small>+91 ${esc(s.phone)}</small></td><td><small>${new Date(s.date).toLocaleDateString('en-IN')}</small></td><td><span class="badge b-${s.approved?'Approved':'Pending'}">${s.approved?'Approved':'Pending'}</span></td><td>${s.approved?`<button class="mini" onclick="setSeller('${esc(s.uid)}',false)">Suspend</button>`:`<button class="mini" onclick="setSeller('${esc(s.uid)}',true)">Approve</button>`}</td></tr>`).join('')}</table>`:'<div class="box">No sellers have registered yet. Share the "Sell on ZAVRA" link in the website footer.</div>'}`;
}
async function setSeller(uid,ok){const s=(DB.sellers||[]).find(x=>x.uid===uid);if(!s)return;s.approved=ok;await fbSet('sellers',uid,s);aSellers()}

/* ---------- Seller panel ---------- */
function openSellerAuth(mode){closeAll();sellerForm(mode);$('#lov').classList.add('on')}
function sellerForm(mode){
  const su=mode==='signup';
  $('#loginBody').innerHTML=`<h2>${su?'Register as a Seller':'Seller Sign In'}</h2>${su?'<label>Shop / brand name *</label><input id="sshop"><label>Owner name *</label><input id="snm" autocomplete="name"><div class="row2"><div><label>Mobile number *</label><input id="sph" inputmode="tel" maxlength="10"></div><div><label>City *</label><input id="scity"></div></div>':''}<label>Email *</label><input id="lem" type="email" autocomplete="email"><label>Password *</label><input id="lpw" type="password" autocomplete="${su?'new-password':'current-password'}" placeholder="At least 6 characters" onkeydown="if(event.key===\'Enter\')sellerAuth(\'${mode}\')"><button class="btn dark" style="width:100%;margin-top:16px" onclick="sellerAuth('${mode}')">${su?'Create Seller Account':'Sign In'}</button><p style="margin-top:14px;font-size:13px">${su?'Already registered? <span class="lnk" onclick="sellerForm(\'signin\')">Sign in</span>':'New seller? <span class="lnk" onclick="sellerForm(\'signup\')">Register here</span> · <span class="lnk" onclick="forgotPw()">Forgot password?</span>'}</p>${su?'<p class="note">Your account is reviewed by ZAVRA. Once approved, you can list products; each listing goes live after approval.</p>':''}`;
}
async function sellerAuth(mode){
  const em=($('#lem').value||'').trim(),pw=$('#lpw').value||'';
  if(!/^\S+@\S+\.\S+$/.test(em))return toast('Enter a valid email address');
  if(pw.length<6)return toast('Password must be at least 6 characters');
  let info=null;
  if(mode==='signup'){
    const shop=$('#sshop').value.trim(),nm=$('#snm').value.trim(),ph=($('#sph').value||'').replace(/\D/g,'').replace(/^91(?=\d{10}$)/,''),city=$('#scity').value.trim();
    if(!shop||!nm||!city)return toast('Please fill in all the fields');
    if(!/^[6-9]\d{9}$/.test(ph))return toast('Enter a valid 10-digit mobile number');
    info={shop,name:nm,phone:ph,city};
  }
  if(!await ensureFB())return;
  let cred;
  try{
    if(mode==='signup'){
      cred=await FB.au.createUserWithEmailAndPassword(FB.auth,em,pw);
      const s={uid:cred.user.uid,email:em,...info,approved:false,date:new Date().toISOString()};
      await FB.fs.setDoc(FB.fs.doc(FB.db,'sellers',cred.user.uid),s);SELLER=s;
    }else cred=await FB.au.signInWithEmailAndPassword(FB.auth,em,pw);
  }catch(e){console.error(e);return toast(authErr(e))}
  if(em===ADMIN_EMAIL){closeAll();location.hash='#admin';return}
  USER={uid:cred.user.uid,phone:'',email:em};
  if(mode==='signin'){await refreshSeller();if(!SELLER){closeAll();toast('This account is not registered as a seller yet. Please register first.');return}}
  uiUser();closeAll();toast(mode==='signup'?'Seller account created ✓':'Login successful ✓');
  stab='prod';location.hash='#seller';route();
}
let stab='prod';
function renderSeller(){
  const ok=!!(USER&&SELLER);
  $('#sLogin').style.display=ok?'none':'block';$('#sBody').style.display=ok?'grid':'none';$('#sOut').style.display=USER?'':'none';
  if(!ok)return;
  $('#sSide').innerHTML=[['prod','👗 My Products'],['new','＋ Add Product'],['prof','🏪 Profile']].map(([k,v])=>`<button class="${stab===k?'on':''}" onclick="stab='${k}';renderSeller()">${v}</button>`).join('');
  ({prod:sProducts,new:()=>sEdit(0),prof:sProfile})[stab]();
}
const sBanner=()=>SELLER.approved?'<div class="note">✓ Your seller account is approved. New and edited products are reviewed by ZAVRA before they appear on the store.</div>':'<div class="note" style="border-color:#c9a227">⏳ Your seller account is awaiting approval by ZAVRA. You will be able to add products once it is approved.</div>';
const myProds=()=>DB.products.filter(p=>p.sellerId===USER.uid);
function sProducts(){
  const L=myProds();
  $('#sMain').innerHTML=`<h2>My Products</h2>${sBanner()}${L.length?`<table class="tb"><tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>${L.map(p=>`<tr><td><img loading="lazy" src="${esc(productPhoto(p))}" alt=""></td><td>${esc(p.name)}</td><td>${esc(catEn(p.cat))}</td><td>${tk(p.price)}</td><td>${bn(p.stock)}</td><td><span class="badge b-${p.status==='pending'?'Pending':'Approved'}">${p.status==='pending'?'In review':'Live'}</span></td><td><button class="mini" onclick="sEdit(${p.id})">Edit</button> <button class="mini" onclick="sDel(${p.id})">Delete</button></td></tr>`).join('')}</table>`:'<div class="box">You have not listed any products yet. Open "Add Product" to create your first listing.</div>'}`;
}
function sEdit(id){
  if(!SELLER.approved){$('#sMain').innerHTML='<h2>Add Product</h2>'+sBanner();return}
  const first=sortedCats()[0];
  const p=id?DB.products.find(x=>x.id===id&&x.sellerId===USER.uid):{name:'',cat:first?first.id:'',price:'',old:'',desc:'',sizes:'',stock:10,img:''};
  if(!p)return;pimgs=(p.imgs&&p.imgs.length)?p.imgs.slice():(p.img?[p.img]:[]);
  $('#sMain').innerHTML=`<h2>${id?'Edit Product':'Add Product'}</h2>${sBanner()}<div class="box"><p class="note">Saving sends the product to ZAVRA for review. It appears on the store once approved.</p>
  <label>Product name *</label><input id="fn" value="${esc(p.name)}">
  <label>Category *</label><select id="fc">${catOptions(p.cat)}</select>
  <div class="row2"><div><label>Price (₹) *</label><input id="fp" type="number" value="${p.price}"></div><div><label>Old price (₹, optional)</label><input id="fo" type="number" value="${p.old||''}"></div></div>
  <div class="row2"><div><label>Stock *</label><input id="fs" type="number" value="${p.stock}"></div><div><label>Sizes (comma separated: S,M,L)</label><input id="fz" value="${esc(p.sizes)}"></div></div><div class="row2"><div><label>Star rating (optional, 0–5)</label><input id="frating" type="number" min="0" max="5" step="0.1" value="${p.rating||''}"></div><div><label>Review count</label><input id="freviews" type="number" min="0" value="${p.reviewCount||0}"></div></div>
  ${FORM_EXTRA(p)}
  <label>Description</label><textarea id="fd" rows="3">${esc(p.desc)}</textarea>
  <label>Product photos (up to 6 — front, back, sides, details)</label><input type="file" accept="image/*" multiple onchange="upImg(this)"><div id="ipv" class="ipv">${ipvHtml()}</div>
  <div style="margin-top:14px"><button class="btn sm dark" onclick="sSave(${id})">Submit for review</button> <button class="mini" onclick="stab='prod';renderSeller()">Cancel</button></div></div>`;
}
async function sSave(id){
  const d={name:$('#fn').value.trim(),cat:$('#fc').value,price:+$('#fp').value,old:+$('#fo').value||0,offer:($('#fof')?$('#fof').value.trim():''),stock:+$('#fs').value||0,sizes:$('#fz').value.trim(),desc:$('#fd').value.trim(),fabric:$('#ffb').value.trim(),sku:$('#fsku').value.trim(),brand:$('#fbr').value.trim(),colors:$('#fcol').value.trim(),flash:$('#ffl').checked,rating:Math.max(0,Math.min(5,+($('#frating')?.value||0))),reviewCount:Math.max(0,+($('#freviews')?.value||0)),img:pimgs[0]||'',imgs:pimgs.slice()};if($('#fft'))d.feat=$('#fft').checked;
  if(!d.name||!d.price)return toast('Enter a name and price');
  if(pimgs.join('').length>850000)return toast('Photos are too large in total — remove one or use smaller photos');
  let p;
  if(id){p=DB.products.find(x=>x.id===id&&x.sellerId===USER.uid);if(!p)return;Object.assign(p,d,{status:'pending'})}
  else{p={id:Date.now()%1e9,ord:Date.now(),tag:'',...d,sellerId:USER.uid,sellerName:SELLER.shop,status:'pending'};DB.products.push(p)}
  await fbSet('products',p.id,p);
  toast('Submitted for review ✓');stab='prod';renderSeller();
}
function sDel(id){
  if(!confirm('Delete this product?'))return;
  FB.fs.deleteDoc(FB.fs.doc(FB.db,'products',String(id))).then(()=>{DB.products=DB.products.filter(x=>x.id!==id);renderSeller()}).catch(()=>toast('Could not delete'));
}
function sProfile(){
  $('#sMain').innerHTML=`<h2>Profile</h2>${sBanner()}<div class="box"><p><b>${esc(SELLER.shop)}</b></p><p style="color:var(--mute);font-size:14px;margin-top:6px">${esc(SELLER.name)} · ${esc(SELLER.city)}<br>${esc(SELLER.email)} · +91 ${esc(SELLER.phone)}</p></div><p class="note">Customer orders, payments and shipping are handled by ZAVRA. For any help, contact the ZAVRA team using the phone or WhatsApp number in the website footer.</p>`;
}

function subscribeNewsletter(e){e.preventDefault();const el=$('#newsEmail'),email=(el.value||'').trim().toLowerCase();if(!/^\S+@\S+\.\S+$/.test(email))return toast('Enter a valid email address');let a=[];try{a=JSON.parse(localStorage.getItem('zavra_newsletter')||'[]')}catch(_){}if(a.includes(email))return toast('You are already subscribed');a.push(email);try{localStorage.setItem('zavra_newsletter',JSON.stringify(a))}catch(_){}el.value='';toast('Thanks for subscribing!');}

/* ---------- Boot ---------- */
async function boot(){
  if(!FB_ON){try{USER=JSON.parse(localStorage.getItem('zavra_user')||'null')}catch(e){USER=null}}
  else{
    try{await initFB();await loadStoreFB();ensureCatalogDefaults();wireAuth()}
    catch(e){console.error(e);toast('Could not connect to Firebase: '+(e.code||e.message||'check your internet'))}
  }
  route();
}
window.addEventListener('hashchange',route);
boot();
</script>
</body>
</html>
