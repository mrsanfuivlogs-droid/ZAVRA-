<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZAVRA | Premium Fashion for Men, Women & Kids</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Hind+Siliguri:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#111;--ivory:#f5f8ff;--ivory2:#eaf1ff;--gold:#2563eb;--gold2:#60a5fa;--mute:#5f6b85;--line:#dfe7f5;--card:#fff;--deep:#0b1a38}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Hind Siliguri',sans-serif;background:var(--ivory);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,.logo{font-family:'Cormorant Garamond','Hind Siliguri',serif}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
.wrap{max-width:1240px;margin:auto;padding:0 22px}
.topbar{background:var(--deep);color:var(--gold2);text-align:center;font-size:12.5px;padding:8px;letter-spacing:1.2px}
header{position:sticky;top:0;z-index:50;background:rgba(250,246,239,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:74px}
.logo{font-size:34px;letter-spacing:9px;font-weight:700}
.logo small{display:block;font-size:11px;letter-spacing:6px;color:var(--gold);text-align:center;margin-top:-6px;font-family:'Hind Siliguri'}
.links{display:flex;gap:34px;font-size:13px;letter-spacing:3px;text-transform:uppercase}
.links a{position:relative;padding:4px 0}
.links a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold);transition:.3s}
.links a:hover{color:var(--gold)}.links a:hover::after{width:100%}
.icons{display:flex;gap:10px;align-items:center;position:relative}
.menu{display:none;position:absolute;top:calc(100% + 16px);right:0;width:272px;max-height:calc(100vh - 110px);overflow:auto;background:#fff;border:1px solid var(--line);box-shadow:0 18px 50px rgba(0,0,0,.18);z-index:300}
.menu.on{display:block}
.menu h6{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:500;padding:14px 18px 6px;background:#f5f8ff}
.menu button{display:flex;gap:12px;align-items:center;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid var(--line);padding:12px 18px;font-size:14.5px;color:var(--ink)}
.menu button:hover{background:var(--ivory)}.menu button span{width:20px;text-align:center}
.ibtn.kebab{padding:8px 14px;font-size:18px;line-height:1}
.nav2{display:grid;grid-template-columns:auto 1fr auto;align-items:center;height:78px;gap:6px}
@media(min-width:861px){.nav2{grid-template-columns:1fr auto 1fr}}
.hb{justify-self:start;background:none;border:none;width:42px;height:44px;display:flex;flex-direction:column;justify-content:center;gap:7px;padding:0 4px}
.hb i{display:block;height:2px;width:100%;background:var(--ink);transition:.25s}.hb:hover i{background:var(--gold)}
.logo2{justify-self:center;text-align:center;font-size:30px;letter-spacing:.32em;padding-left:.32em;font-weight:600;line-height:1;white-space:nowrap;background:linear-gradient(100deg,#111 0%,#111 36%,#2563eb 50%,#111 64%,#111 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
.logo2 small{display:block;margin:6px 0 0;font-size:8.5px;letter-spacing:.62em;padding-left:.62em;font-weight:500;color:var(--gold);-webkit-text-fill-color:var(--gold);font-family:'Hind Siliguri',sans-serif}
.icons2{justify-self:end;display:flex;align-items:center}
.ic{position:relative;background:none;border:none;width:38px;height:40px;display:grid;place-items:center;padding:0;color:var(--ink);transition:.2s}.ic:hover{color:var(--gold)}
.ic svg{width:22px;height:22px}
.ic.on::after{content:'';position:absolute;top:7px;right:6px;width:8px;height:8px;border-radius:50%;background:#2e9d57;border:1.5px solid #f5f8ff}
.bdg{position:absolute;top:2px;right:0;min-width:17px;height:17px;border-radius:9px;background:var(--gold);color:#fff;font-size:10px;font-weight:600;display:none;place-items:center;padding:0 4px;line-height:1}
@media(max-width:520px){.logo2{font-size:23px;letter-spacing:.26em;padding-left:.26em}.logo2 small{font-size:7px;letter-spacing:.5em}.ic{width:33px}.hb{width:34px}.ic svg{width:21px;height:21px}}
.hrt{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.93);border:none;font-size:19px;line-height:1;display:grid;place-items:center;color:#666;z-index:3;padding:0;transition:.2s}.hrt:hover{transform:scale(1.12)}.hrt.on{color:#c0304f}
#sov{padding:0;justify-content:flex-start;align-items:stretch}
#sov .sidebar{width:min(88vw,340px);height:100%;background:#fff;overflow:auto;transform:translateX(-100%);transition:transform .3s;box-shadow:0 0 40px rgba(0,0,0,.25)}
#sov.on .sidebar{transform:none}
.sbh{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:2}.sbh .x{position:static}
.sidebar h6{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:500;padding:16px 18px 6px;background:#f5f8ff;margin:0}
.sidebar .sbl{display:flex;gap:12px;align-items:center;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid var(--line);padding:12px 18px;font-size:14.5px;color:var(--ink)}.sidebar .sbl span{width:20px;text-align:center}.sidebar .sbl:hover{background:var(--ivory)}
.sg{border-bottom:1px solid var(--line)}
.sgh{display:flex;align-items:center;gap:12px;width:100%;background:none;border:none;padding:13px 18px;text-align:left;color:var(--ink)}
.sgh b{flex:1;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;font-size:14px}
.gic{width:40px;height:40px;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;font-size:19px;flex:none}
.sgh i{font-style:normal;font-size:22px;color:var(--gold);transition:.25s}.sg.open .sgh i{transform:rotate(45deg)}
.sgb{display:none;background:#f5f8ff}.sg.open .sgb{display:block}
.sgb button{display:flex;align-items:center;gap:12px;width:100%;background:none;border:none;border-top:1px solid var(--line);padding:10px 18px 10px 30px;font-size:14.5px;text-align:left;color:var(--ink)}.sgb button:hover{background:var(--ivory)}
.th{width:36px;height:36px;border-radius:50%;overflow:hidden;background:#fff;border:1px solid var(--line);display:grid;place-items:center;flex:none;font-size:18px}.th img{width:100%;height:100%;object-fit:cover}.th em{font-style:normal}
.sacc{padding:14px 18px;background:#fff;border-bottom:1px solid var(--line)}.sacc .btn{width:100%;text-align:center}
.cstrip{display:flex;gap:20px;overflow-x:auto;padding:20px 18px 14px;scrollbar-width:none;justify-content:flex-start}.cstrip::-webkit-scrollbar{display:none}
@media(min-width:900px){.cstrip{justify-content:center}}
.csi{flex:none;width:78px;text-align:center;font-size:12px;cursor:pointer;color:var(--ink)}
.csc{width:68px;height:68px;border-radius:50%;border:1.5px solid var(--gold);padding:3px;margin:0 auto 7px;background:#fff;transition:.25s}.csi:hover .csc{transform:translateY(-3px);box-shadow:0 8px 18px rgba(0,0,0,.12)}
.csc div{width:100%;height:100%;border-radius:50%;overflow:hidden;display:grid;place-items:center;font-size:28px;background:#f5f8ff}.csc img{width:100%;height:100%;object-fit:cover}
.fab{position:fixed;right:16px;bottom:18px;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(0,0,0,.28);z-index:90;transition:.25s}.fab:hover{transform:scale(1.08)}.fab svg{width:30px;height:30px;fill:#fff}
.wrow{display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);cursor:pointer}.wrow img{width:56px;height:70px;object-fit:cover}.wrow .wi{width:56px;height:70px;display:grid;place-items:center;background:#f5f8ff;font-size:26px}.wrow div{flex:1;font-size:14px}.wrow b{display:block}
.sres{max-height:60vh;overflow:auto;margin-top:12px}
.tl{display:flex;justify-content:space-between;margin:22px 0 8px;position:relative}.tl:before{content:'';position:absolute;top:13px;left:8%;right:8%;height:2px;background:var(--line)}
.tl div{position:relative;text-align:center;font-size:12px;flex:1;color:var(--mute)}.tl i{display:block;width:28px;height:28px;border-radius:50%;background:#fff;border:2px solid var(--line);margin:0 auto 6px;line-height:24px;font-style:normal;font-size:13px}
.tl .done{color:var(--ink)}.tl .done i{background:var(--gold);border-color:var(--gold);color:#fff}
.ibtn{background:none;border:1px solid var(--line);border-radius:30px;padding:8px 18px;font-size:13.5px;transition:.25s;width:auto;flex:none}
.ibtn:hover{border-color:var(--gold);color:var(--gold)}
/* slider */
.slider{position:relative;overflow:hidden;background:#0d0d0d;color:#fff;height:620px}
.slider::after{content:'';position:absolute;inset:16px;border:1px solid rgba(96,165,250,.28);pointer-events:none;z-index:4}
.sl{position:absolute;inset:0;opacity:0;transition:opacity .9s;display:flex;align-items:center;pointer-events:none;background-size:cover;background-position:center}
.sl.on{opacity:1;pointer-events:auto;z-index:1}
.sl-in{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;width:100%;max-width:1240px;margin:auto;padding:0 70px}
.sl .k{color:var(--gold2);letter-spacing:5px;font-size:12.5px;text-transform:uppercase}
.sl h1{font-size:clamp(36px,5.6vw,72px);line-height:1.15;font-weight:600;margin:14px 0 16px}
.sl p.s{max-width:480px;color:#e3dccd;font-weight:300;margin-bottom:30px;font-size:17px}
.arch{width:min(330px,78%);aspect-ratio:3/4;margin:auto;border-radius:200px 200px 14px 14px;border:2px solid var(--gold2);padding:10px;position:relative}
.arch-in{width:100%;height:100%;border-radius:190px 190px 6px 6px;background:linear-gradient(160deg,rgba(255,255,255,.16),rgba(255,255,255,.03));display:flex;align-items:center;justify-content:center;font-size:clamp(100px,15vw,170px);overflow:hidden}
.arch-t{position:absolute;bottom:-34px;left:0;right:0;text-align:center;font-family:'Cormorant Garamond';letter-spacing:6px;color:var(--gold2);font-size:17px}
.sp{position:absolute;color:var(--gold2);animation:tw 2.4s infinite;font-size:22px}
@keyframes tw{0%,100%{opacity:.2;transform:scale(.7)}50%{opacity:1;transform:scale(1.2)}}
.sa{position:absolute;top:50%;transform:translateY(-50%);z-index:5;background:rgba(0,0,0,.35);color:#fff;border:1px solid rgba(255,255,255,.3);width:44px;height:44px;border-radius:50%;font-size:20px}
.sa:hover{background:var(--gold)}
.sa.l{left:30px}.sa.r{right:30px}
.dots{position:absolute;bottom:30px;left:0;right:0;display:flex;justify-content:center;gap:8px;z-index:5}
.dots b{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.35);cursor:pointer}
.dots b.on{background:var(--gold2);width:28px;border-radius:6px}
.btn{display:inline-block;background:var(--gold);color:#fff;border:none;padding:15px 42px;letter-spacing:2px;font-size:13.5px;text-transform:uppercase;transition:.3s}
.btn:hover{background:var(--ink)}
.btn.sm{padding:9px 20px;font-size:13px;letter-spacing:1px;text-transform:none}
.btn.dark{background:var(--ink)}.btn.dark:hover{background:var(--gold)}
.btn:disabled{opacity:.5}
section{padding:84px 0}
.sec-t{text-align:center;margin-bottom:44px}
.eyebrow{letter-spacing:6px;font-size:12px;color:var(--gold);text-transform:uppercase}
.sec-t h2{font-size:clamp(32px,4.4vw,46px);font-weight:600;margin-top:4px}
.orn{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:12px;color:var(--gold)}
.orn::before,.orn::after{content:'';width:60px;height:1px;background:var(--gold2)}
.rv{opacity:0;transform:translateY(26px);transition:opacity .9s,transform .9s}
.rv.in{opacity:1;transform:none}
/* categories */
.grp{margin-bottom:46px}
.grp-h{display:flex;align-items:baseline;gap:14px;margin-bottom:18px;border-bottom:1px solid var(--line);padding-bottom:10px}
.grp-h h3{font-size:30px;font-weight:600}
.grp-h small{color:var(--gold);letter-spacing:3px;font-size:13px}
.catgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:18px}
.ct{position:relative;aspect-ratio:3/4;overflow:hidden;cursor:pointer;color:#fff;display:flex;align-items:flex-end}
.ct-bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .8s}
.ct:hover .ct-bg{transform:scale(1.08)}
.ct::after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(0,0,0,.78));transition:.3s}
.ct::before{content:'';position:absolute;inset:10px;border:1px solid rgba(96,165,250,0);transition:.4s;z-index:2;pointer-events:none}
.ct:hover::before{border-color:rgba(96,165,250,.8)}
.ct-i{position:absolute;right:12px;top:6px;font-size:64px;opacity:.28;font-style:normal;z-index:1}
.ct-t{position:relative;z-index:3;padding:16px}
.ct-t b{display:block;font-family:'Cormorant Garamond';font-size:24px;font-weight:600;line-height:1.15}
.ct-t small{opacity:.85;font-size:12.5px;letter-spacing:.5px}
/* shop */
.grpbar{display:flex;gap:10px;justify-content:center;margin-bottom:14px;flex-wrap:wrap}
.filters{display:flex;gap:8px;justify-content:center;margin-bottom:22px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:none;padding:8px 24px;border-radius:30px;font-size:13.5px;letter-spacing:1px;transition:.25s}
.chip.sm{padding:6px 16px;font-size:12.5px;letter-spacing:.5px}
.chip.on,.chip:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
.search{max-width:420px;margin:0 auto 34px;display:block;border-radius:30px;padding:12px 22px;text-align:center}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}
.pc{background:var(--card);cursor:pointer;transition:.35s;border:1px solid transparent}
.pc:hover{border-color:var(--gold2);box-shadow:0 18px 40px rgba(0,0,0,.09)}
.pimg{aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;overflow:hidden}
.pimg img,.pimg>span{transition:transform .7s}
.pimg img{width:100%;height:100%;object-fit:cover}
.pc:hover .pimg img,.pc:hover .pimg>span{transform:scale(1.07)}
.qv{position:absolute;left:0;right:0;bottom:0;background:rgba(12,10,8,.88);color:var(--gold2);text-align:center;padding:11px;transform:translateY(101%);transition:.35s;font-size:12px;letter-spacing:3px;text-transform:uppercase;font-family:'Hind Siliguri'}
.pc:hover .qv{transform:none}
.tag{position:absolute;top:10px;left:10px;background:var(--ink);color:var(--gold2);font-size:11px;padding:3px 11px;letter-spacing:1.5px}
.disc{position:absolute;top:10px;right:52px;background:var(--gold);color:#fff;font-size:11px;padding:3px 9px;letter-spacing:.5px}
.pi{padding:16px 16px 20px}
.pi small{color:var(--gold);letter-spacing:2px;font-size:11.5px;text-transform:uppercase}
.pi h3{font-size:19px;font-family:'Hind Siliguri';font-weight:500;margin:3px 0 4px}
.price b{font-size:18px}.price s{color:var(--mute);margin-left:8px;font-size:14px}
.feat{display:grid;grid-template-columns:repeat(4,1fr);gap:0;text-align:center}
.feat div{padding:34px 14px;border-right:1px solid var(--line)}
.feat div:last-child{border-right:0}
.feat b{display:block;font-size:28px;color:var(--gold);margin-bottom:6px;font-weight:400}
.feat span{display:block;font-weight:500}
.feat small{color:var(--mute);letter-spacing:1px;font-size:12px}
footer{background:var(--deep);color:#b5ad9c;padding:70px 0 26px;font-size:14px;border-top:3px solid var(--gold)}
.fg{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.3fr;gap:36px}
footer h4{color:var(--gold2);margin-bottom:14px;letter-spacing:4px;font-weight:500;font-size:12.5px;text-transform:uppercase}
footer a{display:block;padding:3px 0;cursor:pointer;transition:.2s}footer a:hover{color:var(--gold2);padding-left:4px}
.howto{margin:12px 0;font-size:13.5px;background:#f5f8ff;border:1px solid var(--line);padding:8px 12px}.howto summary{cursor:pointer;color:var(--gold);font-weight:500}.howto ol{margin:8px 0 4px 18px}.howto li{margin:4px 0}.howto p{margin:6px 0}
.bchips{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 4px}
.bchip{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:var(--bw,112px);height:var(--bh,78px);padding:6px 8px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:12px;font-weight:600;text-align:center;color:var(--ink);box-shadow:0 2px 8px rgba(0,0,0,.04)}.bchip img{width:100%;height:var(--bih,36px);object-fit:contain}.bchip small{font-size:10px;font-weight:400;color:var(--mute);line-height:1.1;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.prow{margin:10px 0 14px;text-align:center}.prow>b{display:block;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:8px}
.pchips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:6px}
.pchip{background:#fff;color:#222;border-radius:8px;width:var(--pw,84px);height:var(--ph,40px);padding:4px 8px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;letter-spacing:.2px;text-align:center;line-height:1.1}.pchip img{width:100%;height:calc(var(--ph,40px) - 14px);object-fit:contain;display:block}
.plogo{width:64px;height:26px;object-fit:contain;margin-left:auto;background:#fff;border:1px solid var(--line);border-radius:4px;padding:2px}
.pays{margin-top:34px;border-top:1px solid #26231f;padding-top:18px;text-align:center;font-size:12.5px;letter-spacing:1.5px;color:#7b88a5}
.copy{margin-top:12px;text-align:center;font-size:12.5px;color:#7b88a5}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:100;display:none;align-items:center;justify-content:center;padding:16px}
.ov.on{display:flex}
.md{background:#fff;max-width:880px;width:100%;max-height:92vh;overflow:auto;position:relative}
.md.n{max-width:560px}
.x{position:absolute;right:14px;top:10px;background:none;border:none;font-size:30px;z-index:3;line-height:1}
.pd{display:grid;grid-template-columns:1fr 1fr}
.pd .pimg{aspect-ratio:auto;min-height:0;height:min(60vh,520px)}.pd .gal .pimg img{object-position:center top}#pov .md{max-width:820px}
.pd .in{padding:36px}
.gal{display:flex;flex-direction:column;background:#fff}.gal .pimg{flex:1;cursor:pointer}.thumbs{display:flex;gap:8px;padding:8px;overflow:auto}.thumbs img{width:64px;height:80px;object-fit:cover;cursor:pointer;border:2px solid transparent;flex:none}.thumbs img.on{border-color:var(--gold)}
.ipv{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}.ith{position:relative;width:84px}.ith img{width:84px;height:104px;object-fit:cover}.ith button{position:absolute;top:2px;right:2px;width:22px;height:22px;padding:0;border-radius:50%;background:#111;color:#fff;border:none;line-height:1}.ith em{display:block;font-size:11px;color:var(--gold);font-style:normal;text-align:center}.ith u{display:block;font-size:11px;text-align:center;cursor:pointer}
.pd h2{font-size:32px;margin:6px 0}
.catlink{background:#f3f0ff;border-radius:10px;padding:10px;margin:8px 0;display:flex;flex-wrap:wrap;gap:8px;align-items:center}.catlink b{flex-basis:100%;font-size:13px}.catlink .chip{cursor:pointer}
.sizes{display:flex;gap:8px;margin:14px 0;flex-wrap:wrap}
.sz{border:1px solid var(--line);background:none;padding:6px 14px;font-size:14px}
.sz.on{background:var(--ink);color:#fff}
.drawer{position:fixed;right:0;top:0;bottom:0;width:min(420px,100%);background:#fff;z-index:110;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column}
.drawer.on{transform:none}
.dh{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.dh h3{font-size:24px}
.db{flex:1;overflow:auto;padding:14px 20px}
.df{padding:18px 20px;border-top:1px solid var(--line)}
.ci{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);align-items:center}
.ci .th{width:60px;height:78px;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;overflow:hidden}
.ci .th img{width:100%;height:100%;object-fit:cover}
.ci div.t{flex:1;font-size:14px}
.qty{display:flex;align-items:center;gap:8px;margin-top:4px}
.qty button{width:24px;height:24px;border:1px solid var(--line);background:none}
.rm{background:none;border:none;color:#b33;font-size:13px}
.fm{padding:30px}
.fm h2{font-size:30px;margin-bottom:14px}
label{display:block;font-size:13px;color:var(--mute);margin:12px 0 4px}
input,select,textarea{width:100%;padding:11px 12px;border:1px solid var(--line);font-family:inherit;font-size:15px;background:#fff}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--gold)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.soc{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
footer .soc a{display:flex;align-items:center;gap:8px;height:40px;padding:0 15px 0 12px;border:1px solid rgba(255,255,255,.35);border-radius:22px;font-size:13px;color:#fff;transition:.25s}
footer .soc a:hover{padding:0 15px 0 12px;background:var(--gold);border-color:var(--gold);transform:translateY(-2px)}
.soc svg{width:18px;height:18px;fill:#fff;stroke:none}.soc svg.s{fill:none;stroke:#fff;stroke-width:1.8}
.savebar{position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);padding:12px 0;margin-top:18px;z-index:5;text-align:center}.savebar .btn{width:100%;max-width:420px}
.pay{border:1px solid var(--line);padding:10px 12px;margin-top:8px;display:flex;gap:10px;align-items:flex-start;cursor:pointer}
.pay input{width:auto;margin-top:5px}
.pay.on{border-color:var(--gold);background:#fbf7ee}
.sum{background:var(--ivory);padding:14px;margin-top:16px;font-size:14px}
.sum div{display:flex;justify-content:space-between;padding:2px 0}
.sum .tt{font-weight:600;font-size:17px;border-top:1px solid var(--line);margin-top:6px;padding-top:8px}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 24px;z-index:300;display:none;border-left:3px solid var(--gold);max-width:92%}
.ord{border:1px solid var(--line);padding:14px;margin-top:12px;font-size:14px}
.lnk{color:var(--gold);text-decoration:underline;cursor:pointer}
.pol{padding:28px}
.pol h2{font-size:32px;margin-bottom:10px}
.pol h3{font-family:'Hind Siliguri',sans-serif;font-size:16.5px;font-weight:600;margin:18px 0 4px}
.pol p,.pol li{font-size:14.5px;color:#444;margin:4px 0}
.pol ul{margin:4px 0 4px 20px}
.pol .seller{background:var(--ivory);border-left:3px solid var(--gold);padding:12px 14px;margin-top:22px;font-size:13.5px}
.pol .tabs{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 6px}
#admin,#seller{display:none;min-height:100vh;background:#f3f1ec}
.ad-top{background:var(--ink);color:#fff;padding:14px 22px;display:flex;justify-content:space-between;align-items:center}
.ad-top .logo{font-size:22px;letter-spacing:5px;color:var(--gold2)}
.ad-body{display:grid;grid-template-columns:210px 1fr;min-height:calc(100vh - 56px)}
.side{background:#fff;border-right:1px solid var(--line);padding:16px 0}
.side button{display:block;width:100%;text-align:left;background:none;border:none;padding:12px 22px;font-size:15px}
.side button.on{background:var(--ivory);border-left:3px solid var(--gold);font-weight:600}
.main{padding:26px;overflow:auto}
.main h2{font-size:30px;margin-bottom:16px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.stat{background:#fff;padding:20px;border-left:3px solid var(--gold)}
.stat b{font-size:28px;display:block}
.tb{width:100%;background:#fff;border-collapse:collapse;font-size:14px}
.tb th,.tb td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
.tb th{background:#f5f8ff;font-weight:500;color:var(--mute)}
.tb img{width:44px;height:56px;object-fit:cover}
.box{background:#fff;padding:20px;margin-bottom:18px}
.box h3{font-size:22px;margin-bottom:6px}
.badge{padding:2px 10px;font-size:12px;border-radius:20px;background:#eee}
.b-Packing{background:#ffe8cc}.b-OutForDelivery{background:#d9f0ff}.offtag{display:inline-block;background:#1e7a3c;color:#fff;font-size:12px;padding:3px 10px;margin-left:10px;border-radius:3px;letter-spacing:.5px}.cpn{border:1px dashed var(--gold);padding:8px 12px;margin-top:8px;font-size:13px}.b-Pending{background:#fff3cd}.b-Confirmed{background:#d1e7ff}.b-Shipped{background:#e2d4ff}.b-Delivered{background:#d4f4dd}.b-Cancelled{background:#ffd6d6}.b-Approved{background:#d4f4dd}.b-Suspended{background:#ffd6d6}
.tabs2{display:flex;gap:0;margin:14px 0 6px;border-bottom:1px solid var(--line)}.tabs2 button{flex:1;background:none;border:none;border-bottom:2px solid transparent;padding:10px 4px;font-size:15px;color:var(--mute)}.tabs2 button.on{border-bottom-color:var(--gold);color:var(--ink);font-weight:600}
.sw{display:flex;align-items:center;gap:8px}.sw input{width:auto}
.mini{padding:5px 10px;font-size:12px;border:1px solid var(--line);background:#fff;width:auto}
.note{font-size:13px;color:var(--mute);background:#f5f8ff;border-left:3px solid var(--gold);padding:10px 12px;margin:10px 0}
.warn{color:#b33;font-size:12px}
@media(max-width:860px){.links{display:none}.grid{grid-template-columns:repeat(2,1fr);gap:12px}.feat{grid-template-columns:repeat(2,1fr)}.feat div{border-bottom:1px solid var(--line)}.pd{grid-template-columns:1fr}.fg{grid-template-columns:1fr 1fr}.ad-body{grid-template-columns:1fr}.side{display:flex;overflow:auto;border-right:0}.side button{white-space:nowrap}.stats{grid-template-columns:repeat(2,1fr)}.main{padding:14px}.tb{display:block;overflow:auto}.row2{grid-template-columns:1fr 1fr}.logo{font-size:25px;letter-spacing:6px}section{padding:56px 0}
.slider{height:700px}.slider::after{inset:8px}.sl-in{grid-template-columns:1fr;padding:0 24px;text-align:center;gap:10px}.sl p.s{margin-left:auto;margin-right:auto;font-size:15px;margin-bottom:18px}.sl-in>div:first-child{order:1}.sl-in>div:last-child{order:2;padding-bottom:50px}.arch{width:190px}.sa{display:none}.ibtn{padding:6px 11px;font-size:13px}.pd .pimg{min-height:300px}.catgrid{grid-template-columns:repeat(2,1fr);gap:12px}.qv{display:none}}
@media(max-width:520px){.row2.keep{grid-template-columns:1fr}.fg{grid-template-columns:1fr}}
@media(max-width:860px){#pov{align-items:flex-end;padding:0}#pov .md{max-height:86vh;border-radius:18px 18px 0 0}.pd .pimg{height:42vh}.pd .in{padding:16px 18px}.pd h2{font-size:24px}.thumbs img{width:48px;height:60px}}

/* ---- luxury admin theme ---- */
#admin,#seller{background:radial-gradient(1200px 600px at 100% 0,#e8f0ff 0,transparent 60%),linear-gradient(180deg,#f3f6fb,#e6edfb)}
.ad-top{background:linear-gradient(90deg,#0b1a38,#102650);border-bottom:2px solid var(--gold);padding:16px 24px;box-shadow:0 4px 18px rgba(0,0,0,.25)}
.ad-top .logo{font-family:'Cormorant Garamond',serif;font-size:24px;letter-spacing:7px;background:linear-gradient(90deg,#93c5fd,#2563eb);-webkit-background-clip:text;background-clip:text;color:transparent}
.ad-top a{color:#c9d6f2;font-size:14px}
.side{background:linear-gradient(180deg,#0b1a38,#0b1a38);border-right:1px solid #1d2f5c;padding:18px 0}
.side button{color:#c9d6f2;font-size:15px;letter-spacing:.4px;transition:.2s;border-left:3px solid transparent}
.side button:hover{background:rgba(96,165,250,.1);color:#fff}
.side button.on{background:linear-gradient(90deg,rgba(96,165,250,.22),transparent);border-left:3px solid var(--gold2);color:#dbeafe;font-weight:600}
.main{padding:28px}
.main h2{font-family:'Cormorant Garamond',serif;font-size:36px;letter-spacing:1px;margin-bottom:6px;position:relative;padding-bottom:12px}
.main h2:after{content:"";position:absolute;left:0;bottom:0;width:70px;height:2px;background:linear-gradient(90deg,var(--gold),transparent)}
.stat{background:linear-gradient(145deg,#fff,#f5f9ff);border:1px solid #dfe7f5;border-left:4px solid var(--gold);border-radius:6px;box-shadow:0 6px 18px rgba(80,60,20,.08)}
.stat b{font-family:'Cormorant Garamond',serif;font-size:34px;color:#0f1b33}
.box{background:#fff;border:1px solid #dfe7f5;border-top:3px solid var(--gold);border-radius:6px;padding:22px;margin-bottom:20px;box-shadow:0 8px 24px rgba(80,60,20,.08)}
.box h3{font-family:'Cormorant Garamond',serif;font-size:26px;color:#0f1b33;margin-bottom:8px}
.box .steps{margin:10px 0 14px 18px;font-size:14px;line-height:1.7;color:#4a4236}
.box .steps b{color:#1d4ed8}
.box .sv{margin-top:16px;display:flex;align-items:center;gap:12px;border-top:1px dashed #d6e0f3;padding-top:14px}
.btn.gold,.sv .btn{background:linear-gradient(135deg,#60a5fa,#2563eb);color:#fff;border:none;letter-spacing:1px;box-shadow:0 4px 12px rgba(37,99,235,.35)}
.tb{border-radius:6px;overflow:hidden;box-shadow:0 6px 18px rgba(80,60,20,.08)}
.tb th{background:#eaf1ff;color:#475a80;text-transform:uppercase;font-size:12px;letter-spacing:1px}
.tb tr:hover td{background:#f5f8ff}
.main input,.main select,.main textarea{border:1px solid #d3def2;background:#ffffff;border-radius:4px}
.main input:focus,.main select:focus,.main textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(37,99,235,.18)}
.main label{color:#475a80;font-size:13px;letter-spacing:.5px}
@media(max-width:760px){.ad-body{grid-template-columns:1fr}.side{display:flex;overflow-x:auto;padding:0}.side button{white-space:nowrap;width:auto;border-left:0;border-bottom:3px solid transparent}.side button.on{border-bottom:3px solid var(--gold2);background:rgba(96,165,250,.15)}}

/* ---- marketplace-style product cards ---- */
.grid{grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}
.pc{border:1px solid var(--line);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}
.pimg{aspect-ratio:4/5}
.pi{padding:10px 12px 14px;display:flex;flex-direction:column;gap:2px;flex:1}
.pi h3{font-size:15px;line-height:1.35;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.7em;margin:2px 0}
.pi small{font-size:10.5px;letter-spacing:1.5px}
.price{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 8px}
.price b{font-size:17px}.price s{margin-left:0;font-size:13px}
.price .off{color:#1e7a3c;font-weight:600;font-size:13px}
.pi .ofl{font-size:12px;color:#1e7a3c;margin-top:2px}
.pi .dl{font-size:11.5px;color:var(--mute);margin-top:auto;padding-top:4px}
@media(max-width:860px){.grid{grid-template-columns:repeat(2,1fr);gap:8px}.pi{padding:8px 9px 12px}.pi h3{font-size:13.5px}.price b{font-size:15px}}

/* ---- v4: slider, order cards, dashboard ---- */
.topbar{position:relative;min-height:34px;overflow:hidden}.topbar span{display:block;animation:tbf .6s}
@keyframes tbf{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
#fslide{padding:46px 0 24px;background:var(--ivory)}
.fs-wrap{position:relative}
.fs-track{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:6px 2px 14px;scrollbar-width:none}
.fs-track::-webkit-scrollbar{display:none}
.fs-track .pc{flex:0 0 220px;scroll-snap-align:start;background:#fff}
.fs-btn{position:absolute;top:38%;width:38px;height:38px;border-radius:50%;border:1px solid var(--gold2);background:rgba(255,255,255,.95);color:var(--ink);font-size:20px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.15);z-index:2}
.fs-btn.l{left:-6px}.fs-btn.r{right:-6px}
@media(max-width:860px){.fs-track .pc{flex-basis:44vw}.fs-btn{display:none}}
.oc{background:#fff;border:1px solid #dfe7f5;border-radius:10px;margin-bottom:18px;box-shadow:0 8px 24px rgba(80,60,20,.09);overflow:hidden}
.oc-h{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;justify-content:space-between;padding:14px 18px;background:linear-gradient(90deg,#0b1a38,#0b1a38);color:#dbeafe}
.oc-h b{font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:1px;color:#dbeafe}
.oc-h small{color:#9fb4e0}
.oc-h .tot{font-size:20px;font-weight:600;color:#fff}
.oc-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:0}
.oc-s{padding:14px 18px;border-top:1px solid #e6ecf7;border-right:1px solid #e6ecf7;font-size:14px;line-height:1.55}
.oc-s h4{font-size:11.5px;letter-spacing:2px;text-transform:uppercase;color:#2563eb;margin-bottom:8px;font-weight:600}
.oc-s .it{display:flex;justify-content:space-between;gap:10px;padding:3px 0;border-bottom:1px dotted #dfe7f5}
.oc-s select,.oc-s input{width:100%;margin-top:6px}
.oc-s .lx{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.oc-s a.cb{display:inline-block;padding:4px 12px;border:1px solid var(--gold);border-radius:20px;font-size:12px;color:#1d4ed8}
.oc-h .badge{color:#0b1a38}.oc-p{height:6px;background:#efe6d2}.oc-p i{display:block;height:100%;background:linear-gradient(90deg,#60a5fa,#2563eb)}
.rl{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;padding:12px 4px;border-bottom:1px solid #e6ecf7}
.rl:last-child{border:0}.rl .id{font-weight:700;min-width:70px}.rl .nm{flex:1 1 140px}.rl .am{font-weight:600}
.stat{display:flex;align-items:center;gap:14px}.stat .ic2{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#60a5fa,#2563eb);display:flex;align-items:center;justify-content:center;font-size:22px;flex:none;box-shadow:0 4px 12px rgba(37,99,235,.4)}
.stat div{line-height:1.25}.stat small{display:block;color:#7a6a48;font-size:12px;letter-spacing:1px;text-transform:uppercase}
.stats{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.box h3{border-bottom:1px solid #e6ecf7;padding-bottom:8px}
.badge{font-weight:600;letter-spacing:.3px;padding:3px 12px}
.b-Delivered{background:#d9f2e1;color:#1e7a3c}.b-Cancelled{background:#fbdcdc;color:#a33}.b-Shipped{background:#e6e0ff}.b-Confirmed{background:#dff0ff}

/* ---- v5: compact admin, clickable stats ---- */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.stat{padding:12px 14px;cursor:pointer;transition:.2s;gap:10px}.stat:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(80,60,20,.16)}
.stat .ic2{width:38px;height:38px;font-size:19px}.stat b{font-size:24px!important}.stat small{font-size:11px}
@media(max-width:760px){.stats{grid-template-columns:1fr 1fr;gap:8px}.stat{padding:10px}.stat .ic2{width:32px;height:32px;font-size:16px}.stat b{font-size:20px!important}
.side button{padding:9px 14px;font-size:13px;letter-spacing:0}.ad-top{padding:10px 14px}.ad-top .logo{font-size:16px;letter-spacing:4px}.main{padding:16px 14px}.main h2{font-size:28px}.box{padding:14px}}
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 14px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}
.chips button{flex:none;border:1px solid #d3def2;background:#fff;border-radius:20px;padding:6px 14px;font-size:13px;cursor:pointer;color:#475a80}
.chips button.on{background:linear-gradient(135deg,#60a5fa,#2563eb);color:#fff;border-color:transparent}
.chips button b{margin-left:4px;opacity:.8}
.pr{display:flex;gap:12px;align-items:center;background:#fff;border:1px solid #dfe7f5;border-radius:8px;padding:10px;margin-bottom:10px;cursor:pointer;transition:.2s}
.pr:hover{box-shadow:0 8px 20px rgba(80,60,20,.12)}
.pr .th{width:64px;height:80px;flex:none;border-radius:4px;background:#eaf1ff;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:28px}
.pr .th img{width:100%;height:100%;object-fit:cover}
.pr .in{flex:1;min-width:0}.pr .in b{display:block;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pr .in small{color:var(--mute)}
.pr .bt{display:flex;flex-direction:column;gap:6px}
@media(max-width:560px){.pr{flex-wrap:wrap}.pr .bt{flex-direction:row;width:100%}}

/* ---- colourful theme ---- */
:root{--ink:#0f1b33;--deep:#0b1a38;--gold:#6200EA;--gold2:#8b5cf6}
.btn{background:linear-gradient(135deg,#2563eb,#7c3aed);border-radius:4px;box-shadow:0 8px 20px rgba(37,99,235,.28)}
.btn:hover{background:linear-gradient(135deg,#1d4ed8,#6d28d9);transform:translateY(-2px)}
.btn.dark{background:var(--deep);box-shadow:none}
.btn.dark:hover{background:var(--gold)}
.pc{transition:.25s}.pc:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(37,99,235,.18)}
.tag{background:linear-gradient(135deg,#e11d48,#f59e0b)!important;color:#fff!important}
.price b{color:#0f1b33}
.price .off{color:#16a34a}

/* ===== colourful storefront theme ===== */
.sortbar{display:flex;gap:8px;margin:0 0 14px;flex-wrap:wrap}.sortbar select,.sortbar input{flex:1;min-width:110px;padding:10px;border:1px solid var(--line);border-radius:10px;font-size:14px;background:#fff}.flashbar{display:flex;align-items:center;justify-content:space-between;gap:10px;background:linear-gradient(90deg,#FF3030,#FF8A00);color:#fff;border-radius:14px;padding:10px 14px;margin-bottom:10px}.flashbar h2{font-family:'Inter',sans-serif;font-weight:800;font-size:19px;margin:0;color:#fff}.flashbar .cd{background:#fff;color:#FF3030;border-radius:20px;padding:5px 12px;font-size:13px;font-weight:700}
.lgb{width:26px;height:26px;vertical-align:-5px;margin-right:6px}.colrow{padding-top:18px}.colh h2{font-family:'Inter',sans-serif;font-weight:800;font-size:22px;margin:0 0 8px}
header{background:linear-gradient(115deg,#6200EA 0%,#1746D1 50%,#FF1685 100%)!important;border-bottom:0!important}
header .logo2{background:none!important;-webkit-text-fill-color:#fff!important;color:#fff!important;font-weight:800;letter-spacing:.14em;padding-left:.14em}
header .logo2 small{color:#fde047!important;-webkit-text-fill-color:#fde047!important;letter-spacing:.04em!important;font-size:10px!important;font-weight:700;text-transform:none}
header .ic{color:#fff}header .hb i{background:#fff!important}
.nav2{height:64px}
.sbar{padding:0 14px 12px}.sbar button{width:100%;height:46px;border:0;border-radius:30px;background:#fff;display:flex;align-items:center;gap:10px;padding:0 16px;font-size:15px;color:#6b7280;box-shadow:0 4px 14px rgba(0,0,0,.18);text-align:left}
.gq{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:14px}
.gqi{position:relative;border-radius:16px;padding:12px 10px 38px;cursor:pointer;min-height:96px;box-shadow:0 3px 10px rgba(0,0,0,.08);overflow:hidden}
.gqi i{display:block;font-size:34px;font-style:normal;line-height:1}.gqi b{display:block;font-size:14px;line-height:1.15;margin-top:8px;color:#111827;font-weight:800}
.gqi span{position:absolute;right:8px;bottom:8px;width:26px;height:26px;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
.gs{border:1px solid;border-radius:20px;padding:14px;margin-bottom:16px;box-shadow:0 4px 14px rgba(0,0,0,.06)}
.gs-h{display:flex;align-items:center;gap:12px;margin-bottom:12px}.gs-h>div{flex:1;min-width:0}.gs-i{font-size:36px}
.gs-h h3{font-family:'Inter',sans-serif;font-weight:800;font-size:22px;line-height:1.1}.gs-h small{color:#4b5563;font-size:13px}
.vall{border:0;color:#fff;border-radius:22px;padding:9px 16px;font-weight:700;font-size:14px;white-space:nowrap;cursor:pointer}
.gs-row{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}.gs-row::-webkit-scrollbar{display:none}
.gt{flex:0 0 96px;background:rgba(255,255,255,.78);border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:8px 6px 8px;text-align:center;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.05)}
.gt-i{height:76px;display:flex;align-items:center;justify-content:center}.gt-i img{max-width:100%;max-height:76px;object-fit:contain;border-radius:8px}.gt-i em{font-size:46px;font-style:normal}
.gt b{display:block;font-size:12.5px;font-weight:700;color:#111827;line-height:1.15;margin-top:4px}.gt small{display:block;font-size:10.5px;color:#6b7280}
.feat{gap:10px;padding:12px 14px!important}.feat>div{border:0!important;border-radius:14px;padding:12px!important}
.feat>div:nth-child(1){background:#dcfce7}.feat>div:nth-child(2){background:#dbeafe}.feat>div:nth-child(3){background:#fef3c7}.feat>div:nth-child(4){background:#ede9fe}
.sec-t h2{font-family:'Inter',sans-serif!important;font-weight:800}
#bnav{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;display:flex;border-top:1px solid #e5e7eb;box-shadow:0 -4px 16px rgba(0,0,0,.08);padding-bottom:env(safe-area-inset-bottom)}
#bnav button{flex:1;border:0;background:none;padding:8px 0 7px;font-size:11.5px;font-weight:600;color:#374151;display:flex;flex-direction:column;align-items:center;gap:3px}
#bnav button.on{color:#6200EA}#bnav svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round}
body{padding-bottom:62px}.fab{bottom:78px!important}
@media(min-width:900px){.gq{max-width:1100px}#bnav{display:none}body{padding-bottom:0}.fab{bottom:24px!important}.gt{flex-basis:130px}.gt-i{height:96px}.gt-i img{max-height:96px}}
@media(max-width:520px){.gqi b{font-size:12.5px}.gqi i{font-size:28px}.gs-h h3{font-size:18px}}

/* ===== ZAVRA marketplace v6 visual upgrade ===== */
:root{--z-purple:#6200EA;--z-blue:#1746D1;--z-pink:#FF1685;--z-green:#16B83E;--z-orange:#FF8A00;--z-yellow:#FFD500}
body{background:#f7f8fc;color:#172033}
.topbar{background:#0b1a38;color:#ffe66d;font-weight:700;letter-spacing:.5px}
header{box-shadow:0 5px 22px rgba(20,20,60,.16)}
.logo2{filter:drop-shadow(0 1px 1px rgba(0,0,0,.12))}
.sbar button{border:1px solid rgba(255,255,255,.55)}
.gq{gap:12px;padding-top:18px;padding-bottom:18px}
.gqi{border:1px solid rgba(255,255,255,.7);transition:transform .2s,box-shadow .2s}
.gqi:hover{transform:translateY(-3px);box-shadow:0 9px 22px rgba(23,70,209,.15)}
.gs{border-radius:18px!important}
.gs-h{align-items:center}
.gt{transition:transform .2s,box-shadow .2s}
.gt:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(23,70,209,.14)}
.gt-i img{width:100%;height:76px;object-fit:cover}
.slider{height:560px;background:#10172a}
.sl{background-position:center 38%;}
.sl-in{position:relative;z-index:2}
.sl h1{font-family:'Inter','Hind Siliguri',sans-serif;font-weight:800;letter-spacing:-1px}
.sl .k{color:#ffe66d;font-weight:800}
.sl p.s{color:#f2f4fa}
.btn{border-radius:9px;font-weight:700;letter-spacing:.5px}
.btn:hover{box-shadow:0 10px 24px rgba(23,70,209,.25)}
section{scroll-margin-top:80px}
.sec-t h2,.colh h2{letter-spacing:-.5px}
.pc{border-radius:12px;box-shadow:0 3px 14px rgba(20,35,80,.07)}
.pc:hover{transform:translateY(-5px);box-shadow:0 14px 30px rgba(23,70,209,.16)}
.pimg{background:#eef2ff!important}
.pimg img{object-fit:cover}
.pi{gap:4px}
.pi .rating-line{font-size:12px;color:#e69a00;font-weight:700;letter-spacing:.2px}
.pi .rating-line small{color:#778096;font-weight:500;letter-spacing:0;text-transform:none}
.price .off{font-weight:800}
.flashbar{box-shadow:0 8px 24px rgba(255,48,48,.16)}
.colrow{padding-top:22px}
.colh h2{font-size:24px}
.feat>div{box-shadow:0 4px 14px rgba(30,40,80,.06)}
footer{background:linear-gradient(135deg,#09152f,#142c60 60%,#3c176e);border-top:4px solid #ff1685;color:#d8e2fa}
footer h4{color:#ffe66d}
footer a:hover{color:#fff}
.newsletter{background:linear-gradient(115deg,#6200EA,#1746D1 58%,#FF1685);color:#fff;padding:30px 24px;border-radius:18px;margin:28px auto;display:grid;grid-template-columns:1fr minmax(240px,420px);gap:20px;align-items:center}
.newsletter h3{font:800 24px Inter,sans-serif;margin-bottom:4px}
.newsletter p{font-size:13px;opacity:.9}
.newsletter form{display:flex;gap:8px}
.newsletter input{border:0;border-radius:30px;padding:12px 16px;min-width:0}
.newsletter button{border:0;border-radius:30px;background:#ffe66d;color:#172033;font-weight:800;padding:0 20px;white-space:nowrap}
.admin-hero{background:linear-gradient(115deg,#6200EA,#1746D1 65%,#FF1685);color:#fff;border-radius:14px;padding:22px;margin-bottom:18px;box-shadow:0 12px 28px rgba(23,70,209,.18)}
.admin-hero h3{font:800 24px Inter,sans-serif;color:#fff}
.admin-hero p{color:#eef2ff;font-size:13px;margin-top:4px}
.admin-tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:14px 0}
.admin-tool{background:#fff;border:1px solid #e0e7f5;border-radius:12px;padding:14px;box-shadow:0 4px 14px rgba(20,35,80,.06)}
.admin-tool b{display:block;color:#1746D1;margin-bottom:4px}
.admin-tool small{color:#68738a;line-height:1.5}
.admin-photo{width:100%;max-height:170px;object-fit:cover;border-radius:10px;margin:8px 0}
.rating-input{max-width:120px}
#bnav{backdrop-filter:blur(12px)}
@media(max-width:700px){.slider{height:640px}.newsletter{grid-template-columns:1fr;padding:22px 16px}.newsletter form{width:100%}.newsletter button{padding:0 14px}.sec-t{margin-bottom:28px}.gq{grid-template-columns:repeat(2,1fr)}}
@media(min-width:861px){.slider{height:570px}.sl-in{padding-left:8%;padding-right:8%}}

</style>
<meta name="description" content="ZAVRA — Shop Smart, Live Better. Men's, Women's, Kids and Home fashion with delivery across India.">
</head>
<body>

<!-- ============ STOREFRONT ============ -->
<div id="store">
<div class="topbar" id="topbar"></div>
<header><div class="wrap nav2">
  <button class="hb" onclick="openSide()" aria-label="Menu"><i></i><i></i><i></i></button>
  <a href="#" class="logo2" id="logoTxt">ZAVRA<small>LUXURY FASHION</small></a>
  <div class="icons2">
    <button class="ic" onclick="openSearch()" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></button>
    <button class="ic" onclick="openWish()" aria-label="Wishlist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.7 4.5 7 4.5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3.3 0 5.4 3.3 4.2 6.7-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg><b class="bdg" id="wc">0</b></button>
    <button class="ic" id="accBtn" onclick="openAccount()" aria-label="Login / Account" title="Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c1-4 4.5-6 8-6s7 2 8 6"/></svg></button>
    <button class="ic" onclick="openCart()" aria-label="Cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6.5a3 3 0 016 0V8"/></svg><b class="bdg" id="cc">0</b></button>
  </div>
</div><div class="wrap sbar"><button onclick="openSearch()"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span>Search for products...</span></button></div></header>
<div class="wrap gq" id="gq"></div>

<div class="slider" id="slider">
  <div id="slides"></div>
  <button class="sa l" onclick="moveSlide(-1)" aria-label="Previous">‹</button>
  <button class="sa r" onclick="moveSlide(1)" aria-label="Next">›</button>
  <div class="dots" id="dots"></div>
</div>
<div class="cstrip" id="cstrip" style="display:none"></div>

<div style="background:#fff;border-bottom:1px solid var(--line)"><div class="wrap feat">
  <div><b>✦</b><span>Premium Quality</span><small>CRAFTED WITH CARE</small></div>
  <div><b>⟡</b><span>Worldwide Shipping</span><small>INDIA · USA · UK · EUROPE · GULF · MALAYSIA</small></div>
  <div><b>◈</b><span>Secure Payments</span><small>UPI · CARDS · COD</small></div>
  <div><b>↺</b><span>7-Day Returns</span><small>EASY RETURNS</small></div>
</div></div>

<section id="cats" style="padding-top:20px"><div class="wrap">
  <div class="sec-t rv"><div class="eyebrow">Explore</div><h2>Shop by Category</h2><div class="orn">◆</div></div>
  <div id="catshow" class="rv"></div>
</div></section>

<section id="fslide" style="display:none"><div class="wrap">
  <div class="sec-t rv"><div class="eyebrow">Handpicked</div><h2 id="fsTitle">Trending Now</h2><div class="orn">◆</div></div>
  <div class="fs-wrap"><button class="fs-btn l" onclick="fsMove(-1)" aria-label="Previous">‹</button><div class="fs-track" id="fsTrack"></div><button class="fs-btn r" onclick="fsMove(1)" aria-label="Next">›</button></div>
</div></section>

<section id="colls"></section>
<section id="shop" style="padding-top:10px;background:var(--ivory2)"><div class="wrap">
  <div class="sec-t rv"><div class="eyebrow">The Edit</div><h2 id="shopTitle">Our Collection</h2><div class="orn">◆</div></div>
  <div class="grpbar" id="grpbar"></div>
  <div class="filters" id="filters"></div>
  <div class="sortbar"><select onchange="srt=this.value;renderGrid()"><option value="">Sort: Featured</option><option value="pl">Price: Low to High</option><option value="ph">Price: High to Low</option><option value="new">Newest</option><option value="disc">Biggest discount</option></select><input type="number" inputmode="numeric" placeholder="Min ₹" oninput="pmin=+this.value||0;renderGrid()"><input type="number" inputmode="numeric" placeholder="Max ₹" oninput="pmax=+this.value||0;renderGrid()"></div>
  <input class="search" id="sq" placeholder="Search kurtis, sarees, bags…" oninput="searchQ=this.value;renderGrid()">
  <div class="grid" id="grid"></div>
</div></section>

<section style="padding:18px 0 8px;background:#f7f8fc"><div class="wrap"><div class="newsletter"><div><h3>Get the ZAVRA Edit</h3><p>New arrivals, special offers and style updates — straight to your inbox.</p></div><form onsubmit="subscribeNewsletter(event)"><input id="newsEmail" type="email" placeholder="Enter your email address" required aria-label="Email address"><button type="submit">Subscribe</button></form></div></div></section>
<footer><div class="wrap">
  <div class="fg">
    <div><div class="logo" style="color:#fff;font-size:28px">ZAVRA</div><p style="margin-top:10px;max-width:340px">Premium fashion for men, women and kids — thoughtfully curated kurtis, sarees, dresses, shirts, footwear, bags and children's essentials.</p><p style="margin-top:10px;color:var(--gold2)" id="fDom"></p></div>
    <div><h4>Shop</h4><a href="#cats" onclick="setGroup('men')">Men</a><a href="#cats" onclick="setGroup('women')">Women</a><a href="#cats" onclick="setGroup('kids')">Kids</a><a href="#cats" onclick="setGroup('home')">Kitchen &amp; Home</a><a href="#shop" onclick="setGroup('all')">All Products</a><a onclick="openAccount()">My Account</a><a href="#seller">Sell on ZAVRA</a><a onclick="openBulk()">Bulk / Wholesale Orders</a></div>
    <div><h4>Policies</h4><a onclick="openPolicy('terms')">Terms &amp; Conditions</a><a onclick="openPolicy('product')">Product Policy</a><a onclick="openPolicy('delivery')">Shipping &amp; Delivery</a><a onclick="openPolicy('returns')">Returns &amp; Refunds</a><a onclick="openPolicy('payment')">Payment Policy</a><a onclick="openPolicy('intl')">International Shopping</a><a onclick="openPolicy('privacy')">Privacy Policy</a><a onclick="openPolicy('about')">About Us</a><a onclick="openPolicy('faq')">FAQs</a></div>
    <div><h4>Contact Us</h4><div id="fPhones"></div><a id="fWa" target="_blank"></a><a id="fMail"></a><div id="fSocial"></div></div>
  </div>
  <div class="pays"><div id="fPays"></div><div id="fPaysTxt">UPI · PHONEPE · GOOGLE PAY · PAYTM · VISA · MASTERCARD · AMEX · PAYPAL · STRIPE · NET BANKING · COD</div></div>
  <div class="copy">© 2026 ZAVRA. All rights reserved. · <a href="#seller" style="display:inline;opacity:.6">Seller Login</a> · <a href="#admin" style="display:inline;opacity:.5">Admin</a></div>
</div></footer>
</div>

<nav id="bnav"><button onclick="closeAll();window.scrollTo({top:0,behavior:'smooth'})" class="on"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z"/></svg>Home</button><button onclick="closeAll();document.getElementById('cats').scrollIntoView({behavior:'smooth'})"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Categories</button><button onclick="openWish()"><svg viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.7 4.5 7 4.5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3.3 0 5.4 3.3 4.2 6.7-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg>Wishlist</button><button onclick="openAccount()"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/></svg>Account</button><button onclick="openSide()"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>More</button></nav>
<div class="ov" id="sov" onclick="if(event.target===this)closeAll()"><div class="sidebar" id="sidebar"></div></div>
<a class="fab" id="waFab" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 32 32"><path d="M16.04 3C9.4 3 4 8.36 4 14.97c0 2.1.55 4.15 1.6 5.96L4 29l8.3-1.56a12.1 12.1 0 003.74.6C22.68 28.04 28 22.68 28 16.07 28 9.4 22.68 3 16.04 3zm0 22.04c-1.2 0-2.36-.3-3.4-.86l-.5-.27-4.9.92.97-4.7-.3-.5a9.9 9.9 0 01-1.5-5.23c0-5.5 4.5-9.97 10.04-9.97 5.48 0 9.96 4.47 9.96 9.97 0 5.5-4.48 9.94-10 9.94zm5.5-7.4c-.3-.15-1.78-.88-2.06-.98-.27-.1-.47-.15-.67.15-.2.3-.77.98-.95 1.18-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.4-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3 0-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.92-2.22-.24-.58-.5-.5-.67-.5h-.58c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.5 2.98 1.28 2.98.85 3.52.8.54-.05 1.76-.72 2-1.42.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.35z"/></svg></a>
<div class="ov" id="pov" onclick="if(event.target===this)closeAll()"><div class="md" id="pmd"></div></div>
<div class="drawer" id="drawer"><div class="dh"><h3>Your Cart</h3><button class="x" style="position:static" onclick="closeAll()">×</button></div><div class="db" id="cartBody"></div><div class="df" id="cartFoot"></div></div>
<div class="ov" id="cov" onclick="if(event.target===this)closeAll()"><div class="md n"><button class="x" onclick="closeAll()">×</button><div class="fm" id="checkout"></div></div></div>
<div class="ov" id="lov" onclick="if(event.target===this)closeAll()"><div class="md n"><button class="x" onclick="closeAll()">×</button><div class="fm" id="loginBody"></div></div></div>
<div class="ov" id="tov" onclick="if(event.target===this)closeAll()"><div class="md n"><button class="x" onclick="closeAll()">×</button><div class="fm" id="tbody"></div></div></div>
<div class="ov" id="polov" onclick="if(event.target===this)closePolicy()"><div class="md" style="max-width:760px"><button class="x" onclick="closePolicy()">×</button><div class="pol" id="polbody"></div></div></div>
<div id="rc"></div>
<div class="toast" id="toast"></div>

<!-- ============ ADMIN ============ -->
<div id="admin">
  <div class="ad-top"><span class="logo">ZAVRA ADMIN</span><span><a href="#" onclick="location.hash='';return false" style="margin-right:16px">← View Store</a><button class="mini" onclick="logout()">Logout</button></span></div>
  <div id="loginBox" style="max-width:380px;margin:90px auto;background:#fff;padding:34px">
    <h2 style="font-size:30px">Admin Login</h2>
    <div id="aemWrap"><label>Email</label><input id="aem" type="email" autocomplete="username"></div>
    <label>Password</label><input type="password" id="apw" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()">
    <button class="btn dark" style="width:100%;margin-top:16px" onclick="login()">Sign In</button>
    <p class="note" id="lnote"></p>
  </div>
  <div class="ad-body" id="adBody" style="display:none">
    <div class="side" id="side"></div>
    <div class="main" id="amain"></div>
  </div>
</div>

<!-- ============ SELLER PANEL ============ -->
<div id="seller">
  <div class="ad-top"><span class="logo">ZAVRA SELLER</span><span><a href="#" onclick="location.hash='';return false" style="margin-right:16px">← View Store</a><button class="mini" id="sOut" onclick="userLogout()" style="display:none">Logout</button></span></div>
  <div id="sLogin" style="max-width:420px;margin:70px auto;background:#fff;padding:34px">
    <h2 style="font-size:30px">Seller Portal</h2>
    <p style="color:var(--mute);font-size:14px;margin:8px 0 16px">Sell your products on ZAVRA. Create a seller account or sign in to manage your listings.</p>
    <button class="btn dark" style="width:100%" onclick="openSellerAuth('signin')">Seller Sign In</button>
    <button class="btn" style="width:100%;margin-top:10px" onclick="openSellerAuth('signup')">Register as a Seller</button>
  </div>
  <div class="ad-body" id="sBody" style="display:none">
    <div class="side" id="sSide"></div>
    <div class="main" id="sMain"></div>
  </div>
</div>

<script>
/* =====================================================================
   FIREBASE CONFIG (ZAVRA project)
   ===================================================================== */
const FIREBASE_CONFIG={
  apiKey:"AIzaSyDAJ_vKVVriilP29N__xKGQkrKxZqM7_AU",
  authDomain:"zavra-7ee42.firebaseapp.com",
  projectId:"zavra-7ee42",
  storageBucket:"zavra-7ee42.firebasestorage.app",
  messagingSenderId:"922510514582",
  appId:"1:922510514582:web:2c9455278ce383b218a5b7"
};
const ADMIN_EMAIL='mrsanfuivlogs@gmail.com';   /* admin login only — not shown to customers */
const FB_ON=!String(FIREBASE_CONFIG.apiKey).startsWith('PASTE');

const $=s=>document.querySelector(s);
const clone=o=>JSON.parse(JSON.stringify(o));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const bn=n=>Number(n).toLocaleString('en-IN');
const tk=n=>'₹'+bn(Math.round(n));
const GROUPS={men:{en:"Men's Fashion",tag:'Style Up Your Life'},women:{en:"Women's Fashion",tag:'Be Stylish, Be You'},kids:{en:'Kids, Toys & Games',tag:'Play, Learn & Grow'},home:{en:'Kitchen & Home',tag:'Make Your Home Better'}};
const GORD=['men','women','kids','home'];

const REQUIRED_CATS=[
 ['mtees','T-Shirts','men','👕'],['mshirts','Shirts','men','👔'],['mjeans','Jeans','men','👖'],['mtrousers','Trousers','men','👖'],['mfoot','Shoes','men','👟'],['mwatch','Watches','men','⌚'],['mwallet','Wallets','men','👛'],['mjacket','Jackets','men','🧥'],['minner','Innerwear','men','🩲'],['macc','Accessories','men','🧢'],
 ['saree','Sarees','women','🥻'],['kurti','Kurtis','women','👘'],['lehenga','Lehengas','women','💃'],['wsalwar','Salwar Suits','women','🥻'],['wgown','Gowns','women','👗'],['wwest','Western Dresses','women','👗'],['wtops','Tops','women','👚'],['wjeans','Jeans','women','👖'],['wleg','Leggings','women','🩱'],['wblouse','Blouses','women','👚'],['wdup','Dupattas','women','🧣'],['wnight','Nightwear','women','🌙'],['bags','Handbags','women','👜'],['wjewel','Jewellery','women','💎'],['wmakeup','Makeup & Beauty','women','💄'],['wfoot','Footwear','women','👠'],['winner','Innerwear','women','🩱'],['wacc','Accessories','women','🎀'],
 ['kboys','Boys Fashion','kids','👦'],['kgirls','Girls Fashion','kids','👧'],['kbaby','Baby Wear','kids','👶'],['toys','Toys','kids','🧸'],['kedu','Educational Toys','kids','🧩'],['kcars','Cars & Vehicles','kids','🚗'],['koutdoor','Outdoor Games','kids','⚽'],['kgames','Board Games','kids','🎲'],['kbabyacc','Baby Accessories','kids','🍼'],
 ['cookware','Cookware','home','🍳'],['ktools','Kitchen Tools','home','🥄'],['hutensil','Kitchen Utensils','home','🍴'],['storage','Kitchen Storage','home','🫙'],['decor','Home Decor','home','🪴'],['bedsheets','Bedsheets','home','🛏️'],['hfurn','Furniture','home','🛋️'],['hclean','Cleaning Products','home','🧽'],['appliances','Home Appliances','home','🔌']
].map((x,i)=>({id:x[0],en:x[1],group:x[2],emoji:x[3],img:'',ord:1000+i}));
function ensureCatalogDefaults(){
  if(!DB||!Array.isArray(DB.categories))return;
  for(const d of REQUIRED_CATS){
    const same=DB.categories.find(c=>c.id===d.id||((c.group===d.group)&&String(c.en||'').toLowerCase()===d.en.toLowerCase()));
    if(!same)DB.categories.push(clone(d));
  }
}
const PHOTO={
 men:'photo-1523381210434-271e8be1f52b',women:'photo-1483985988355-763728e1935b',kids:'photo-1519238263530-99bdd11df2ea',home:'photo-1600210492486-724fe5c67fb0',
