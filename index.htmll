function photoUrl(key,w=520){const id=PHOTO[key]||PHOTO.women;return `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=82`}
function catPhoto(c){if(c&&c.img)return c.img;const id=c&&c.id;const group=c&&c.group||'women';return photoUrl(PHOTO[id]?id:group,420)}
function productPhoto(p){if(p&&p.img)return p.img;const c=catOf(p&&p.cat);return photoUrl(PHOTO[p&&p.cat]?p.cat:(c&&c.group||'women'),700)}

